<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Algoritmo redGDPS 2026 · DM2</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F7F4EE;
    --paper: #FFFFFF;
    --paper-tint: #FAF7F1;
    --ink: #1A1F2A;
    --ink-soft: #4A5365;
    --ink-mute: #7C8497;
    --rule: #E4DFD5;
    --rule-strong: #C9C3B6;
    --accent: #A52A3A;
    --accent-deep: #7A1D2A;
    --evidence: #2E6B58;
    --evidence-soft: #E4EFE9;
    --warn: #B26A1F;
    --warn-soft: #F7EAD4;
    --danger: #9F2230;
    --danger-soft: #F5DDDF;
    --info: #2C547A;
    --info-soft: #E1ECF4;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-image:
      radial-gradient(circle at 15% 10%, rgba(165,42,58,0.04) 0%, transparent 40%),
      radial-gradient(circle at 85% 90%, rgba(46,107,88,0.04) 0%, transparent 40%);
    background-attachment: fixed;
    min-height: 100vh;
  }

  header.masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper-tint);
  }
  .masthead-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 22px 32px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: baseline; gap: 14px; }
  .brand-mark {
    font-family: "Fraunces", serif; font-weight: 600; font-style: italic;
    font-size: 26px; letter-spacing: -0.02em; color: var(--accent);
  }
  .brand-mark::before {
    content: ""; display: inline-block; width: 10px; height: 10px;
    background: var(--accent); border-radius: 50%; margin-right: 10px;
    transform: translateY(-2px);
  }
  .brand-sub { font-size: 12px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 500; }
  .masthead h1 { margin: 0; font-family: "Fraunces", serif; font-weight: 400; font-size: 22px; letter-spacing: -0.015em; color: var(--ink); }
  .masthead h1 em { font-style: italic; color: var(--accent); }

  main {
    max-width: 1400px; margin: 0 auto; padding: 32px;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 28px;
  }
  @media (max-width: 980px) { main { grid-template-columns: 1fr; } }

  .panel { background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; }
  .panel-header {
    padding: 18px 24px 14px; border-bottom: 1px solid var(--rule);
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
  }
  .panel-header h2 { margin: 0; font-family: "Fraunces", serif; font-weight: 500; font-size: 19px; letter-spacing: -0.01em; }
  .panel-header .meta { font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-mute); }

  .section { border-bottom: 1px solid var(--rule); padding: 20px 24px; }
  .section:last-child { border-bottom: 0; }
  .section-title {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--ink-mute); font-weight: 600; margin: 0 0 14px; display: flex; align-items: center; gap: 8px;
  }
  .section-title::before { content: ""; width: 18px; height: 1px; background: var(--ink-mute); }

  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 6px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 12px; font-weight: 500; color: var(--ink-soft); letter-spacing: 0.01em; }
  .field-hint { font-size: 11px; color: var(--ink-mute); font-style: italic; }

  input[type="number"], input[type="text"], select {
    width: 100%; background: var(--paper-tint); border: 1px solid var(--rule);
    border-radius: 3px; padding: 8px 10px; font-family: inherit; font-size: 14px;
    color: var(--ink); transition: border-color 0.15s, background 0.15s;
  }
  input[type="number"]:focus, input[type="text"]:focus, select:focus {
    outline: none; border-color: var(--accent); background: var(--paper);
  }

  .check-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
  .check {
    position: relative; display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border: 1px solid var(--rule); border-radius: 3px;
    cursor: pointer; background: var(--paper); transition: all 0.15s; user-select: none;
  }
  .check:hover { border-color: var(--rule-strong); background: var(--paper-tint); }
  .check input { margin: 2px 0 0; accent-color: var(--accent); cursor: pointer; flex-shrink: 0; }
  .check.checked { background: var(--paper-tint); border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .check-body { display: flex; flex-direction: column; gap: 2px; line-height: 1.35; }
  .check-label { font-weight: 500; font-size: 13.5px; color: var(--ink); }
  .check-desc { font-size: 11.5px; color: var(--ink-mute); }

  .check.evidence { border-left: 3px solid var(--evidence); }
  .check.evidence.checked { box-shadow: inset 3px 0 0 var(--evidence); border-left-color: transparent; }
  .ev-badge {
    display: inline-block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--evidence-soft); color: var(--evidence); padding: 1px 5px;
    border-radius: 2px; font-weight: 600; margin-left: 6px; vertical-align: 1px;
  }

  .sub-field {
    margin-top: 10px; padding: 10px 12px; background: var(--paper-tint);
    border-left: 2px solid var(--rule-strong); font-size: 13px; display: none;
  }
  .sub-field.active { display: block; }
  .sub-field label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-mute); font-weight: 600; display: block; margin-bottom: 4px;
  }

  .radio-group { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .radio-pill {
    border: 1px solid var(--rule); background: var(--paper); padding: 5px 10px;
    border-radius: 999px; font-size: 12px; cursor: pointer; transition: all 0.15s; color: var(--ink-soft);
  }
  .radio-pill input { display: none; }
  .radio-pill.selected { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .hba1c-control { display: flex; align-items: center; gap: 14px; margin-top: 4px; }
  .hba1c-value {
    font-family: "Fraunces", serif; font-size: 32px; font-weight: 500;
    color: var(--accent); letter-spacing: -0.02em; min-width: 80px;
  }
  .hba1c-value .unit { font-size: 14px; color: var(--ink-mute); font-weight: 400; margin-left: 2px; }
  input[type="range"] { flex: 1; accent-color: var(--accent); }

  .output-panel { position: sticky; top: 24px; align-self: start; }
  .summary {
    padding: 26px 28px 22px; background: linear-gradient(180deg, var(--paper-tint) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--rule);
  }
  .target-block { display: flex; align-items: baseline; gap: 16px; margin-bottom: 4px; }
  .target-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 600; }
  .target-value {
    font-family: "Fraunces", serif; font-size: 44px; font-weight: 500;
    letter-spacing: -0.02em; color: var(--ink); line-height: 1;
  }
  .target-value.muted { font-size: 22px; color: var(--ink-soft); font-style: italic; }
  .target-status {
    margin-top: 12px; display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em;
  }
  .target-status.ok { background: var(--evidence-soft); color: var(--evidence); }
  .target-status.no { background: var(--danger-soft); color: var(--danger); }
  .target-status.warn { background: var(--warn-soft); color: var(--warn); }
  .target-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .conditioner { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .conditioner .target-label { margin-bottom: 8px; display: block; }
  .conditioner-name { font-family: "Fraunces", serif; font-size: 22px; font-weight: 500; color: var(--accent); font-style: italic; }
  .conditioner-meta { font-size: 12px; color: var(--ink-mute); margin-top: 4px; }

  .rec-section { padding: 22px 28px; border-bottom: 1px solid var(--rule); }
  .rec-section:last-child { border-bottom: 0; }
  .rec-title {
    font-family: "Fraunces", serif; font-size: 15px; font-weight: 500; margin: 0 0 10px;
    display: flex; align-items: center; gap: 10px;
  }
  .rec-title::before {
    content: ""; display: inline-block; width: 4px; height: 14px;
    background: var(--accent); border-radius: 1px;
  }

  .rec-card {
    background: var(--paper-tint); border: 1px solid var(--rule); border-radius: 3px;
    padding: 14px 16px; margin-bottom: 10px; position: relative;
  }
  .rec-card:last-child { margin-bottom: 0; }

  .rec-card.add { border-left: 3px solid var(--evidence); background: var(--evidence-soft); }
  .rec-card.add .rec-card-tag { color: var(--evidence); }
  .rec-card.warn { border-left: 3px solid var(--warn); background: var(--warn-soft); }
  .rec-card.warn .rec-card-tag { color: var(--warn); }
  .rec-card.danger { border-left: 3px solid var(--danger); background: var(--danger-soft); }
  .rec-card.danger .rec-card-tag { color: var(--danger); }
  .rec-card.info { border-left: 3px solid var(--info); background: var(--info-soft); }
  .rec-card.info .rec-card-tag { color: var(--info); }
  .rec-card.ok { border-left: 3px solid var(--evidence); background: #E4EFE9; }
  .rec-card.ok .rec-card-tag { color: var(--evidence); }

  .rec-card-tag { font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; margin-bottom: 6px; }
  .rec-card-title { font-weight: 600; font-size: 14.5px; color: var(--ink); margin-bottom: 4px; }
  .rec-card-body { font-size: 13px; color: var(--ink-soft); line-height: 1.5; }
  .rec-card-body strong { color: var(--ink); }
  .rec-card-body ul { margin: 8px 0 0 0; padding-left: 20px; }
  .rec-card-body li { margin-bottom: 6px; }

  .drug-line { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .drug-pill {
    display: inline-flex; align-items: center; padding: 3px 10px; background: var(--paper);
    border: 1px solid var(--rule-strong); border-radius: 999px; font-size: 12px; font-weight: 500;
    color: var(--ink); font-family: "JetBrains Mono", monospace; letter-spacing: -0.01em;
  }
  .drug-pill.current { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .trace { font-size: 12px; line-height: 1.6; color: var(--ink-soft); }
  .trace ol { padding-left: 0; list-style: none; counter-reset: step; margin: 0; }
  .trace li {
    counter-increment: step; padding: 4px 0 4px 30px; position: relative; border-bottom: 1px dashed var(--rule);
  }
  .trace li:last-child { border-bottom: 0; }
  .trace li::before {
    content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 4px;
    font-family: "JetBrains Mono", monospace; font-size: 10px; color: var(--accent); font-weight: 600;
  }

  .empty-state { padding: 40px 28px; text-align: center; color: var(--ink-mute); font-style: italic; font-family: "Fraunces", serif; font-size: 15px; }

  footer {
    max-width: 1400px; margin: 0 auto; padding: 24px 32px 48px; font-size: 11px;
    color: var(--ink-mute); line-height: 1.6; border-top: 1px solid var(--rule); margin-top: 20px;
  }
  footer .ref { font-family: "JetBrains Mono", monospace; color: var(--accent); }

  .reset-btn {
    background: transparent; border: 1px solid var(--rule-strong); border-radius: 3px;
    padding: 6px 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-soft); cursor: pointer; font-family: inherit; font-weight: 500; transition: all 0.15s;
  }
  .reset-btn:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .drug-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .drug-class {
    border: 1px solid var(--rule); border-radius: 3px; padding: 10px 12px;
    background: var(--paper); transition: all 0.15s;
  }
  .drug-class.has-active { border-color: var(--accent); background: var(--paper-tint); }
  .drug-class-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-mute); font-weight: 600; margin-bottom: 8px; }
  .drug-class.has-active .drug-class-title { color: var(--accent); }

  .drug-options { display: flex; flex-direction: column; gap: 4px; }
  .drug-option { display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer; padding: 3px 0; color: var(--ink-soft); }
  .drug-option input { accent-color: var(--accent); }
  .drug-option input:checked + span { color: var(--ink); font-weight: 600; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-inner">
    <div class="brand">
      <div class="brand-mark">redGDPS</div>
      <div class="brand-sub">Algoritmo 2026 · DM2</div>
    </div>
    <h1>De la <em>glucemia</em> al paciente · soporte de decisión</h1>
    <button class="reset-btn" onclick="resetAll()">Reiniciar</button>
  </div>
</header>

<main>
  <section class="panel" id="inputPanel">
    <div class="panel-header">
      <h2>Datos del paciente</h2>
      <span class="meta">Entradas clínicas</span>
    </div>

    <div class="section">
      <h3 class="section-title">Datos clínicos básicos</h3>
      <div class="field" style="margin-bottom:14px;">
        <label>HbA1c actual</label>
        <div class="hba1c-control">
          <div class="hba1c-value"><span id="hbValue">7.5</span><span class="unit">%</span></div>
          <input type="range" id="hba1c" min="5" max="14" step="0.1" value="7.5">
        </div>
        <div class="field-hint" id="hbHint">Glucemia media estimada ≈ <span id="gme">169</span> mg/dL</div>
      </div>

      <div class="row">
        <div class="field">
          <label>Edad (años)</label>
          <input type="number" id="edad" min="18" max="110" value="65">
        </div>
        <div class="field">
          <label>Tiempo desde dx (años)</label>
          <input type="number" id="tiempoDx" min="0" max="60" value="5" step="0.5">
        </div>
        <div class="field">
          <label>FG estimado (mL/min)</label>
          <input type="number" id="fge" min="5" max="150" value="80">
        </div>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Clínica cardinal</h3>
      <div class="check-grid">
        <label class="check" data-check="sintomatico">
          <input type="checkbox" id="sintomatico">
          <span class="check-body">
            <span class="check-label">Síntomas cardinales</span>
            <span class="check-desc">Poliuria, polidipsia, pérdida de peso no explicable</span>
          </span>
        </label>
        <label class="check" data-check="dxReciente">
          <input type="checkbox" id="dxReciente">
          <span class="check-body">
            <span class="check-label">Diagnóstico reciente</span>
            <span class="check-desc">Primer año tras el diagnóstico</span>
          </span>
        </label>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Condicionantes clínicos (prioridad ←→)</h3>
      <div class="check-grid">
        <label class="check evidence" data-check="ecv">
          <input type="checkbox" id="ecv">
          <span class="check-body">
            <span class="check-label">ECV establecida <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">C. isquémica, ictus/AIT, EAP, ateromatosis significativa</span>
          </span>
        </label>
        <label class="check evidence" data-check="rcvAlto">
          <input type="checkbox" id="rcvAlto">
          <span class="check-body">
            <span class="check-label">RCV alto <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">≥3 FRCV (HTA, dislipemia, tabaco, ERC, albuminuria, obesidad, AF precoz)</span>
          </span>
        </label>
        <label class="check evidence" data-check="ic">
          <input type="checkbox" id="ic">
          <span class="check-body">
            <span class="check-label">Insuficiencia cardíaca <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">Cualquier FE; con o sin descompensación</span>
          </span>
        </label>
        <label class="check evidence" data-check="erc">
          <input type="checkbox" id="erc">
          <span class="check-body">
            <span class="check-label">ERC <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">FG &lt; 60 o albuminuria persistente</span>
          </span>
        </label>
        <label class="check" data-check="obesidad">
          <input type="checkbox" id="obesidad">
          <span class="check-body">
            <span class="check-label">Obesidad (IMC ≥ 30 kg/m²)</span>
            <span class="check-desc">Empeora el control y eleva riesgo cardiometabólico</span>
          </span>
        </label>
        <label class="check" data-check="hepatica">
          <input type="checkbox" id="hepatica">
          <span class="check-body">
            <span class="check-label">Enfermedad hepática metabólica</span>
            <span class="check-desc">MASLD / MASH (antes EHGNA / EHNA)</span>
          </span>
        </label>
        <label class="check" data-check="fragilidad">
          <input type="checkbox" id="fragilidad">
          <span class="check-body">
            <span class="check-label">Fragilidad</span>
            <span class="check-desc">Comorbilidades, polifarmacia, esperanza vida reducida</span>
          </span>
        </label>
      </div>

      <div class="sub-field" id="fragilidadGrade">
        <label>Grado de fragilidad (Solo según algoritmo 2026)</label>
        <div class="radio-group" id="fragilidadOpts">
          <label class="radio-pill"><input type="radio" name="fragGrade" value="moderadaGrave" checked> Moderada - Grave</label>
          <label class="radio-pill"><input type="radio" name="fragGrade" value="muyGrave"> Muy grave / vida limitada</label>
        </div>
      </div>

      <div class="check-grid" style="margin-top: 10px;">
        <label class="check" data-check="deterioro">
          <input type="checkbox" id="deterioro">
          <span class="check-body">
            <span class="check-label">Deterioro cognitivo / limitación funcional</span>
            <span class="check-desc">Marca automáticamente fragilidad moderada-grave (Objetivo 7,5-8,5%)</span>
          </span>
        </label>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Tratamiento actual (qué toma ya)</h3>
      <div class="drug-grid">
        <div class="drug-class" data-drugclass="met">
          <div class="drug-class-title">Biguanida</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="metformina"><span>Metformina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="isglt2">
          <div class="drug-class-title">iSGLT-2</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="empagliflozina"><span>Empagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="dapagliflozina"><span>Dapagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="canagliflozina"><span>Canagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="ertugliflozina"><span>Ertugliflozina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="arglp">
          <div class="drug-class-title">arGLP-1</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="semaglutida"><span>Semaglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="dulaglutida"><span>Dulaglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="liraglutida"><span>Liraglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="exenatida"><span>Exenatida / lixisenatida</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="argip">
          <div class="drug-class-title">arGIP/GLP-1</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="tirzepatida"><span>Tirzepatida</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="idpp4">
          <div class="drug-class-title">iDPP-4</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="sitagliptina"><span>Sitagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="linagliptina"><span>Linagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="vildagliptina"><span>Vildagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="saxagliptina"><span>Saxagliptina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="su">
          <div class="drug-class-title">Sulfonilureas / Glinidas</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="glimepirida"><span>Glimepirida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="gliclazida"><span>Gliclazida</span></label>
