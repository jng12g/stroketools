<script>
/* =================================================================
   Algoritmo redGDPS 2026 - Lógica clínica estructurada y razonada
   ================================================================= */

const state = {
  hba1c: 7.5, edad: 65, tiempoDx: 5, fge: 80,
  sintomatico: false, dxReciente: false, ic: false, ecv: false, rcvAlto: false,
  erc: false, obesidad: false, hepatica: false, fragilidad: false, fragGrade: 'moderadaGrave', deterioro: false,
  drugs: {}
};

const DRUG_LABELS = {
  metformina: 'Metformina', empagliflozina: 'Empagliflozina', dapagliflozina: 'Dapagliflozina', canagliflozina: 'Canagliflozina', ertugliflozina: 'Ertugliflozina',
  semaglutida: 'Semaglutida', dulaglutida: 'Dulaglutida', liraglutida: 'Liraglutida', exenatida: 'Exenatida', tirzepatida: 'Tirzepatida',
  sitagliptina: 'Sitagliptina', linagliptina: 'Linagliptina', vildagliptina: 'Vildagliptina', saxagliptina: 'Saxagliptina',
  glimepirida: 'Glimepirida', gliclazida: 'Gliclazida', repaglinida: 'Repaglinida', pioglitazona: 'Pioglitazona',
  insulinaBasal: 'Insulina basal', insulinaPrandial: 'Insulina prandial'
};

const DRUG_CLASS = {
  metformina: 'met',
  empagliflozina: 'isglt2', dapagliflozina: 'isglt2', canagliflozina: 'isglt2', ertugliflozina: 'isglt2',
  semaglutida: 'arglp', dulaglutida: 'arglp', liraglutida: 'arglp', exenatida: 'arglp',
  tirzepatida: 'argip',
  sitagliptina: 'idpp4', linagliptina: 'idpp4', vildagliptina: 'idpp4', saxagliptina: 'idpp4',
  glimepirida: 'su', gliclazida: 'su', repaglinida: 'su', pioglitazona: 'pio',
  insulinaBasal: 'ins', insulinaPrandial: 'ins'
};

function hasClass(cls) { return Object.entries(state.drugs).some(([k,v]) => v && DRUG_CLASS[k] === cls); }

function drugsInClass(cls) {
  return Object.entries(state.drugs).filter(([k,v]) => v && DRUG_CLASS[k] === cls).map(([k]) => k);
}

/* ============================================================
   CAMBIO PUNTO 2: Reordenado el cascade de condicionantes para
   respetar la prioridad visual "de izquierda a derecha" del
   algoritmo redGDPS 2026:
     1. ECV / RCV elevado
     2. Insuficiencia cardíaca
     3. ERC
     4. Obesidad
     5. Hepática metabólica
     6. Fragilidad
   ============================================================ */
function getConditioner() {
  if (state.ecv || state.rcvAlto) { const label = state.ecv ? 'ECV establecida' : 'RCV elevado'; return { id: 'ecv', name: label, meta: 'Metformina + (iSGLT-2 o arGLP-1 o arGIP-GLP-1)' }; }
  if (state.ic) return { id: 'ic', name: 'Insuficiencia cardíaca', meta: 'iSGLT-2 (con o sin Met) → arGLP-1 o arGIP-GLP-1' };
  if (state.erc) return { id: 'erc', name: 'Enfermedad renal crónica', meta: 'iSGLT-2 (si FGe ≥20) → arGLP-1 (preferible semaglutida)' };
  if (state.obesidad) return { id: 'obesidad', name: 'Obesidad', meta: 'arGIP-GLP-1 o arGLP-1 + Met → iSGLT-2' };
  if (state.hepatica) return { id: 'hepatica', name: 'Enfermedad hepática metabólica', meta: 'arGIP-GLP-1 o arGLP-1 → iSGLT-2 o Pioglitazona' };
  if (state.fragilidad) {
    const nameFrag = state.fragGrade === 'muyGrave' ? 'Muy grave / Vida limitada' : 'Moderada - Grave';
    return { id: 'fragilidad', name: 'Fragilidad: ' + nameFrag, meta: 'iDPP-4 → +Met → insulina + Met (evitar Sulfonilureas)' };
  }
  return { id: null, name: 'Ninguno', meta: 'Algoritmo guiado por HbA1c y clínica cardinal' };
}

/* ============================================================
   CAMBIO PUNTO 1: Refactorizado el objetivo HbA1c para que la
   edad ≤ 75 años sea condición NECESARIA del objetivo < 6,5 %.
   Un paciente > 75 años, aunque sea de diagnóstico reciente,
   cae siempre en ≤ 7 % (la edad prevalece).
   ============================================================ */
function getTarget() {
  const sinComplicaciones = !state.ic && !state.ecv && !state.erc && !state.hepatica && !state.rcvAlto;
  if (state.fragilidad && state.fragGrade === 'muyGrave') {
    return { target: null, label: 'Evitar síntomas', rationale: 'Fragilidad muy grave o esperanza de vida limitada. No hay objetivo numérico; se prioriza evitar síntomas hiper/hipoglucémicos.', upperBound: 9.0 };
  }
  if (state.deterioro || (state.fragilidad && state.fragGrade === 'moderadaGrave')) {
    return { target: 8.5, label: '7,5 - 8,5 %', rationale: 'Fragilidad moderada-grave (deterioro cognitivo/funcional). Especial precaución ante hipoglucemias.', upperBound: 8.5 };
  }
  if (!state.fragilidad && sinComplicaciones && state.edad <= 75 && (state.dxReciente || state.tiempoDx <= 10)) {
    return { target: 6.5, label: '< 6,5 %', rationale: 'Paciente ≤ 75 años con diagnóstico reciente o < 10 años de evolución, sin complicaciones ni fragilidad: objetivo estricto (memoria metabólica), siempre que se logre sin hipoglucemias.', upperBound: 6.5 };
  }
  if (!state.fragilidad && sinComplicaciones && (state.tiempoDx > 10 || state.edad > 75)) {
    return { target: 7.0, label: '≤ 7,0 %', rationale: 'Paciente de larga evolución (> 10 años) o > 75 años sin complicaciones. La edad > 75 prevalece sobre el tiempo de evolución.', upperBound: 7.0 };
  }
  return { target: 7.0, label: '< 7,0 %', rationale: 'Objetivo individualizado general por presencia de comorbilidad establecida.', upperBound: 7.0 };
}

function getAvailableADNIs(state) {
  let options = [];
  const hasGLP = hasClass('arglp') || hasClass('argip');
  const hasDPP4 = hasClass('idpp4');
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;

  if (!hasClass('met') && state.fge >= 30) options.push('<strong>Metformina</strong> (base del tratamiento, económica y probada).');
  if (!hasClass('isglt2') && state.fge >= 20) options.push('<strong>iSGLT-2</strong> (ej. Empagliflozina, Dapagliflozina o Canagliflozina).');
  
  if (!hasGLP) options.push('<strong>arGLP-1</strong> (ej. Semaglutida, Dulaglutida) o <strong>arGIP/GLP-1</strong> (Tirzepatida).');
  if (!hasDPP4 && !hasGLP) options.push('<strong>iDPP-4</strong>: Fármacos neutros en peso y extremadamente seguros (primera línea en fragilidad).');
  if (!hasClass('pio') && !state.ic) options.push('<strong>Pioglitazona</strong>: Mejora la resistencia a la insulina.');
  
  if (!hasClass('su') && !state.fragilidad) {
    if (clasesUsadas >= 2) {
      options.push('<strong>Sulfonilureas</strong>: Útiles solo como 3er o 4º ADNI. <em>Gliclazida o Glimepirida son las de elección.</em>');
    }
  }
  if (!hasClass('su') && state.fge < 15 && !state.fragilidad) {
      options.push('<strong>Repaglinida</strong>: Útil como excepción por el bajo filtrado glomerular (FG < 15 ml/min).');
  }

  return options;
}

function detectIncompatibilities(recs, trace) {
  let incomp = false;

  const classesToCheck = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'];
  classesToCheck.forEach(cls => {
    const selectedInClass = drugsInClass(cls);
    if (selectedInClass.length > 1) {
      const drugNames = selectedInClass.map(d => DRUG_LABELS[d]).join(' y ');
      recs.push({
        type: 'danger', tag: 'Duplicidad Terapéutica', title: 'Asociación Incompatible por misma familia',
        body: `Se ha detectado el uso simultáneo de <strong>${drugNames}</strong>. Estos fármacos pertenecen a la misma familia terapéutica. Su combinación no aporta beneficio clínico adicional, es completamente redundante y aumenta exponencialmente el riesgo de efectos secundarios. <strong>Se debe suspender de inmediato uno de ellos</strong> y, si el paciente precisa mayor control, sustituirlo por un fármaco de una familia distinta y compatible.`
      });
      trace.push(`Incompatibilidad detectada: Duplicidad en la familia ${cls} (${drugNames}).`);
      incomp = true;
    }
  });

  // FRENO DE SEGURIDAD RENAL ESTRICTO
  if (state.fge < 30) {
      recs.push({
          type: 'danger', tag: 'Alerta Renal Crítica', title: 'FGe < 30 ml/min: Manejo Especializado',
          body: `El paciente presenta un Filtrado Glomerular inferior a 30 ml/min. La prescripción farmacológica automática está restringida. <strong>El manejo de este paciente debe ser consensuado y monitorizado conjuntamente con el servicio de Nefrología.</strong>`
      });
      trace.push('Bloqueo de seguridad: FGe < 30 ml/min. Alerta de Nefrología activada.');
  }

  // ALERTA ESPECÍFICA FGe < 15 (Nota 7 del Algoritmo)
  if (state.fge < 15) {
      recs.push({
          type: 'info', tag: 'Nefropatía Terminal', title: 'FGe < 15 ml/min: Opciones preferentes',
          body: `El paciente presenta un filtrado glomerular severamente reducido (< 15 ml/min). En este estadio, las únicas terapias antidiabéticas recomendadas son: <strong>iDPP-4</strong> (ajustando la dosis según ficha técnica), <strong>Repaglinida</strong>, <strong>Pioglitazona</strong> o <strong>Insulina</strong>.`
      });
      trace.push('FGe < 15 ml/min: Se restringen opciones a iDPP-4, Repaglinida, Pioglitazona o Insulina.');
  }

  if (state.drugs.metformina && state.fge < 30) {
    recs.push({ type: 'danger', tag: 'Contraindicación Absoluta', title: 'Suspender Metformina Inmediatamente', body: `El paciente presenta un Filtrado Glomerular (FGe) de <strong>${state.fge} mL/min</strong>. A estos niveles, la Metformina está formalmente contraindicada por el riesgo severo de acidosis láctica. Se sugiere sustituir la base de tratamiento por fármacos seguros en ERC avanzada (ej. arGLP-1, iDPP-4 ajustados o insulina).` });
    trace.push('FGe <30: Retirada de metformina obligatoria.');
    incomp = true;
  } else if (state.drugs.metformina && state.fge < 45) {
    recs.push({ type: 'warn', tag: 'Ajuste de dosis', title: 'Se recomienda reducir la dosis de Metformina', body: `Con un FGe en el rango 30-45 mL/min, la Metformina exige precaución. Se debe reducir su dosis al 50% de la máxima tolerada previamente.` });
  }

  if (hasClass('isglt2') && state.fge < 20) {
    recs.push({ type: 'danger', tag: 'Reevaluación Clínica', title: 'Atención al uso de iSGLT-2 con FGe < 20', body: `El inicio de <strong>iSGLT-2</strong> no está aprobado con FGe < 20 mL/min. Si ya los tomaba previamente para protección renal y su función ha decaído, reevalúe con nefrología su continuidad.` });
  }

  if (state.drugs.pioglitazona && state.ic) {
    recs.push({ type: 'danger', tag: 'Contraindicación', title: 'Se recomienda suspender la Pioglitazona', body: `La <strong>Pioglitazona</strong> está contraindicada en Insuficiencia Cardíaca. Este fármaco produce retención hidrosalina y aumenta el riesgo de exacerbación e ingreso hospitalario por IC. Se sugiere cambiar a un <strong>iSGLT-2</strong>, que tiene el efecto diametralmente opuesto y protege el corazón.` });
    trace.push('Pioglitazona + IC: Incompatibilidad crítica.');
    incomp = true;
  }

  if (hasClass('idpp4') && (hasClass('arglp') || hasClass('argip'))) {
    recs.push({ type: 'danger', tag: 'Incompatibilidad Farmacodinámica', title: 'Se recomienda suspender el iDPP-4', body: `El paciente toma un <strong>iDPP-4</strong> simultáneamente con un análogo incretínico inyectable (<strong>arGLP-1 o arGIP/GLP-1</strong>). Al actuar ambos sobre la misma vía del GLP-1, su combinación carece de sinergia glucémica y es redundante. <strong>Sugerencia:</strong> Mantenga el inyectable (por su mayor potencia y protección vascular) y retire el iDPP-4 de la pauta.` });
    trace.push('Incompatibilidad: Solapamiento incretínico iDPP-4 + análogos inyectables.');
    incomp = true;
  }

  if (hasClass('arglp') && hasClass('argip')) {
    recs.push({ type: 'danger', tag: 'Incompatibilidad', title: 'Asociación Incompatible de Inyectables', body: `No se deben prescribir simultáneamente un <strong>arGLP-1</strong> (ej. semaglutida, dulaglutida) y un <strong>arGIP/GLP-1</strong> (Tirzepatida). Son moléculas de la misma clase basal y su uso combinado es erróneo. Elija el más adecuado y suspenda el otro.` });
    incomp = true;
  }

  if (hasClass('su') && state.fragilidad) {
    recs.push({ type: 'danger', tag: 'Riesgo Geriátrico', title: 'Se recomienda retirar las Sulfonilureas / Glinidas', body: `En pacientes con fragilidad o deterioro, los secretagogos (<strong>glimepirida, gliclazida, repaglinida</strong>) están fuertemente desaconsejados por provocar hipoglucemias severas que derivan en caídas y daño neurológico. <strong>Sugerencia:</strong> Sustituir por familias con extrema seguridad frente a bajadas de azúcar, como los <strong>iDPP-4</strong>.` });
    trace.push('Fragilidad + SU: Incompatibilidad por riesgo de hipoglucemia severa.');
    incomp = true;
  }
// ALERTA DE USO PREMATURO DE SULFONILUREAS (No recomendadas en 1ª o 2ª línea)
  if (hasClass('su') && !state.fragilidad) {
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
    // Si la SU es el primer o segundo fármaco, y no estamos en la excepción de FG < 15
    if (clasesUsadas < 3 && state.fge >= 15) {
      recs.push({
        type: 'warn', tag: 'Uso Prematuro', title: 'Sulfonilureas relegadas a 3º o 4º escalón',
        body: `El algoritmo 2026 no recomienda el uso de <strong>Sulfonilureas o Glinidas</strong> como monoterapia o doble terapia. Se han relegado a situaciones donde se precise un 3º o 4º fármaco tras fracasar otras familias con beneficios cardiorenales y menor riesgo de hipoglucemias. <em>Excepción: Uso de Repaglinida si FG < 15 ml/min.</em>`
      });
      trace.push('Aviso: Uso prematuro de SU/Glinidas en 1ª o 2ª línea detectado.');
    }
  }
  return incomp;
}

function renderOptimizedState(cond, state, target) {
    let justificacion = `El paciente ha alcanzado su objetivo glucémico individualizado (<strong>${state.hba1c.toFixed(1)} %</strong> para una meta de <strong>${target.label}</strong>). El esquema actual se considera idóneo y optimizado por los siguientes motivos clínicos:<br><ul>`;

    if (cond.id === 'ic') {
      justificacion += `<li><strong>Beneficio Pronóstico (IC):</strong> El paciente está recibiendo tratamiento con iSGLT-2 (y/o análogos incretínicos si procede), familias con nivel de evidencia 1A para reducir drásticamente las hospitalizaciones por insuficiencia cardíaca y la mortalidad cardiovascular.</li>`;
    } else if (cond.id === 'ecv') {
      justificacion += `<li><strong>Protección Cardiovascular:</strong> Al presentar alto riesgo o evento cardiovascular establecido, el esquema ya integra terapias cardioprotectoras (iSGLT-2, arGLP-1 o arGIP/GLP-1) que han demostrado disminuir los eventos adversos mayores (MACE), protegiendo el órgano diana independientemente de la glucemia.</li>`;
    } else if (cond.id === 'erc') {
      justificacion += `<li><strong>Nefroprotección:</strong> El régimen incluye fármacos de primera línea para la enfermedad renal (iSGLT-2 y/o arGLP-1), que ralentizan significativamente la caída del filtrado glomerular y la progresión a nefropatía terminal.</li>`;
    } else if (cond.id === 'obesidad') {
      justificacion += `<li><strong>Control Ponderal Activo:</strong> Teniendo obesidad como condicionante principal, el esquema actual incorpora moléculas (arGLP-1, arGIP/GLP-1 o iSGLT-2) que favorecen una pérdida de peso clínicamente relevante, atacando la base metabólica de la resistencia a la insulina.</li>`;
    } else if (cond.id === 'hepatica') {
      justificacion += `<li><strong>Mejora Histológica Hepática:</strong> El tratamiento incluye opciones (arGLP-1, arGIP/GLP-1, iSGLT-2 o pioglitazona) que han evidenciado capacidad para revertir o frenar la progresión de la esteatohepatitis metabólica y reducir la inflamación.</li>`;
    } else if (cond.id === 'fragilidad') {
      justificacion += `<li><strong>Seguridad Geriátrica:</strong> En base a su grado de fragilidad, la prioridad es la seguridad. Su esquema actual está libre de sulfonilureas y/o se fundamenta en fármacos de muy bajo riesgo de hipoglucemias (como los iDPP-4), preservando su funcionalidad y calidad de vida.</li>`;
    } else {
      justificacion += `<li><strong>Eficacia y Tolerabilidad:</strong> El paciente no presenta complicaciones mayores que fuercen el uso de una familia concreta, y está logrando un excelente control glucémico y metabólico con una medicación bien tolerada y exenta de conflictos farmacológicos.</li>`;
    }

    if (hasClass('met')) {
      justificacion += `<li><strong>Base Terapéutica Consolidada:</strong> Mantiene la Metformina como pilar del tratamiento, justificado por su probada eficacia, bajo coste y seguridad metabólica sostenida en el tiempo.</li>`;
    }

    justificacion += `</ul><br><strong>Conducta a seguir:</strong> No proceden cambios farmacológicos en este momento. Se recomienda mantener el esquema vigente y citar al paciente para su control clínico rutinario en 6 meses (revisión de HbA1c, FGe, cociente albúmina/creatinina y peso).`;
    
    return justificacion;
}

function generateRecs(cond, target) {
  const recs = [];
  const trace = [];
  let conditionHandledIntensification = false;

  trace.push(`Evaluación: HbA1c actual de ${state.hba1c.toFixed(1)} % frente a objetivo de ${target.label}`);

  const hasCriticalConflict = detectIncompatibilities(recs, trace);

  /* ============================================================
     CAMBIO PUNTO 4: Cuando hay clínica cardinal + HbA1c ≥ 8,5 %,
     se diferencia según función renal para evitar la contradicción
     "iniciar Metformina" + "suspender Metformina por FGe <30".
     ============================================================ */
  if (state.sintomatico && state.hba1c >= 8.5) {
    if (state.fge >= 30) {
      recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina Basal + Metformina', body: `Ante clínica cardinal grave con HbA1c ≥ 8,5 %, se debe iniciar inmediatamente <strong>Insulina Basal combinada con Metformina</strong> para frenar la glucotoxicidad.` });
      trace.push('Descompensación grave sintomática (FGe ≥ 30): Insulinización + Metformina.');
    } else {
      recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina Basal en monoterapia', body: `Ante clínica cardinal grave con HbA1c ≥ 8,5 % y <strong>FGe &lt; 30 ml/min</strong> (Metformina contraindicada), se debe iniciar <strong>Insulina Basal en monoterapia</strong> para frenar la glucotoxicidad. Tras la estabilización, valore asociar un <strong>iDPP-4</strong> con dosis ajustada al filtrado.` });
      trace.push('Descompensación grave sintomática (FGe < 30): Insulinización aislada por contraindicación de Metformina.');
    }
    conditionHandledIntensification = true; 
  } else if (state.sintomatico) {
    recs.push({ type: 'warn', tag: 'Clínica', title: 'Se recomienda investigar desencadenante', body: `Si el paciente presenta síntomas cardinales, investigue factores intercurrentes activos y valore el apoyo insulínico temporal.` });
  }

  if (cond.id === 'ic') { conditionHandledIntensification = handleIC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'ecv') { conditionHandledIntensification = handleECV(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'erc') { conditionHandledIntensification = handleERC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'obesidad') { conditionHandledIntensification = handleObesidad(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'hepatica') { conditionHandledIntensification = handleHepatica(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'fragilidad') { conditionHandledIntensification = handleFragilidad(recs, trace, target) || conditionHandledIntensification; }

  if (cond.id === null || (state.hba1c > target.upperBound && !conditionHandledIntensification && cond.id !== 'fragilidad' && !state.sintomatico)) {
      if (cond.id !== null) trace.push('Fármacos del condicionante optimizados pero paciente sigue fuera de objetivo -> Se aplica intensificación escalonada.');
      applyGeneralIntensification(recs, trace, target);
  }

  const inTarget = state.hba1c <= target.upperBound;
  const needsAction = recs.some(r => r.type === 'add' || r.type === 'warn' || r.type === 'danger');

  if (!needsAction && target.target !== null && inTarget && !hasCriticalConflict) {
    const justificacionOptimizado = renderOptimizedState(cond, state, target);
    recs.push({
      type: 'ok', tag: 'Paciente Optimizado', title: 'El tratamiento está clínica y farmacológicamente optimizado',
      body: justificacionOptimizado
    });
  } else if (state.hba1c > target.upperBound && target.target !== null && recs.some(r => r.type === 'add' || r.type === 'danger')) {
    recs.push({
      type: 'warn', tag: 'Seguimiento', title: 'Se recomienda reevaluar a los 3 meses',
      body: `Al no alcanzar el objetivo hoy y requerirse cambios o correcciones en el tratamiento, es obligatorio realizar un control de HbA1c a los 3 meses para evitar inercia clínica y confirmar la eficacia de la pauta establecida.`
    });
  }

  return { recs, trace };
}

/* ============================================================
   CAMBIO PUNTO 5: handleIC ahora emite un info-card cuando el
   paciente está en objetivo con iSGLT-2 y no lleva Metformina,
   justificando por qué no se añade (nota 6 del algoritmo).
   ============================================================ */
function handleIC(recs, trace, target) {
  let intensified = false;
  if (!hasClass('isglt2')) {
    if(state.fge >= 20) {
        recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar un iSGLT-2', body: `Pilar fundamental (independiente de HbA1c) por reducción de mortalidad e ingresos por IC.` });
        intensified = true;
    }
  }
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Combinar', title: 'Se recomienda asociar Metformina', body: `Para optimizar el control glucémico como compañero basal (nota 6 del algoritmo).` });
    intensified = true;
  } else if (!state.drugs.metformina && state.fge >= 30 && state.hba1c <= target.upperBound && hasClass('isglt2')) {
    recs.push({ type: 'info', tag: 'Metformina no necesaria', title: 'No se precisa asociar Metformina', body: `El paciente ya alcanza su objetivo glucémico (HbA1c <strong>${state.hba1c.toFixed(1)} %</strong>, meta ${target.label}) con el iSGLT-2 actual. La <strong>nota 6 del algoritmo redGDPS 2026</strong> indica que la Metformina se añade <em>para optimizar el control glucémico</em>; al estar el paciente controlado, no aporta beneficio pronóstico adicional, ya que la protección cardiovascular del iSGLT-2 en IC es independiente de la HbA1c.<br><br><strong>Si en futuras revisiones la HbA1c se eleva por encima del objetivo, la Metformina debe ser el primer fármaco a añadir.</strong>` });
    trace.push('Metformina no añadida en IC: paciente en objetivo con iSGLT-2 (nota 6).');
  }
  if (state.hba1c > target.upperBound && hasClass('isglt2') && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: 'Si insuficiente', title: 'Se recomienda añadir arGLP-1 o arGIP/GLP-1', body: `Añadir incretínicos por beneficio demostrado en ensayos recientes en pacientes con IC, como complemento al SGLT2.` });
    intensified = true;
  }
  return intensified;
}

/* ============================================================
   CAMBIO PUNTOS 5 y 7: handleECV ahora condiciona la
   recomendación de Metformina a HbA1c > objetivo, marca
   correctamente intensified = true (resolviendo la doble
   recomendación con applyGeneralIntensification), y emite un
   info-card cuando el paciente está en objetivo con
   cardioprotector y no precisa Metformina.
   ============================================================ */
function handleECV(recs, trace, target) {
  let intensified = false;
  const tieneCardio = hasClass('isglt2') || hasClass('arglp') || hasClass('argip');
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Añadir base', title: 'Se recomienda prescribir Metformina', body: `Compañero basal para optimizar el control glucémico en ECV (nota 6 del algoritmo). El paciente está fuera de objetivo y la Metformina es el primer fármaco a añadir.` });
    intensified = true;
  } else if (!state.drugs.metformina && state.fge >= 30 && state.hba1c <= target.upperBound && tieneCardio) {
    recs.push({ type: 'info', tag: 'Metformina no necesaria', title: 'No se precisa añadir Metformina', body: `El paciente ya alcanza su objetivo glucémico (HbA1c <strong>${state.hba1c.toFixed(1)} %</strong>, meta ${target.label}) con el cardioprotector actual. La <strong>nota 6 del algoritmo redGDPS 2026</strong> indica que la Metformina se añade <em>para optimizar el control glucémico</em>; al estar el paciente controlado, no aporta beneficio pronóstico adicional sobre el iSGLT-2/arGLP-1, ya que la protección cardiovascular de éstos es independiente de la HbA1c.<br><br><strong>Si en futuras revisiones la HbA1c se eleva por encima del objetivo, la Metformina debe ser el primer fármaco a añadir.</strong>` });
    trace.push('Metformina no añadida en ECV: paciente en objetivo con cardioprotector (nota 6).');
  }
  if (!tieneCardio) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda terapia combinada temprana', body: `Iniciar Metformina + (iSGLT-2 o arGLP-1 o arGIP/GLP-1) de inmediato, independientemente de la cifra de HbA1c, para frenar eventos MACE.` });
    intensified = true;
  } else if (state.hba1c > target.upperBound && !(hasClass('isglt2') && (hasClass('arglp') || hasClass('argip')))) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda sumar una segunda familia cardioprotectora', body: `Se recomienda combinar un iSGLT-2 con un arGLP-1/arGIP-GLP-1 simultáneamente para maximizar el pronóstico y atacar la hiperglucemia persistente.` });
    intensified = true;
  }
  return intensified;
}

function handleERC(recs, trace, target) {
  let intensified = false;
  if (state.fge >= 20 && !hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar iSGLT-2', body: `Fármacos prioritarios en enfermedad renal por su capacidad para ralentizar la caída del FG y la progresión a diálisis.` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: '2ª línea', title: 'Se recomienda añadir arGLP-1', body: `Especialmente la semaglutida (respaldada por el estudio FLOW) por su fuerte protección renal adicional al SGLT2.` });
    intensified = true;
  }
  return intensified;
}

function handleObesidad(recs, trace, target) {
  let intensified = false;
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  if (!tieneIncretina) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar arGLP-1 o arGIP/GLP-1', body: `Opción mandatoria de primer escalón para pacientes obesos por las drásticas pérdidas de peso obtenidas (10-20%).` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && tieneIncretina && !hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda asociar un iSGLT-2', body: `Añadir a la incretina como mecanismo de rescate oral para controlar la glucemia y aportar una discreta sinergia ponderal.` });
    intensified = true;
  }
  return intensified;
}

function handleHepatica(recs, trace, target) {
  let intensified = false;
  if (!hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda arGLP-1 o arGIP/GLP-1', body: `Indicados en hígado graso metabólico por la demostrada reversión histológica de la esteatohepatitis.` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && !hasClass('isglt2') && !state.drugs.pioglitazona) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda añadir iSGLT-2 o Pioglitazona', body: `Si el control glucémico fracasa, el iSGLT-2 y la Pioglitazona (ambos con beneficios hepáticos avalados) son las intensificaciones de elección.` });
    intensified = true;
  }
  return intensified;
}

function handleFragilidad(recs, trace, target) {
  if (!hasClass('idpp4') && !hasClass('arglp') && !hasClass('argip') && state.fragGrade !== 'muyGrave') {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda el uso de iDPP-4', body: `En pacientes añosos y vulnerables, los iDPP-4 (linagliptina, sitagliptina) son el tratamiento base preferido por carecer de riesgo de hipoglucemia y tener posologías sencillas.` });
  }
  if (state.fragGrade === 'muyGrave') {
    recs.push({ type: 'warn', tag: 'Final de vida', title: 'Se recomienda desintensificación estructurada', body: `El objetivo es puramente paliativo. Deben retirarse todas las medidas para prevenir complicaciones crónicas y ajustar fármacos al mínimo viable para evitar clínica aguda.` });
  }
  return true; 
}

function applyGeneralIntensification(recs, trace, target) {
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
  
  const availableADNIs = getAvailableADNIs(state);
  let optionsText = '';
  if (availableADNIs.length > 0) {
    optionsText = `<br><br>Para este paso de intensificación, las <strong>únicas familias farmacológicas (ADNIs) compatibles y seguras</strong> para su perfil (y que aún no toma) son:<ul><li>` + availableADNIs.join('</li><li>') + `</li></ul><em>Debe seleccionar una de ellas valorando sus efectos sobre el peso, riesgo de hipoglucemias y preferencias del paciente.</em>`;
  } else {
    optionsText = `<br><br><strong>Aviso Crítico:</strong> No quedan más familias de fármacos orales ni incretínicos (ADNIs) seguras o clínicamente compatibles para añadir a la pauta de este paciente.`;
  }

  if (clasesUsadas === 0) {
    if (state.hba1c >= 8.5) {
      if (state.fge >= 30) {
          recs.push({ type: 'add', tag: 'Inicio Intensivo', title: 'Se recomienda iniciar con Doble Terapia', body: `Al tratarse de un paciente sin tratamiento previo pero con una HbA1c altísima (≥ 8,5 %), el algoritmo prohíbe empezar con monoterapia para evitar inercia terapéutica. Se debe iniciar directamente combinando la <strong>Metformina</strong> con un fármaco de alta potencia (iSGLT-2, arGLP-1 o arGIP/GLP-1).` });
      } else {
          recs.push({ type: 'add', tag: 'Inicio Intensivo', title: 'Se recomienda iniciar con Incretinas / iDPP-4', body: `Al presentar HbA1c altísima (≥ 8,5 %) y un FGe < 30 (que contraindica la Metformina), debe evaluarse el inicio cuidadoso de terapias compatibles con su función renal o insulinización directa.` });
      }
      trace.push('Paciente sin tratamiento y HbA1c >= 8.5: Inicio inmediato con doble terapia o insulina según FGe.');
    } else if (state.hba1c > target.upperBound) {
      if (state.fge >= 30) {
        recs.push({ type: 'add', tag: 'Inicio', title: 'Se recomienda iniciar tratamiento con Metformina', body: `En un paciente virgen de tratamiento y sin condicionantes clínicos predominantes, la estrategia universal marca iniciar <strong>Metformina</strong> como base. Titule la dosis progresivamente para mejorar la tolerabilidad gástrica.` });
        trace.push('Paciente sin tratamiento y HbA1c fuera de objetivo: Inicio con Metformina.');
      } else {
        recs.push({ type: 'add', tag: 'Inicio', title: 'Se recomienda iniciar Monoterapia (alternativa a Metformina)', body: `La Metformina está contraindicada por el bajo filtrado glomerular actual. Se recomienda iniciar con un <strong>iDPP-4</strong> (por su probada seguridad en ERC) o un <strong>arGLP-1</strong> si la función renal aún lo permite.` });
      }
    }
    return;
  }

  if (state.hba1c >= 8.5) {
    if (clasesUsadas === 1) {
      recs.push({ type: 'add', tag: 'Intensificación', title: 'Se recomienda instaurar Doble Terapia inicial', body: `Al presentar una HbA1c altísima (≥ 8,5 %), el algoritmo ordena no demorar el abordaje escalonado clásico. Se debe añadir inmediatamente a su base actual un fármaco de alta potencia.${optionsText}` });
      trace.push(`Intensificación agresiva: HbA1c ≥ 8.5, salto a doble terapia.`);
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Intensificar a Triple', title: 'Se recomienda progresar a Triple Terapia', body: `La doble terapia actual ha sido superada por la alta glucotoxicidad. Está indicado añadir un tercer fármaco oral/incretina (3er ADNI).${optionsText}` });
      trace.push(`Intensificación: HbA1c ≥ 8.5, instauración de triple terapia ADNI.`);
    } else {
      recs.push({ type: 'add', tag: 'Paso Estratégico', title: 'Se recomienda añadir un 4º ADNI o valorar el inicio directo de Insulina Basal', body: `El paciente presenta un control sumamente deficiente (${state.hba1c.toFixed(1)} %) a pesar de que ya se le administran ${clasesUsadas} fármacos simultáneos. El algoritmo marca una doble opción:<br><br>1. <strong>Añadir un cuarto fármaco (4º ADNI)</strong>, si el paciente se niega a inyectables o si se confía en la potencia de la familia añadida.<br>2. <strong>Incio de Insulinización Basal</strong>. Ante este nivel extremo tras múltiples fracasos terapéuticos, es altamente probable un fracaso pancreático, siendo la insulina el único rescate realista.${optionsText}` });
      trace.push(`HbA1c extrema con 3+ fármacos: Opción abierta entre 4º ADNI de rescate o paso directo a Insulinización.`);
    }
  } 
  else if (state.hba1c > target.upperBound) {
    if (clasesUsadas === 1) {
      recs.push({ type: 'add', tag: 'Progresión', title: 'Se recomienda asociar un segundo fármaco', body: `Para limar la diferencia hasta alcanzar el objetivo, se recomienda añadir un segundo fármaco complementario a la pauta actual.${optionsText}` });
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Progresión', title: 'Se recomienda instaurar Triple Terapia', body: `La combinación actual es insuficiente para alcanzar la meta. Está indicado sumar una tercera familia farmacológica.${optionsText}` });
    } else {
      recs.push({ type: 'add', tag: 'Núcleo del Algoritmo', title: 'Se recomienda añadir un 4º ADNI o iniciar Insulina Basal', body: `Al fracasar ${clasesUsadas} familias farmacológicas, el paciente entra en la fase central (y más restrictiva) del algoritmo. Debe valorar el perfil particular del paciente para decidir entre intentar asociar un <strong>cuarto fármaco (ADNI)</strong> o bien dar paso a una pauta de <strong>Insulina Basal</strong>.${optionsText}` });
      trace.push(`Intensificación progresiva: Fracaso a 3 fármacos. Habilitadas las opciones de 4º ADNI (si disponibles) e Insulina.`);
    }
  }
}

function renderCurrentDrugs() {
  const el = document.getElementById('currentDrugs');
  const active = Object.entries(state.drugs).filter(([k,v]) => v).map(([k]) => k);
  if (active.length === 0) { el.innerHTML = '<span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado (Paciente sin tratamiento)</span>'; return; }
  el.innerHTML = active.map(d => `<span class="drug-pill current">${DRUG_LABELS[d]}</span>`).join('');
}

function renderRecs(recs) {
  const el = document.getElementById('recommendations');
  if (recs.length === 0) { el.innerHTML = '<div class="empty-state">No se pudieron generar recomendaciones.</div>'; return; }
  el.innerHTML = recs.map(r => `
    <div class="rec-card ${r.type}">
      <div class="rec-card-tag">${r.tag}</div>
      <div class="rec-card-title">${r.title}</div>
      <div class="rec-card-body">${r.body}</div>
    </div>
  `).join('');
}

function renderTrace(trace) {
  document.getElementById('trace').innerHTML = trace.map(t => `<li>${t}</li>`).join('');
}

function update() {
  state.hba1c = parseFloat(document.getElementById('hba1c').value);
  state.edad = parseInt(document.getElementById('edad').value) || 0;
  state.tiempoDx = parseFloat(document.getElementById('tiempoDx').value) || 0;
  state.fge = parseFloat(document.getElementById('fge').value) || 0;
  state.sintomatico = document.getElementById('sintomatico').checked;
  state.dxReciente = document.getElementById('dxReciente').checked;
  state.ic = document.getElementById('ic').checked;
  state.ecv = document.getElementById('ecv').checked;
  state.rcvAlto = document.getElementById('rcvAlto').checked;
  state.erc = document.getElementById('erc').checked;
  state.obesidad = document.getElementById('obesidad').checked;
  state.hepatica = document.getElementById('hepatica').checked;
  state.fragilidad = document.getElementById('fragilidad').checked;
  state.deterioro = document.getElementById('deterioro').checked;

  const fragRadio = document.querySelector('input[name="fragGrade"]:checked');
  state.fragGrade = fragRadio ? fragRadio.value : 'moderadaGrave';

  state.drugs = {};
  document.querySelectorAll('[data-drug]').forEach(cb => { state.drugs[cb.dataset.drug] = cb.checked; });

  /* ============================================================
     CAMBIO PUNTO 6: El flag "deterioro" no debe rebajar un
     "muyGrave" preexistente. Si el usuario ya marcó fragilidad
     muy grave, ésta prevalece sobre el deterioro cognitivo.
     ============================================================ */
  if (state.deterioro) {
      state.fragilidad = true; document.getElementById('fragilidad').checked = true;
      if (state.fragGrade !== 'muyGrave') {
        state.fragGrade = 'moderadaGrave';
        document.querySelector('input[name="fragGrade"][value="moderadaGrave"]').checked = true;
      }
  }

  document.getElementById('hbValue').textContent = state.hba1c.toFixed(1);
  const gme = Math.round(28.7 * state.hba1c - 46.7);
  document.getElementById('gme').textContent = gme;

  document.getElementById('fragilidadGrade').classList.toggle('active', state.fragilidad);
  document.querySelectorAll('.check').forEach(c => { const id = c.dataset.check; if (id) c.classList.toggle('checked', state[id] === true); });
  document.querySelectorAll('.radio-pill').forEach(p => { const input = p.querySelector('input'); p.classList.toggle('selected', input.checked); });
  document.querySelectorAll('.drug-class').forEach(dc => { const cls = dc.dataset.drugclass; dc.classList.toggle('has-active', hasClass(cls)); });

  const cond = getConditioner();
  const target = getTarget();
  const { recs, trace } = generateRecs(cond, target);

  const tv = document.getElementById('targetValue');
  if (target.target === null) { tv.textContent = 'Sin objetivo'; tv.classList.add('muted'); } 
  else { tv.textContent = target.label; tv.classList.remove('muted'); }

  document.getElementById('targetRationale').textContent = target.rationale;

  const status = document.getElementById('targetStatus');
  if (target.target === null) { status.className = 'target-status warn'; status.textContent = 'Sin objetivo numérico'; } 
  else if (state.hba1c <= target.upperBound) { status.className = 'target-status ok'; status.textContent = 'En objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else if (state.hba1c <= target.upperBound + 0.2) { status.className = 'target-status warn'; status.textContent = 'Al límite o levemente sobre el objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else { status.className = 'target-status no'; status.textContent = 'Lejos del objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; }

  document.getElementById('conditionerName').textContent = cond.name;
  document.getElementById('conditionerMeta').textContent = cond.meta;

  renderCurrentDrugs(); renderRecs(recs); renderTrace(trace);
}

function resetAll() {
  document.getElementById('hba1c').value = 7.5;
  document.getElementById('edad').value = 65;
  document.getElementById('tiempoDx').value = 5;
  document.getElementById('fge').value = 80;
  document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
  const fragModGrave = document.querySelector('input[name="fragGrade"][value="moderadaGrave"]');
  if (fragModGrave) fragModGrave.checked = true;
  update();
}

document.querySelectorAll('input, select').forEach(el => { el.addEventListener('input', update); el.addEventListener('change', update); });
update();
</script>

