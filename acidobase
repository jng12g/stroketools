<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Algoritmo redGDPS 2026 · DM2</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F7F4EE;
    --paper: #FFFFFF;
    --paper-tint: #FAF7F1;
    --ink: #1A1F2A;
    --ink-soft: #4A5365;
    --ink-mute: #7C8497;
    --rule: #E4DFD5;
    --rule-strong: #C9C3B6;
    --accent: #A52A3A;
    --accent-deep: #7A1D2A;
    --evidence: #2E6B58;
    --evidence-soft: #E4EFE9;
    --warn: #B26A1F;
    --warn-soft: #F7EAD4;
    --danger: #9F2230;
    --danger-soft: #F5DDDF;
    --info: #2C547A;
    --info-soft: #E1ECF4;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-image:
      radial-gradient(circle at 15% 10%, rgba(165,42,58,0.04) 0%, transparent 40%),
      radial-gradient(circle at 85% 90%, rgba(46,107,88,0.04) 0%, transparent 40%);
    background-attachment: fixed;
    min-height: 100vh;
  }

  header.masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper-tint);
  }
  .masthead-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 22px 32px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: baseline; gap: 14px; }
  .brand-mark {
    font-family: "Fraunces", serif; font-weight: 600; font-style: italic;
    font-size: 26px; letter-spacing: -0.02em; color: var(--accent);
  }
  .brand-mark::before {
    content: ""; display: inline-block; width: 10px; height: 10px;
    background: var(--accent); border-radius: 50%; margin-right: 10px;
    transform: translateY(-2px);
  }
  .brand-sub { font-size: 12px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 500; }
  .masthead h1 { margin: 0; font-family: "Fraunces", serif; font-weight: 400; font-size: 22px; letter-spacing: -0.015em; color: var(--ink); }
  .masthead h1 em { font-style: italic; color: var(--accent); }

  main {
    max-width: 1400px; margin: 0 auto; padding: 32px;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 28px;
  }
  @media (max-width: 980px) { main { grid-template-columns: 1fr; } }

  .panel { background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; }
  .panel-header {
    padding: 18px 24px 14px; border-bottom: 1px solid var(--rule);
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
  }
  .panel-header h2 { margin: 0; font-family: "Fraunces", serif; font-weight: 500; font-size: 19px; letter-spacing: -0.01em; }
  .panel-header .meta { font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-mute); }

  .section { border-bottom: 1px solid var(--rule); padding: 20px 24px; }
  .section:last-child { border-bottom: 0; }
  .section-title {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--ink-mute); font-weight: 600; margin: 0 0 14px; display: flex; align-items: center; gap: 8px;
  }
  .section-title::before { content: ""; width: 18px; height: 1px; background: var(--ink-mute); }

  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 6px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 12px; font-weight: 500; color: var(--ink-soft); letter-spacing: 0.01em; }
  .field-hint { font-size: 11px; color: var(--ink-mute); font-style: italic; }

  input[type="number"], input[type="text"], select {
    width: 100%; background: var(--paper-tint); border: 1px solid var(--rule);
    border-radius: 3px; padding: 8px 10px; font-family: inherit; font-size: 14px;
    color: var(--ink); transition: border-color 0.15s, background 0.15s;
  }
  input[type="number"]:focus, input[type="text"]:focus, select:focus {
    outline: none; border-color: var(--accent); background: var(--paper);
  }

  .check-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
  .check {
    position: relative; display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border: 1px solid var(--rule); border-radius: 3px;
    cursor: pointer; background: var(--paper); transition: all 0.15s; user-select: none;
  }
  .check:hover { border-color: var(--rule-strong); background: var(--paper-tint); }
  .check input { margin: 2px 0 0; accent-color: var(--accent); cursor: pointer; flex-shrink: 0; }
  .check.checked { background: var(--paper-tint); border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .check-body { display: flex; flex-direction: column; gap: 2px; line-height: 1.35; }
  .check-label { font-weight: 500; font-size: 13.5px; color: var(--ink); }
  .check-desc { font-size: 11.5px; color: var(--ink-mute); }

  .check.evidence { border-left: 3px solid var(--evidence); }
  .check.evidence.checked { box-shadow: inset 3px 0 0 var(--evidence); border-left-color: transparent; }
  .ev-badge {
    display: inline-block; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--evidence-soft); color: var(--evidence); padding: 1px 5px;
    border-radius: 2px; font-weight: 600; margin-left: 6px; vertical-align: 1px;
  }

  .sub-field {
    margin-top: 10px; padding: 10px 12px; background: var(--paper-tint);
    border-left: 2px solid var(--rule-strong); font-size: 13px; display: none;
  }
  .sub-field.active { display: block; }
  .sub-field label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-mute); font-weight: 600; display: block; margin-bottom: 4px;
  }

  .radio-group { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .radio-pill {
    border: 1px solid var(--rule); background: var(--paper); padding: 5px 10px;
    border-radius: 999px; font-size: 12px; cursor: pointer; transition: all 0.15s; color: var(--ink-soft);
  }
  .radio-pill input { display: none; }
  .radio-pill.selected { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .hba1c-control { display: flex; align-items: center; gap: 14px; margin-top: 4px; }
  .hba1c-value {
    font-family: "Fraunces", serif; font-size: 32px; font-weight: 500;
    color: var(--accent); letter-spacing: -0.02em; min-width: 80px;
  }
  .hba1c-value .unit { font-size: 14px; color: var(--ink-mute); font-weight: 400; margin-left: 2px; }
  input[type="range"] { flex: 1; accent-color: var(--accent); }

  .output-panel { position: sticky; top: 24px; align-self: start; }
  .summary {
    padding: 26px 28px 22px; background: linear-gradient(180deg, var(--paper-tint) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--rule);
  }
  .target-block { display: flex; align-items: baseline; gap: 16px; margin-bottom: 4px; }
  .target-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 600; }
  .target-value {
    font-family: "Fraunces", serif; font-size: 44px; font-weight: 500;
    letter-spacing: -0.02em; color: var(--ink); line-height: 1;
  }
  .target-value.muted { font-size: 22px; color: var(--ink-soft); font-style: italic; }
  .target-status {
    margin-top: 12px; display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em;
  }
  .target-status.ok { background: var(--evidence-soft); color: var(--evidence); }
  .target-status.no { background: var(--danger-soft); color: var(--danger); }
  .target-status.warn { background: var(--warn-soft); color: var(--warn); }
  .target-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .conditioner { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .conditioner .target-label { margin-bottom: 8px; display: block; }
  .conditioner-name { font-family: "Fraunces", serif; font-size: 22px; font-weight: 500; color: var(--accent); font-style: italic; }
  .conditioner-meta { font-size: 12px; color: var(--ink-mute); margin-top: 4px; }

  .rec-section { padding: 22px 28px; border-bottom: 1px solid var(--rule); }
  .rec-section:last-child { border-bottom: 0; }
  .rec-title {
    font-family: "Fraunces", serif; font-size: 15px; font-weight: 500; margin: 0 0 10px;
    display: flex; align-items: center; gap: 10px;
  }
  .rec-title::before {
    content: ""; display: inline-block; width: 4px; height: 14px;
    background: var(--accent); border-radius: 1px;
  }

  .rec-card {
    background: var(--paper-tint); border: 1px solid var(--rule); border-radius: 3px;
    padding: 14px 16px; margin-bottom: 10px; position: relative;
  }
  .rec-card:last-child { margin-bottom: 0; }

  .rec-card.add { border-left: 3px solid var(--evidence); background: var(--evidence-soft); }
  .rec-card.add .rec-card-tag { color: var(--evidence); }
  .rec-card.warn { border-left: 3px solid var(--warn); background: var(--warn-soft); }
  .rec-card.warn .rec-card-tag { color: var(--warn); }
  .rec-card.danger { border-left: 3px solid var(--danger); background: var(--danger-soft); }
  .rec-card.danger .rec-card-tag { color: var(--danger); }
  .rec-card.info { border-left: 3px solid var(--info); background: var(--info-soft); }
  .rec-card.info .rec-card-tag { color: var(--info); }
  .rec-card.ok { border-left: 3px solid var(--evidence); background: #E4EFE9; }
  .rec-card.ok .rec-card-tag { color: var(--evidence); }

  .rec-card-tag { font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; margin-bottom: 6px; }
  .rec-card-title { font-weight: 600; font-size: 14.5px; color: var(--ink); margin-bottom: 4px; }
  .rec-card-body { font-size: 13px; color: var(--ink-soft); line-height: 1.5; }
  .rec-card-body strong { color: var(--ink); }

  .drug-line { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .drug-pill {
    display: inline-flex; align-items: center; padding: 3px 10px; background: var(--paper);
    border: 1px solid var(--rule-strong); border-radius: 999px; font-size: 12px; font-weight: 500;
    color: var(--ink); font-family: "JetBrains Mono", monospace; letter-spacing: -0.01em;
  }
  .drug-pill.current { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .trace { font-size: 12px; line-height: 1.6; color: var(--ink-soft); }
  .trace ol { padding-left: 0; list-style: none; counter-reset: step; margin: 0; }
  .trace li {
    counter-increment: step; padding: 4px 0 4px 30px; position: relative; border-bottom: 1px dashed var(--rule);
  }
  .trace li:last-child { border-bottom: 0; }
  .trace li::before {
    content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 4px;
    font-family: "JetBrains Mono", monospace; font-size: 10px; color: var(--accent); font-weight: 600;
  }

  .empty-state { padding: 40px 28px; text-align: center; color: var(--ink-mute); font-style: italic; font-family: "Fraunces", serif; font-size: 15px; }

  footer {
    max-width: 1400px; margin: 0 auto; padding: 24px 32px 48px; font-size: 11px;
    color: var(--ink-mute); line-height: 1.6; border-top: 1px solid var(--rule); margin-top: 20px;
  }
  footer .ref { font-family: "JetBrains Mono", monospace; color: var(--accent); }

  .reset-btn {
    background: transparent; border: 1px solid var(--rule-strong); border-radius: 3px;
    padding: 6px 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-soft); cursor: pointer; font-family: inherit; font-weight: 500; transition: all 0.15s;
  }
  .reset-btn:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .drug-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .drug-class {
    border: 1px solid var(--rule); border-radius: 3px; padding: 10px 12px;
    background: var(--paper); transition: all 0.15s;
  }
  .drug-class.has-active { border-color: var(--accent); background: var(--paper-tint); }
  .drug-class-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-mute); font-weight: 600; margin-bottom: 8px; }
  .drug-class.has-active .drug-class-title { color: var(--accent); }

  .drug-options { display: flex; flex-direction: column; gap: 4px; }
  .drug-option { display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer; padding: 3px 0; color: var(--ink-soft); }
  .drug-option input { accent-color: var(--accent); }
  .drug-option input:checked + span { color: var(--ink); font-weight: 600; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-inner">
    <div class="brand">
      <div class="brand-mark">redGDPS</div>
      <div class="brand-sub">Algoritmo 2026 · DM2</div>
    </div>
    <h1>De la <em>glucemia</em> al paciente · soporte de decisión</h1>
    <button class="reset-btn" onclick="resetAll()">Reiniciar</button>
  </div>
</header>

<main>
  <section class="panel" id="inputPanel">
    <div class="panel-header">
      <h2>Datos del paciente</h2>
      <span class="meta">Entradas clínicas</span>
    </div>

    <div class="section">
      <h3 class="section-title">Datos clínicos básicos</h3>
      <div class="field" style="margin-bottom:14px;">
        <label>HbA1c actual</label>
        <div class="hba1c-control">
          <div class="hba1c-value"><span id="hbValue">7.5</span><span class="unit">%</span></div>
          <input type="range" id="hba1c" min="5" max="14" step="0.1" value="7.5">
        </div>
        <div class="field-hint" id="hbHint">Glucemia media estimada ≈ <span id="gme">169</span> mg/dL</div>
      </div>

      <div class="row">
        <div class="field">
          <label>Edad (años)</label>
          <input type="number" id="edad" min="18" max="110" value="65">
        </div>
        <div class="field">
          <label>Tiempo desde dx (años)</label>
          <input type="number" id="tiempoDx" min="0" max="60" value="5" step="0.5">
        </div>
        <div class="field">
          <label>FG estimado (mL/min)</label>
          <input type="number" id="fge" min="5" max="150" value="80">
        </div>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Clínica cardinal</h3>
      <div class="check-grid">
        <label class="check" data-check="sintomatico">
          <input type="checkbox" id="sintomatico">
          <span class="check-body">
            <span class="check-label">Síntomas cardinales</span>
            <span class="check-desc">Poliuria, polidipsia, pérdida de peso no explicable</span>
          </span>
        </label>
        <label class="check" data-check="dxReciente">
          <input type="checkbox" id="dxReciente">
          <span class="check-body">
            <span class="check-label">Diagnóstico reciente</span>
            <span class="check-desc">Primer año tras el diagnóstico</span>
          </span>
        </label>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Condicionantes clínicos (prioridad ←→)</h3>
      <div class="check-grid">
        <label class="check evidence" data-check="ic">
          <input type="checkbox" id="ic">
          <span class="check-body">
            <span class="check-label">Insuficiencia cardíaca <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">Cualquier FE; con o sin descompensación</span>
          </span>
        </label>
        <label class="check evidence" data-check="ecv">
          <input type="checkbox" id="ecv">
          <span class="check-body">
            <span class="check-label">ECV establecida <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">C. isquémica, ictus/AIT, EAP, ateromatosis significativa</span>
          </span>
        </label>
        <label class="check evidence" data-check="rcvAlto">
          <input type="checkbox" id="rcvAlto">
          <span class="check-body">
            <span class="check-label">RCV alto <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">≥3 FRCV (HTA, dislipemia, tabaco, ERC, albuminuria, obesidad, AF precoz)</span>
          </span>
        </label>
        <label class="check evidence" data-check="erc">
          <input type="checkbox" id="erc">
          <span class="check-body">
            <span class="check-label">ERC <span class="ev-badge">Evidencia</span></span>
            <span class="check-desc">FG &lt; 60 o albuminuria persistente</span>
          </span>
        </label>
        <label class="check" data-check="obesidad">
          <input type="checkbox" id="obesidad">
          <span class="check-body">
            <span class="check-label">Obesidad (IMC ≥ 30 kg/m²)</span>
            <span class="check-desc">Empeora el control y eleva riesgo cardiometabólico</span>
          </span>
        </label>
        <label class="check" data-check="hepatica">
          <input type="checkbox" id="hepatica">
          <span class="check-body">
            <span class="check-label">Enfermedad hepática metabólica</span>
            <span class="check-desc">MASLD / MASH (antes EHGNA / EHNA)</span>
          </span>
        </label>
        <label class="check" data-check="fragilidad">
          <input type="checkbox" id="fragilidad">
          <span class="check-body">
            <span class="check-label">Fragilidad</span>
            <span class="check-desc">Comorbilidades, polifarmacia, esperanza vida reducida</span>
          </span>
        </label>
      </div>

      <div class="sub-field" id="fragilidadGrade">
        <label>Grado de fragilidad</label>
        <div class="radio-group" id="fragilidadOpts">
          <label class="radio-pill"><input type="radio" name="fragGrade" value="leve" checked> Leve</label>
          <label class="radio-pill"><input type="radio" name="fragGrade" value="moderada"> Moderada</label>
          <label class="radio-pill"><input type="radio" name="fragGrade" value="grave"> Grave</label>
          <label class="radio-pill"><input type="radio" name="fragGrade" value="muyGrave"> Muy grave / vida limitada</label>
        </div>
      </div>

      <div class="check-grid" style="margin-top: 10px;">
        <label class="check" data-check="deterioro">
          <input type="checkbox" id="deterioro">
          <span class="check-body">
            <span class="check-label">Deterioro cognitivo / limitación funcional</span>
            <span class="check-desc">Marca automáticamente fragilidad moderada-grave (Objetivo 7,5-8,5%)</span>
          </span>
        </label>
      </div>
    </div>

    <div class="section">
      <h3 class="section-title">Tratamiento actual (qué toma ya)</h3>
      <div class="drug-grid">
        <div class="drug-class" data-drugclass="met">
          <div class="drug-class-title">Biguanida</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="metformina"><span>Metformina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="isglt2">
          <div class="drug-class-title">iSGLT-2</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="empagliflozina"><span>Empagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="dapagliflozina"><span>Dapagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="canagliflozina"><span>Canagliflozina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="ertugliflozina"><span>Ertugliflozina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="arglp">
          <div class="drug-class-title">arGLP-1</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="semaglutida"><span>Semaglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="dulaglutida"><span>Dulaglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="liraglutida"><span>Liraglutida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="exenatida"><span>Exenatida / lixisenatida</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="argip">
          <div class="drug-class-title">arGIP/GLP-1</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="tirzepatida"><span>Tirzepatida</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="idpp4">
          <div class="drug-class-title">iDPP-4</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="sitagliptina"><span>Sitagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="linagliptina"><span>Linagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="vildagliptina"><span>Vildagliptina</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="saxagliptina"><span>Saxagliptina</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="su">
          <div class="drug-class-title">Sulfonilureas / Glinidas</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="glimepirida"><span>Glimepirida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="gliclazida"><span>Gliclazida</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="repaglinida"><span>Repaglinida</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="pio">
          <div class="drug-class-title">Tiazolidindiona</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="pioglitazona"><span>Pioglitazona</span></label>
          </div>
        </div>
        <div class="drug-class" data-drugclass="ins">
          <div class="drug-class-title">Insulina</div>
          <div class="drug-options">
            <label class="drug-option"><input type="checkbox" data-drug="insulinaBasal"><span>Basal (glargina/degludec/detemir)</span></label>
            <label class="drug-option"><input type="checkbox" data-drug="insulinaPrandial"><span>Prandial / mezcla</span></label>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="panel output-panel" id="outputPanel">
    <div class="panel-header">
      <h2>Recomendación clínica</h2>
      <span class="meta">redGDPS 2026</span>
    </div>

    <div class="summary">
      <div class="target-block">
        <div style="flex:1;">
          <div class="target-label">Objetivo HbA1c personalizado</div>
          <div class="target-value" id="targetValue">&lt; 7 %</div>
        </div>
      </div>
      <div id="targetStatus" class="target-status warn">Cargando…</div>
      <div style="font-size:12px; color:var(--ink-mute); margin-top:6px;" id="targetRationale"></div>

      <div class="conditioner">
        <span class="target-label">Condicionante predominante</span>
        <div class="conditioner-name" id="conditionerName">—</div>
        <div class="conditioner-meta" id="conditionerMeta"></div>
      </div>
    </div>

    <div class="rec-section">
      <h3 class="rec-title">Tratamiento actual</h3>
      <div class="drug-line" id="currentDrugs">
        <span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado</span>
      </div>
    </div>

    <div class="rec-section">
      <h3 class="rec-title">Se recomienda</h3>
      <div id="recommendations">
        <div class="empty-state">Introduce los datos del paciente para generar la recomendación.</div>
      </div>
    </div>

    <div class="rec-section">
      <h3 class="rec-title">Trazado del razonamiento</h3>
      <div class="trace">
        <ol id="trace"></ol>
      </div>
    </div>

  </section>
</main>

<footer>
  Herramienta de soporte clínico basada en el <span class="ref">Algoritmo de tratamiento de la DM2 · redGDPS 2026</span> (García FJ, Artola S, Ávila L et al. <em>Diabetes Práctica</em> 2025;16(04):107-139). 
  Esta aplicación es una ayuda; no sustituye al juicio clínico ni a la lectura íntegra del documento original. Verifique siempre indicaciones, contraindicaciones y financiación vigente antes de prescribir.
</footer>

<script>
/* =================================================================
   Algoritmo redGDPS 2026 - Lógica clínica estructurada y razonada
   ================================================================= */

const state = {
  hba1c: 7.5,
  edad: 65,
  tiempoDx: 5,
  fge: 80,
  sintomatico: false,
  dxReciente: false,
  ic: false,
  ecv: false,
  rcvAlto: false,
  erc: false,
  obesidad: false,
  hepatica: false,
  fragilidad: false,
  fragGrade: 'leve',
  deterioro: false,
  drugs: {}
};

const DRUG_LABELS = {
  metformina: 'Metformina', empagliflozina: 'Empagliflozina', dapagliflozina: 'Dapagliflozina', canagliflozina: 'Canagliflozina', ertugliflozina: 'Ertugliflozina',
  semaglutida: 'Semaglutida', dulaglutida: 'Dulaglutida', liraglutida: 'Liraglutida', exenatida: 'Exenatida', tirzepatida: 'Tirzepatida',
  sitagliptina: 'Sitagliptina', linagliptina: 'Linagliptina', vildagliptina: 'Vildagliptina', saxagliptina: 'Saxagliptina',
  glimepirida: 'Glimepirida', gliclazida: 'Gliclazida', repaglinida: 'Repaglinida', pioglitazona: 'Pioglitazona',
  insulinaBasal: 'Insulina basal', insulinaPrandial: 'Insulina prandial'
};

const DRUG_CLASS = {
  metformina: 'met',
  empagliflozina: 'isglt2', dapagliflozina: 'isglt2', canagliflozina: 'isglt2', ertugliflozina: 'isglt2',
  semaglutida: 'arglp', dulaglutida: 'arglp', liraglutida: 'arglp', exenatida: 'arglp',
  tirzepatida: 'argip',
  sitagliptina: 'idpp4', linagliptina: 'idpp4', vildagliptina: 'idpp4', saxagliptina: 'idpp4',
  glimepirida: 'su', gliclazida: 'su', repaglinida: 'su', pioglitazona: 'pio',
  insulinaBasal: 'ins', insulinaPrandial: 'ins'
};

function hasClass(cls) {
  return Object.entries(state.drugs).some(([k,v]) => v && DRUG_CLASS[k] === cls);
}

function getConditioner() {
  if (state.ic) return { id: 'ic', name: 'Insuficiencia cardíaca', meta: 'iSGLT-2 (con o sin Met) → arGLP-1 o arGIP-GLP-1' };
  if (state.ecv || state.rcvAlto) {
    const label = state.ecv ? 'ECV establecida' : 'RCV elevado';
    return { id: 'ecv', name: label, meta: 'Metformina + (iSGLT-2 o arGLP-1 o arGIP-GLP-1)' };
  }
  if (state.erc) return { id: 'erc', name: 'Enfermedad renal crónica', meta: 'iSGLT-2 (si FGe ≥20) → arGLP-1 (preferible semaglutida)' };
  if (state.obesidad) return { id: 'obesidad', name: 'Obesidad', meta: 'arGIP-GLP-1 o arGLP-1 + Met → iSGLT-2' };
  if (state.hepatica) return { id: 'hepatica', name: 'Enfermedad hepática metabólica', meta: 'arGIP-GLP-1 o arGLP-1 → iSGLT-2 o Pioglitazona' };
  if (state.fragilidad) {
    return { id: 'fragilidad', name: 'Fragilidad · ' + state.fragGrade, meta: 'iDPP-4 → +Met → insulina + Met (evitar Sulfonilureas)' };
  }
  return { id: null, name: 'Ninguno', meta: 'Algoritmo guiado por HbA1c y clínica cardinal' };
}

function getTarget() {
  const sinComplicaciones = !state.ic && !state.ecv && !state.erc && !state.hepatica && !state.rcvAlto;

  if (state.fragilidad && state.fragGrade === 'muyGrave') {
    return { target: null, label: 'Evitar síntomas', rationale: 'Fragilidad muy grave o esperanza de vida limitada. No hay objetivo numérico; se prioriza evitar síntomas hiper/hipoglucémicos.', upperBound: 9.0 };
  }
  if (state.deterioro || (state.fragilidad && (state.fragGrade === 'grave' || state.fragGrade === 'moderada'))) {
    return { target: 8.5, label: '7,5 - 8,5 %', rationale: 'Fragilidad moderada-grave (deterioro cognitivo/funcional). Especial precaución ante hipoglucemias.', upperBound: 8.5 };
  }
  if (!state.fragilidad && sinComplicaciones && (state.dxReciente || (state.tiempoDx <= 10 && state.edad <= 75))) {
    return { target: 6.5, label: '< 6,5 %', rationale: 'Paciente joven o <10 años de evolución sin complicaciones: objetivo estricto (memoria metabólica).', upperBound: 6.5 };
  }
  if (!state.fragilidad && sinComplicaciones && (state.tiempoDx > 10 || state.edad > 75)) {
    return { target: 7.0, label: '≤ 7,0 %', rationale: 'Paciente de larga evolución o > 75 años sin complicaciones.', upperBound: 7.0 };
  }
  return { target: 7.0, label: '< 7,0 %', rationale: 'Objetivo individualizado general por presencia de comorbilidad establecida.', upperBound: 7.0 };
}

function generateRecs(cond, target) {
  const recs = [];
  const trace = [];
  let conditionHandledIntensification = false;

  trace.push(`Evaluación: HbA1c actual de ${state.hba1c.toFixed(1)} % frente a objetivo de ${target.label}`);

  if (state.drugs.metformina && state.fge < 30) {
    recs.push({ type: 'danger', tag: 'Contraindicación', title: 'Se recomienda suspender Metformina', body: `El paciente presenta un FGe de <strong>${state.fge} mL/min</strong>. La <strong>Metformina</strong> está formalmente contraindicada por debajo de 30 mL/min.` });
    trace.push('FGe <30: Retirada de metformina obligatoria.');
  } else if (state.drugs.metformina && state.fge < 45) {
    recs.push({ type: 'warn', tag: 'Ajuste de dosis', title: 'Se recomienda reducir dosis de Metformina', body: `Con un FGe entre 30 y 45 mL/min, reducir dosis de <strong>Metformina</strong> al 50%.` });
  }

  if (hasClass('isglt2') && state.fge < 20) {
    recs.push({ type: 'danger', tag: 'Reevaluar', title: 'Atención al uso de iSGLT-2 con FGe < 20', body: `Los <strong>iSGLT-2</strong> no se recomiendan iniciar con FGe < 20. Debe reevaluarse su continuidad.` });
  }

  if (hasClass('idpp4') && (hasClass('arglp') || hasClass('argip'))) {
    recs.push({ type: 'danger', tag: 'Asociación no sinérgica', title: 'Se recomienda retirar iDPP-4', body: `Incompatibilidad: Suspender iDPP-4 al estar pautado un análogo inyectable (arGLP-1 o arGIP-GLP1) ya que carecen de sinergia al compartir mecanismo.` });
  }

  if (state.sintomatico && state.hba1c >= 8.5) {
    recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina + Metformina', body: `Ante clínica cardinal grave con HbA1c ≥ 8,5 %, iniciar inmediato de <strong>insulina combinada con Metformina</strong> para frenar glucotoxicidad.` });
    trace.push('Descompensación grave sintomática: Insulinización de rescate.');
    conditionHandledIntensification = true; 
  } else if (state.sintomatico) {
    recs.push({ type: 'warn', tag: 'Clínica', title: 'Se recomienda investigar desencadenante', body: `Investigar desencadenantes activos (corticoesteroides, infecciones) y valorar apoyo insulínico temporal.` });
  }

  if (cond.id === 'ic') { conditionHandledIntensification = handleIC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'ecv') { conditionHandledIntensification = handleECV(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'erc') { conditionHandledIntensification = handleERC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'obesidad') { conditionHandledIntensification = handleObesidad(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'hepatica') { conditionHandledIntensification = handleHepatica(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'fragilidad') { conditionHandledIntensification = handleFragilidad(recs, trace, target) || conditionHandledIntensification; }

  if (cond.id === null) {
      applyGeneralIntensification(recs, trace, target);
  } else if (state.hba1c > target.upperBound && !conditionHandledIntensification && cond.id !== 'fragilidad' && !state.sintomatico) {
      trace.push('Fármacos del condicionante optimizados pero paciente fuera de objetivo -> Activando intensificación algorítmica.');
      applyGeneralIntensification(recs, trace, target);
  }

  const inTarget = state.hba1c <= target.upperBound;
  const needsAction = recs.some(r => r.type === 'add' || r.type === 'warn' || r.type === 'danger');

  if (!needsAction && target.target !== null && inTarget) {
    recs.push({
      type: 'ok', tag: 'Paciente Optimizado', title: 'El tratamiento está optimizado',
      body: `El paciente ha alcanzado su objetivo glucémico y cuenta con las familias farmacológicas recomendadas para su perfil. Mantener esquema y control semestral.`
    });
  } else if (state.hba1c > target.upperBound && target.target !== null && recs.some(r => r.type === 'add')) {
    recs.push({
      type: 'warn', tag: 'Seguimiento', title: 'Se recomienda reevaluar a los 3 meses',
      body: `Al no alcanzar el objetivo y tras añadir/modificar el tratamiento, se recomienda un control de HbA1c a los 3 meses para evitar inercia clínica y confirmar eficacia del nuevo fármaco.`
    });
  }

  return { recs, trace };
}

function handleIC(recs, trace, target) {
  let intensified = false;
  if (!hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar un iSGLT-2', body: `De elección por reducción de mortalidad e ingresos por IC.` });
    intensified = true;
  }
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Combinar', title: 'Se recomienda asociar Metformina', body: `Para optimizar control.` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && hasClass('isglt2') && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: 'Si insuficiente', title: 'Se recomienda añadir arGLP-1 o arGIP/GLP-1', body: `Añadir incretínicos por beneficio demostrado en ensayos recientes en IC.` });
    intensified = true;
  }
  return intensified;
}

function handleECV(recs, trace, target) {
  let intensified = false;
  if (!state.drugs.metformina && state.fge >= 30) {
    recs.push({ type: 'add', tag: 'Añadir base', title: 'Se recomienda prescribir Metformina', body: `Base combinada si la función renal lo permite.` });
  }
  const tieneCardio = hasClass('isglt2') || hasClass('arglp') || hasClass('argip');
  if (!tieneCardio) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda terapia combinada temprana', body: `Prescribir Metformina + (iSGLT-2 o arGLP-1 o arGIP/GLP-1) independientemente del nivel de HbA1c.` });
    intensified = true;
  } else if (state.hba1c > target.upperBound && !(hasClass('isglt2') && (hasClass('arglp') || hasClass('argip')))) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda sumar una segunda familia cardioprotectora', body: `Combinar iSGLT-2 con arGLP-1/arGIP-GLP-1 para maximizar pronóstico y alcanzar objetivo.` });
    intensified = true;
  }
  return intensified;
}

function handleERC(recs, trace, target) {
  let intensified = false;
  if (state.fge >= 20 && !hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar iSGLT-2', body: `Prioritario para reducir progresión renal y eventos CV.` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: '2ª línea', title: 'Se recomienda añadir arGLP-1', body: `Especialmente semaglutida (estudio FLOW) para protección renal añadida.` });
    intensified = true;
  }
  return intensified;
}

function handleObesidad(recs, trace, target) {
  let intensified = false;
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  if (!tieneIncretina) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar arGLP-1 o arGIP/GLP-1', body: `Prioritario para pérdida de peso agresiva (10-20%).` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && tieneIncretina && !hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda asociar un iSGLT-2', body: `Añadir como escalón de apoyo para control glucémico.` });
    intensified = true;
  }
  if (state.imc >= 35) {
    recs.push({ type: 'info', tag: 'Estilo de vida', title: 'Abordaje integral de la obesidad', body: `Evaluar derivación a cirugía bariátrica si IMC ≥ 35.` });
  }
  return intensified;
}

function handleHepatica(recs, trace, target) {
  let intensified = false;
  if (!hasClass('arglp') && !hasClass('argip')) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda arGLP-1 o arGIP/GLP-1', body: `Demostrados beneficios histológicos (reducción esteatohepatitis).` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && !hasClass('isglt2') && !state.drugs.pioglitazona) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda añadir iSGLT-2 o Pioglitazona', body: `Para mejorar control y sensibilidad a la insulina.` });
    intensified = true;
  }
  return intensified;
}

function handleFragilidad(recs, trace, target) {
  if (hasClass('su') && state.fragGrade !== 'leve') {
    recs.push({ type: 'danger', tag: 'Desintensificar', title: 'Retirar activamente las Sulfonilureas', body: `Riesgo inaceptable de hipoglucemias. Retirar de la pauta.` });
  }
  if (!hasClass('idpp4') && !hasClass('arglp') && !hasClass('argip') && state.fragGrade !== 'muyGrave') {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda el uso de iDPP-4', body: `Primera línea por tolerabilidad y nulo riesgo de hipoglucemia.` });
  }
  if (state.fragGrade === 'muyGrave') {
    recs.push({ type: 'warn', tag: 'Final de vida', title: 'Se recomienda desintensificación estructurada', body: `Suspender tratamientos a largo plazo. Mantener regímenes simples.` });
  }
  return true; 
}

// LÓGICA DE INTENSIFICACIÓN CIRCULAR (CORREGIDA)
function applyGeneralIntensification(recs, trace, target) {
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;

  if (state.hba1c >= 8.5) {
    if (clasesUsadas <= 1) {
      recs.push({ type: 'add', tag: 'Intensificación inmediata', title: 'Se recomienda instaurar Doble Terapia', body: `Al presentar HbA1c ≥ 8,5 %, las guías dictan romper la inercia clínica e iniciar tratamiento añadiendo directamente un segundo fármaco potente (iSGLT-2 o arGLP-1/arGIP-GLP-1) a la base.` });
      trace.push(`Intensificación: HbA1c ≥ 8.5, salto a doble terapia.`);
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Triple terapia', title: 'Se recomienda progresar a Triple Terapia', body: `La doble terapia es insuficiente ante una HbA1c ≥ 8,5 %. Se recomienda añadir un tercer ADNI que complemente la fisiopatología, valorando el perfil del paciente (riesgo hipoglucemia, comorbilidades).` });
      trace.push(`Intensificación: HbA1c ≥ 8.5, salto a triple terapia.`);
    } else {
      recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda valorar un 4º ADNI o paso a Insulina Basal', body: `El paciente presenta un control muy deficiente (${state.hba1c.toFixed(1)} %) a pesar de tomar ${clasesUsadas} fármacos. El algoritmo permite intentar el rescate <strong>añadiendo un 4º ADNI</strong> (ej. Pioglitazona o SU, si no hay contraindicaciones y se quiere evitar inyectables), pero si la distancia al objetivo es enorme o se sospecha fracaso de célula beta, <strong>la Insulinización Basal es mandatoria y más eficaz.</strong>` });
      trace.push(`Fracaso a 3+ fármacos: Se habilita opción de 4º ADNI o Insulina Basal según preferencia y reserva pancreática.`);
    }
  } else if (state.hba1c > target.upperBound) {
    if (clasesUsadas <= 1) {
      recs.push({ type: 'add', tag: 'Doble terapia', title: 'Se recomienda asociar un segundo fármaco', body: `Para alcanzar el objetivo, se recomienda asociar un segundo fármaco (priorizar iSGLT-2 o arGLP-1).` });
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Triple terapia', title: 'Se recomienda instaurar Triple Terapia', body: `No se alcanza el objetivo con doble terapia. Está indicado añadir una tercera familia farmacológica oral o inyectable (ADNI), vigilando interacciones.` });
    } else {
      recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda añadir un 4º ADNI o iniciar Insulina Basal', body: `Al no conseguir llevar al paciente a objetivo tras emplear combinaciones de ${clasesUsadas} fármacos, el algoritmo indica moverse al centro del esquema: se puede intentar <strong>añadir un cuarto fármaco oral/incretina (4º ADNI)</strong> siempre que sea clínica y farmacológicamente compatible, o bien dar el paso directamente a <strong>Insulinización Basal</strong>.` });
      trace.push(`Intensificación progresiva: Fracaso a 3 fármacos -> Ofrecer 4º ADNI o Insulina.`);
    }
  }
}

/* =================================================================
   RENDER Y CONTROL DE INTERFAZ
   ================================================================= */
function renderCurrentDrugs() {
  const el = document.getElementById('currentDrugs');
  const active = Object.entries(state.drugs).filter(([k,v]) => v).map(([k]) => k);
  if (active.length === 0) { el.innerHTML = '<span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado</span>'; return; }
  el.innerHTML = active.map(d => `<span class="drug-pill current">${DRUG_LABELS[d]}</span>`).join('');
}

function renderRecs(recs) {
  const el = document.getElementById('recommendations');
  if (recs.length === 0) { el.innerHTML = '<div class="empty-state">No se pudieron generar recomendaciones.</div>'; return; }
  el.innerHTML = recs.map(r => `
    <div class="rec-card ${r.type}">
      <div class="rec-card-tag">${r.tag}</div>
      <div class="rec-card-title">${r.title}</div>
      <div class="rec-card-body">${r.body}</div>
    </div>
  `).join('');
}

function renderTrace(trace) {
  document.getElementById('trace').innerHTML = trace.map(t => `<li>${t}</li>`).join('');
}

function update() {
  state.hba1c = parseFloat(document.getElementById('hba1c').value);
  state.edad = parseInt(document.getElementById('edad').value) || 0;
  state.tiempoDx = parseFloat(document.getElementById('tiempoDx').value) || 0;
  state.fge = parseFloat(document.getElementById('fge').value) || 0;
  state.sintomatico = document.getElementById('sintomatico').checked;
  state.dxReciente = document.getElementById('dxReciente').checked;
  state.ic = document.getElementById('ic').checked;
  state.ecv = document.getElementById('ecv').checked;
  state.rcvAlto = document.getElementById('rcvAlto').checked;
  state.erc = document.getElementById('erc').checked;
  state.obesidad = document.getElementById('obesidad').checked;
  state.hepatica = document.getElementById('hepatica').checked;
  state.fragilidad = document.getElementById('fragilidad').checked;
  state.deterioro = document.getElementById('deterioro').checked;

  const fragRadio = document.querySelector('input[name="fragGrade"]:checked');
  state.fragGrade = fragRadio ? fragRadio.value : 'leve';

  state.drugs = {};
  document.querySelectorAll('[data-drug]').forEach(cb => { state.drugs[cb.dataset.drug] = cb.checked; });

  if (state.deterioro) {
      state.fragilidad = true; document.getElementById('fragilidad').checked = true;
      if (state.fragGrade === 'leve') { state.fragGrade = 'moderada'; document.querySelector('input[name="fragGrade"][value="moderada"]').checked = true; }
  }

  document.getElementById('hbValue').textContent = state.hba1c.toFixed(1);
  const gme = Math.round(28.7 * state.hba1c - 46.7);
  document.getElementById('gme').textContent = gme;

  document.getElementById('fragilidadGrade').classList.toggle('active', state.fragilidad);
  document.querySelectorAll('.check').forEach(c => { const id = c.dataset.check; if (id) c.classList.toggle('checked', state[id] === true); });
  document.querySelectorAll('.radio-pill').forEach(p => { const input = p.querySelector('input'); p.classList.toggle('selected', input.checked); });
  document.querySelectorAll('.drug-class').forEach(dc => { const cls = dc.dataset.drugclass; dc.classList.toggle('has-active', hasClass(cls)); });

  const cond = getConditioner();
  const target = getTarget();
  const { recs, trace } = generateRecs(cond, target);

  const tv = document.getElementById('targetValue');
  if (target.target === null) { tv.textContent = 'Sin objetivo'; tv.classList.add('muted'); } 
  else { tv.textContent = target.label; tv.classList.remove('muted'); }

  document.getElementById('targetRationale').textContent = target.rationale;

  const status = document.getElementById('targetStatus');
  if (target.target === null) { status.className = 'target-status warn'; status.textContent = 'Sin objetivo numérico'; } 
  else if (state.hba1c <= target.upperBound) { status.className = 'target-status ok'; status.textContent = 'En objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else if (state.hba1c <= target.upperBound + 0.2) { status.className = 'target-status warn'; status.textContent = 'Al límite o levemente sobre el objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else { status.className = 'target-status no'; status.textContent = 'Lejos del objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; }

  document.getElementById('conditionerName').textContent = cond.name;
  document.getElementById('conditionerMeta').textContent = cond.meta;

  renderCurrentDrugs(); renderRecs(recs); renderTrace(trace);
}

function resetAll() {
  document.getElementById('hba1c').value = 7.5;
  document.getElementById('edad').value = 65;
  document.getElementById('tiempoDx').value = 5;
  document.getElementById('fge').value = 80;
  document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
  const fragLeve = document.querySelector('input[name="fragGrade"][value="leve"]');
  if (fragLeve) fragLeve.checked = true;
  update();
}

document.querySelectorAll('input, select').forEach(el => { el.addEventListener('input', update); el.addEventListener('change', update); });
update();
</script>

