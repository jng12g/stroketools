<script>
/* =================================================================
   Algoritmo redGDPS 2026 y ADA - Lógica clínica estructurada y razonada
   ================================================================= */

const state = {
  hba1c: 7.5, edad: 65, tiempoDx: 5, fge: 80,
  uacr: 'normal', potasio: 4.5, ras: true,
  sintomatico: false, cirrosis: false, ic: false, 
  ictus: false, ecvCoronaria: false, rcvAlto: false,
  erc: false, obesidad: false, hepatica: false, fragilidad: false, fragGrade: 'moderadaGrave', deterioro: false,
  drugs: {}
};

const DRUG_LABELS = {
  metformina: 'Metformina', empagliflozina: 'Empagliflozina', dapagliflozina: 'Dapagliflozina', canagliflozina: 'Canagliflozina', ertugliflozina: 'Ertugliflozina',
  semaglutida: 'Semaglutida', dulaglutida: 'Dulaglutida', liraglutida: 'Liraglutida', exenatida: 'Exenatida', tirzepatida: 'Tirzepatida',
  sitagliptina: 'Sitagliptina', linagliptina: 'Linagliptina', vildagliptina: 'Vildagliptina', saxagliptina: 'Saxagliptina',
  glimepirida: 'Glimepirida', gliclazida: 'Gliclazida', repaglinida: 'Repaglinida', pioglitazona: 'Pioglitazona',
  insulinaBasal: 'Insulina basal', insulinaPrandial: 'Insulina prandial', finerenona: 'Finerenona'
};

const DRUG_CLASS = {
  metformina: 'met',
  empagliflozina: 'isglt2', dapagliflozina: 'isglt2', canagliflozina: 'isglt2', ertugliflozina: 'isglt2',
  semaglutida: 'arglp', dulaglutida: 'arglp', liraglutida: 'arglp', exenatida: 'arglp',
  tirzepatida: 'argip',
  sitagliptina: 'idpp4', linagliptina: 'idpp4', vildagliptina: 'idpp4', saxagliptina: 'idpp4',
  glimepirida: 'su', gliclazida: 'su', repaglinida: 'glinida', pioglitazona: 'pio',
  insulinaBasal: 'ins', insulinaPrandial: 'ins', finerenona: 'arm'
};

function hasClass(cls) { return Object.entries(state.drugs).some(([k,v]) => v && DRUG_CLASS[k] === cls); }

function drugsInClass(cls) {
  return Object.entries(state.drugs).filter(([k,v]) => v && DRUG_CLASS[k] === cls).map(([k]) => k);
}

function getConditioner() {
  if (state.cirrosis) return { id: 'cirrosis', name: 'Cirrosis / Insuficiencia Hepática Grave', meta: 'Manejo altamente especializado. Fármacos seguros: Insulina o Linagliptina.' };
  
  // Novedad: La fragilidad se sitúa en la cima clínica. Modifica radicalmente el esquema.
  if (state.fragilidad) {
    const nameFrag = state.fragGrade === 'muyGrave' ? 'Muy grave / Vida limitada' : 'Moderada - Grave';
    return { id: 'fragilidad', name: 'Fragilidad: ' + nameFrag, meta: 'Prioridad: Calidad de vida, evitar hipoglucemias y desprescribir fármacos de riesgo.' };
  }
  
  if (state.ictus) return { id: 'ictus', name: 'Enfermedad Cerebrovascular (Ictus / AIT)', meta: 'Prevención secundaria: arGLP-1 preferente (o Pioglitazona)' };
  if (state.ecvCoronaria || state.rcvAlto) { const label = state.ecvCoronaria ? 'ECV Coronaria / Periférica' : 'RCV elevado'; return { id: 'ecvCoronaria', name: label, meta: 'iSGLT-2 o arGLP-1 o arGIP-GLP-1 (con o sin Metformina)' }; }
  if (state.ic) return { id: 'ic', name: 'Insuficiencia cardíaca', meta: 'iSGLT-2 (con o sin Met) → arGLP-1 o arGIP-GLP-1' };
  if (state.erc) return { id: 'erc', name: 'Enfermedad renal crónica', meta: 'iSGLT-2 (si FGe ≥20) → arGLP-1 (preferible semaglutida)' };
  if (state.obesidad) return { id: 'obesidad', name: 'Obesidad', meta: 'Manejo del peso y glucemia (GLP-1 preferentes o Metformina)' };
  if (state.hepatica) return { id: 'hepatica', name: 'Enfermedad hepática metabólica', meta: 'arGIP-GLP-1 o arGLP-1 → iSGLT-2 o Pioglitazona' };
  
  return { id: null, name: 'Ninguno', meta: 'Algoritmo guiado por HbA1c y clínica cardinal' };
}

function getTarget() {
  const sinComplicaciones = !state.ic && !state.ecvCoronaria && !state.ictus && !state.erc && !state.hepatica && !state.rcvAlto && !state.cirrosis;
  
  if (state.fragilidad && state.fragGrade === 'muyGrave') {
    return { target: null, label: 'Evitar síntomas', rationale: 'Fragilidad muy grave o esperanza de vida limitada. No hay objetivo numérico; se prioriza evitar síntomas hiper/hipoglucémicos.', upperBound: 9.0 };
  }
  if (state.deterioro || (state.fragilidad && state.fragGrade === 'moderadaGrave')) {
    return { target: 8.5, label: '7,5 - 8,5 %', rationale: 'Fragilidad moderada-grave (deterioro cognitivo/funcional). Especial precaución ante hipoglucemias.', upperBound: 8.5 };
  }
  
  if (!state.fragilidad && sinComplicaciones) {
    if (state.edad <= 40 && state.tiempoDx <= 5) {
        return { target: 6.5, label: '≤ 6,5 %', rationale: 'Adulto joven (≤ 40 años) con diagnóstico reciente (≤ 5 años) y sin comorbilidades: objetivo estricto.', upperBound: 6.5 };
    } else if (state.edad > 40 && state.edad <= 65) {
        return { target: 7.0, label: '≤ 7,0 %', rationale: 'Adulto (40-65 años) sin comorbilidades. Objetivo estándar equilibrando el riesgo de hipoglucemia.', upperBound: 7.0 };
    } else if (state.edad > 65) {
         if (state.tiempoDx > 10) {
             return { target: 8.0, label: '7,0 - 8,0 %', rationale: 'Adulto mayor (> 65 años) con diabetes de larga evolución. Se prioriza evitar la hipoglucemia.', upperBound: 8.0 };
         } else {
             return { target: 7.5, label: '≤ 7,5 %', rationale: 'Adulto mayor (> 65 años) con buen estado funcional. Equilibrio entre beneficio y riesgo.', upperBound: 7.5 };
         }
    }
  }

  return { target: 7.0, label: '< 7,0 %', rationale: 'Objetivo individualizado general por presencia de comorbilidad o patología orgánica establecida.', upperBound: 7.0 };
}

function getFarmacoPrioritario(condId) {
  switch(condId) {
    case 'cirrosis': return 'iDPP-4 (Linagliptina) o Insulina';
    case 'ictus': return 'arGLP-1 (o Pioglitazona)';
    case 'ecvCoronaria': return 'iSGLT-2, arGLP-1 o arGIP/GLP-1';
    case 'ic': return 'iSGLT-2 (y/o arGLP-1 si hay obesidad asociada)';
    case 'erc': return 'iSGLT-2 (o arGLP-1 preferiblemente semaglutida)';
    case 'obesidad': return 'arGLP-1 o arGIP/GLP-1';
    case 'hepatica': return 'Semaglutida';
    case 'fragilidad': return 'iDPP-4 (por su alto perfil de seguridad geriátrica)';
    default: return 'un segundo fármaco de muy alta eficacia (ej. arGLP-1, arGIP o iSGLT-2)';
  }
}

function getAvailableADNIs(state) {
  let options = [];
  const hasGLP = hasClass('arglp') || hasClass('argip');
  const hasDPP4 = hasClass('idpp4');
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio'].filter(c => hasClass(c)).length;

  if (state.cirrosis) {
     if (!hasDPP4) options.push('<strong>iDPP-4</strong> (específicamente Linagliptina por su excreción biliar).');
     return options;
  }

  if (!hasClass('met') && state.fge >= 30) options.push('<strong>Metformina</strong> (base del tratamiento, económica y probada).');
  if (!hasClass('isglt2') && state.fge >= 20) options.push('<strong>iSGLT-2</strong> (ej. Empagliflozina, Dapagliflozina o Canagliflozina).');
  
  if (!hasGLP) options.push('<strong>arGLP-1 / arGIP</strong> (Semaglutida y Dulaglutida son seguros incluso en diálisis; evitar exenatida/lixisenatida si FG ≤ 30).');
  if (!hasDPP4 && !hasGLP) options.push('<strong>iDPP-4</strong>: Fármacos neutros en peso y extremadamente seguros (primera línea en fragilidad y FG terminal).');
  if (!hasClass('pio') && !state.ic) options.push('<strong>Pioglitazona</strong>: Mejora la resistencia a la insulina.');
  
  if (!hasClass('su') && !hasClass('glinida') && !state.fragilidad && state.fge >= 15) {
    if (clasesUsadas >= 2) {
      options.push('<strong>Sulfonilureas</strong>: Útiles solo como 3er o 4º ADNI. <em>Gliclazida o Glimepirida son las de elección.</em>');
    }
  }
  if (!hasClass('su') && !hasClass('glinida') && state.fge < 15 && !state.fragilidad) {
      options.push('<strong>Repaglinida</strong>: Útil como excepción por el bajo filtrado glomerular (FG < 15 ml/min).');
  }

  return options;
}

function detectIncompatibilities(recs, trace) {
  let incomp = false;

  const classesToCheck = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio', 'arm'];
  classesToCheck.forEach(cls => {
    const selectedInClass = drugsInClass(cls);
    if (selectedInClass.length > 1) {
      const drugNames = selectedInClass.map(d => DRUG_LABELS[d]).join(' y ');
      recs.push({
        type: 'danger', tag: 'Duplicidad Terapéutica', title: 'Asociación Incompatible por misma familia',
        body: `Se ha detectado el uso simultáneo de <strong>${drugNames}</strong>. Estos fármacos pertenecen a la misma familia terapéutica. Su combinación no aporta beneficio clínico adicional, es completamente redundante y aumenta el riesgo de efectos secundarios. <strong>Se debe suspender de inmediato uno de ellos</strong>.`
      });
      trace.push(`Incompatibilidad detectada: Duplicidad en la familia ${cls} (${drugNames}).`);
      incomp = true;
    }
  });

  if (hasClass('su') && hasClass('glinida')) {
    recs.push({ type: 'danger', tag: 'Asociación No Recomendada', title: 'Solapamiento de mecanismo secretagogo', body: `El paciente toma conjuntamente una <strong>Sulfonilurea</strong> y una <strong>Glinida (Repaglinida)</strong>. Esta asociación está explícitamente desaconsejada ya que ambas comparten mecanismo de acción (estimulan secreción de insulina), incrementando gravemente el riesgo de hipoglucemia sin beneficio adicional.` });
    trace.push('Incompatibilidad detectada: Uso concurrente de SU y Glinida.');
    incomp = true;
  }

  if (state.drugs.exenatida && state.fge <= 30) {
    recs.push({ type: 'danger', tag: 'Contraindicación Renal', title: 'Suspender Exenatida / Lixisenatida', body: `Estos agonistas de GLP-1 requieren eliminación renal y deben evitarse en personas con FGe ≤ 30 ml/min. <strong>Se deben suspender y transicionar a otro arGLP-1 seguro</strong> (ej. semaglutida o dulaglutida).` });
    trace.push('Contraindicación detectada: Exenatida/Lixisenatida con FG <= 30.');
    incomp = true;
  }

  if (state.cirrosis) {
      if (state.drugs.metformina) {
          recs.push({ type: 'danger', tag: 'Contraindicación Absoluta', title: 'Suspender Metformina Inmediatamente', body: `En presencia de cirrosis o insuficiencia hepática grave (Child-Pugh B/C), la Metformina está formalmente contraindicada por el alto riesgo de acidosis láctica fatal.` });
          incomp = true;
      }
      if (state.drugs.pioglitazona) {
          recs.push({ type: 'danger', tag: 'Contraindicación Absoluta', title: 'Suspender Pioglitazona', body: `La Pioglitazona presenta riesgo de hepatotoxicidad y está formalmente contraindicada en insuficiencia hepática activa.` });
          incomp = true;
      }
      if (hasClass('su') || hasClass('glinida')) {
          recs.push({ type: 'danger', tag: 'Contraindicación Absoluta', title: 'Suspender Secretagogos (SU/Glinidas)', body: `La insuficiencia hepática grave altera el aclaramiento de estos fármacos y reduce la gluconeogénesis, provocando un riesgo inaceptable de hipoglucemias severas y prolongadas.` });
          incomp = true;
      }
  }

  if (state.fge < 30 && !state.cirrosis) {
      recs.push({
          type: 'danger', tag: 'Alerta Renal Crítica', title: 'FGe < 30 ml/min: Manejo Especializado',
          body: `El paciente presenta un Filtrado Glomerular inferior a 30 ml/min. La prescripción farmacológica automática está restringida. <strong>El manejo de este paciente debe ser consensuado y monitorizado conjuntamente con el servicio de Nefrología.</strong>`
      });
      trace.push('Bloqueo de seguridad: FGe < 30 ml/min. Alerta de Nefrología activada.');
  }

  if (state.fge < 15 && !state.cirrosis) {
      recs.push({
          type: 'info', tag: 'Nefropatía Terminal', title: 'FGe < 15 ml/min: Opciones preferentes',
          body: `El paciente presenta un filtrado glomerular severamente reducido (< 15 ml/min). En este estadio pre-diálisis o diálisis, las terapias antidiabéticas recomendadas son: <strong>iDPP-4</strong> (ajustando dosis según ficha técnica), <strong>Repaglinida</strong>, <strong>arGLP-1</strong> (excepto exenatida/lixisenatida), <strong>Pioglitazona</strong> o <strong>Insulina</strong>.`
      });
      trace.push('FGe < 15 ml/min: Opciones limitadas a iDPP-4, Repaglinida, arGLP-1 seguros, Pioglitazona o Insulina.');
  }

  if (state.drugs.metformina && state.fge < 30 && !state.cirrosis) {
    recs.push({ type: 'danger', tag: 'Contraindicación Absoluta', title: 'Suspender Metformina Inmediatamente', body: `El paciente presenta un Filtrado Glomerular (FGe) de <strong>${state.fge} mL/min</strong>. A estos niveles, la Metformina está formalmente contraindicada por el riesgo severo de acidosis láctica. Se sugiere sustituir la base de tratamiento por fármacos seguros en ERC avanzada.` });
    trace.push('FGe <30: Retirada de metformina obligatoria.');
    incomp = true;
  } else if (state.drugs.metformina && state.fge < 45) {
    recs.push({ type: 'warn', tag: 'Ajuste de dosis', title: 'Se recomienda reducir la dosis de Metformina', body: `Con un FGe de ${state.fge} mL/min (en el rango 30-45), la Metformina exige precaución extrema. Se debe reducir obligatoriamente su dosis al 50% de la máxima tolerada previamente.` });
  }

  if (hasClass('isglt2') && state.fge < 20) {
    recs.push({ 
      type: 'ok', tag: 'Mantenimiento Seguro', title: 'Continuar iSGLT-2 (FGe < 20)', 
      body: `La ADA 2026 confirma explícitamente la seguridad y el beneficio renal de los iSGLT-2 en la ERC avanzada. Pueden y deben mantenerse de forma segura incluso con FG < 20 mL/min/1.73 m², <strong>siempre y cuando el paciente no requiera terapia de diálisis.</strong>` 
    });
    trace.push('FGe < 20: Se valida el mantenimiento del iSGLT-2 activo según ADA 2026.');
  }

  if (state.drugs.pioglitazona && state.ic) {
    recs.push({ type: 'danger', tag: 'Contraindicación', title: 'Se recomienda suspender la Pioglitazona', body: `La <strong>Pioglitazona</strong> está contraindicada en Insuficiencia Cardíaca. Este fármaco produce retención hidrosalina y aumenta el riesgo de exacerbación. Se sugiere cambiar a un <strong>iSGLT-2</strong>.` });
    trace.push('Pioglitazona + IC: Incompatibilidad crítica.');
    incomp = true;
  }

  if (hasClass('idpp4') && (hasClass('arglp') || hasClass('argip'))) {
    recs.push({ type: 'danger', tag: 'Incompatibilidad Farmacodinámica', title: 'Se recomienda suspender el iDPP-4', body: `El paciente toma un <strong>iDPP-4</strong> simultáneamente con un análogo incretínico inyectable (<strong>arGLP-1 o arGIP/GLP-1</strong>). Su combinación carece de sinergia glucémica y es redundante. <strong>Sugerencia:</strong> Mantenga el inyectable y retire el iDPP-4 de la pauta.` });
    trace.push('Incompatibilidad: Solapamiento incretínico iDPP-4 + análogos inyectables.');
    incomp = true;
  }

  if (hasClass('arglp') && hasClass('argip')) {
    recs.push({ type: 'danger', tag: 'Incompatibilidad', title: 'Asociación Incompatible de Inyectables', body: `No se deben prescribir simultáneamente un <strong>arGLP-1</strong> y un <strong>arGIP/GLP-1</strong> (Tirzepatida). Son moléculas de la misma clase basal y su uso combinado es erróneo.` });
    incomp = true;
  }

  if ((hasClass('su') || hasClass('glinida')) && !state.fragilidad && !state.cirrosis) {
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio'].filter(c => hasClass(c)).length;
    if (clasesUsadas < 3 && state.fge >= 15 && hasClass('su')) {
      recs.push({
        type: 'warn', tag: 'Uso Prematuro', title: 'Sulfonilureas relegadas a 3º o 4º escalón',
        body: `El algoritmo no recomienda el uso de <strong>Sulfonilureas</strong> como monoterapia o doble terapia. Se han relegado a situaciones donde se precise un 3º o 4º fármaco tras fracasar otras familias con beneficios cardiorenales y menor riesgo de hipoglucemias.`
      });
      trace.push('Aviso: Uso prematuro de SU en 1ª o 2ª línea detectado.');
    }
  }
  return incomp;
}

function renderOptimizedState(cond, state, target) {
    let justificacion = `El paciente ha alcanzado su objetivo glucémico individualizado (<strong>${state.hba1c.toFixed(1)} %</strong> para una meta de <strong>${target.label}</strong>). El esquema glucémico se considera idóneo y optimizado por los siguientes motivos clínicos:<br><ul>`;

    if (cond.id === 'cirrosis') {
      justificacion += `<li><strong>Seguridad Hepática (Cirrosis):</strong> El paciente mantiene un control adecuado apoyándose en terapias de alta seguridad metabólica en contexto de insuficiencia hepática grave.</li>`;
    } else if (cond.id === 'fragilidad') {
      justificacion += `<li><strong>Seguridad Geriátrica:</strong> En base a su grado de fragilidad, la prioridad se ha cumplido: preservar la calidad de vida, seguridad sistémica y evitar activamente las hipoglucemias.</li>`;
    } else if (cond.id === 'ictus') {
      justificacion += `<li><strong>Protección Cerebrovascular:</strong> Al presentar ictus/AIT previo, el esquema integra terapias de alta eficacia si fuera preciso, y controla la glucemia sin añadir riesgos.</li>`;
    } else if (cond.id === 'ecvCoronaria') {
      justificacion += `<li><strong>Protección Cardiovascular:</strong> Al presentar alto riesgo o evento coronario/periférico, el esquema ya integra terapias cardioprotectoras que disminuyen los eventos adversos.</li>`;
    } else if (cond.id === 'ic') {
      justificacion += `<li><strong>Beneficio Pronóstico (IC):</strong> El paciente está recibiendo tratamiento que reduce drásticamente las hospitalizaciones por insuficiencia cardíaca y la mortalidad CV.</li>`;
    } else if (cond.id === 'erc') {
      justificacion += `<li><strong>Nefroprotección:</strong> El régimen incluye fármacos de primera línea para la enfermedad renal, que ralentizan significativamente la progresión a nefropatía terminal.</li>`;
    } else if (cond.id === 'obesidad') {
      justificacion += `<li><strong>Control Ponderal Activo:</strong> Teniendo obesidad como condicionante principal, el esquema actual atiende a la pérdida de peso o estabilización metabólica eficazmente.</li>`;
    } else if (cond.id === 'hepatica') {
      justificacion += `<li><strong>Mejora Histológica Hepática:</strong> El tratamiento incluye opciones que han evidenciado capacidad para revertir o frenar la progresión de la esteatohepatitis metabólica.</li>`;
    } else {
      justificacion += `<li><strong>Eficacia y Tolerabilidad:</strong> El paciente no presenta complicaciones mayores, logrando un excelente control metabólico mantenido.</li>`;
    }

    justificacion += `</ul><br><strong>Conducta a seguir:</strong> No proceden cambios en la medicación antidiabética en este momento. Se recomienda mantener el esquema vigente y citar al paciente para su control clínico rutinario.`;
    
    return justificacion;
}

function generateRecs(cond, target) {
  const recs = [];
  const trace = [];
  let conditionHandledIntensification = false;

  trace.push(`Evaluación: HbA1c actual de ${state.hba1c.toFixed(1)} % frente a objetivo de ${target.label}`);

  const hasCriticalConflict = detectIncompatibilities(recs, trace);

// =====================================================================
  // EL NUDGE GERIÁTRICO (Empujoncito de reflexión)
  // =====================================================================
  if (!state.fragilidad && (state.edad > 85 || state.deterioro)) {
    let motivoNudge = '';
    if (state.edad > 85 && state.deterioro) {
      motivoNudge = `la avanzada edad del paciente (${state.edad} años) y la presencia de deterioro cognitivo o limitación funcional`;
    } else if (state.edad > 85) {
      motivoNudge = `la avanzada edad del paciente (${state.edad} años)`;
    } else {
      motivoNudge = `la presencia de deterioro cognitivo o limitación funcional`;
    }

    recs.push({
      type: 'info', tag: 'Individualización Clínica', title: 'Valorar estado de fragilidad',
      body: `Dada ${motivoNudge}, se recomienda individualizar el tratamiento con especial precaución ante hipoglucemias. Si considera que la esperanza de vida es limitada o el grado de deterioro es importante, <strong>se recomienda marcar directamente la casilla "Fragilidad"</strong> en el panel de condicionantes para adaptar las recomendaciones a una estrategia de preservación de calidad de vida y desprescripción.`
    });
    trace.push(`Nudge de fragilidad activado por: ${motivoNudge}.`);
  }
  
  // =====================================================================
  // MANEJO DE URGENCIAS Y GLUCOTOXICIDAD 
  // =====================================================================
  const isPaliativo = state.fragilidad && state.fragGrade === 'muyGrave';
  const farmacoPrioritario = getFarmacoPrioritario(cond.id);
  let textoTransicion = ` Una vez resuelta la glucotoxicidad y retirados los síntomas (HbA1c < 8%), se recomienda transicionar y priorizar <strong>${farmacoPrioritario}</strong> para abordar su condicionante clínico principal (${cond.name}).`;

  // 1. Descontrol severo catabólico (Sintomático y >= 8.5)
  if (state.sintomatico && state.hba1c >= 8.5 && !isPaliativo) {
    if (state.cirrosis) {
      recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulinización Basal', body: `Ante clínica cardinal grave con HbA1c ≥ 8,5 % en paciente con cirrosis, la única opción segura para el rescate agudo es la <strong>Insulina Basal</strong>.` + textoTransicion });
    } else if (state.fge >= 30) {
      recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina Basal + Metformina', body: `Ante clínica cardinal grave o signos de catabolismo con HbA1c ≥ 8,5 %, se debe iniciar inmediatamente <strong>Insulina Basal combinada con Metformina</strong> para frenar la glucotoxicidad de forma aguda.` + textoTransicion });
    } else {
      recs.push({ type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina Basal en monoterapia', body: `Ante clínica cardinal grave con HbA1c ≥ 8,5 % y <strong>FGe &lt; 30 ml/min</strong> (Metformina contraindicada), se debe iniciar <strong>Insulina Basal en monoterapia</strong> para frenar la glucotoxicidad.` + textoTransicion });
    }
    conditionHandledIntensification = true;
    trace.push(`Clínica cardinal detectada. Se prioriza insulina con transición planificada a ${farmacoPrioritario}.`);
  } 
  // 2. Descontrol severo asintomático (> 10%)
  else if (!state.sintomatico && state.hba1c > 10.0 && !isPaliativo) {
    let textoA = `Iniciar Doble/Triple Terapia combinando Metformina con <strong>${farmacoPrioritario}</strong> por su condicionante clínico.`;
    if (state.fge < 30) textoA = `Iniciar terapia combinada segura para ERC integrando <strong>${farmacoPrioritario}</strong> (Metformina contraindicada).`;
    let textoB = state.fge >= 30 ? 'Iniciar Insulina Basal (+ Metformina).' : 'Iniciar Insulina Basal en monoterapia (Metformina contraindicada por FGe < 30).';

    recs.push({
      type: 'warn', tag: 'Bifurcación Terapéutica', title: 'Decisión Compartida: redGDPS vs ADA 2026 (HbA1c > 10 %)',
      body: `El paciente presenta glucotoxicidad severa. La ADA recomienda valorar insulina basal transitoria, mientras que la redGDPS permite intentar un rescate agresivo no insulínico al no haber clínica cardinal. Elija según el perfil del paciente:<br><br>
      <ul style="margin-top:0;">
        <li style="margin-bottom:8px;"><strong>Opción A (Vía No Insulínica de Alta Potencia):</strong> ${textoA} <em>Condición: Requiere asegurar adherencia y reevaluar estrictamente en 2-4 semanas. Si no hay descenso drástico basal, pasar a Opción B.</em></li>
        <li><strong>Opción B (Rescate Insulínico Transitorio):</strong> ${textoB} <em>Ventaja: Elimina rápidamente la glucotoxicidad. Una vez estabilizado (< 8 %), se puede retirar la insulina y transicionar al esquema ideal para su condicionante (${cond.name}).</em></li>
      </ul>`
    });
    conditionHandledIntensification = true;
    trace.push(`Descontrol asintomático >10%. Bifurcación dinámica inyectando ${farmacoPrioritario}.`);
  } 
  // 3. Discordancia Clínica (Síntomas pero HbA1c < 8.5)
  else if (state.sintomatico && state.hba1c < 8.5) {
    recs.push({ type: 'warn', tag: 'Descompensación Aguda', title: 'Investigar desencadenantes', body: `Paciente con clínica cardinal pero HbA1c < 8,5%. Se recomienda medir cetonuria e investigar desencadenantes agudos (corticoterapia, infecciones, neoplasias intercurrentes) antes de asumir el estado basal del paciente.` });
    trace.push(`Clínica cardinal con HbA1c < 8.5. Alerta de investigación de desencadenantes emitida.`);
  }

  // =====================================================================
  // Evaluación INDEPENDIENTE de Finerenona (ADA 2026)
  // =====================================================================
  if (state.uacr === 'macro' && state.ras && !state.drugs.finerenona) {
    if (state.fge >= 25 && state.potasio <= 5.0) {
      let tieneSGLT2 = hasClass('isglt2');
      let inicioSimultaneo = (!tieneSGLT2 && state.fge >= 30 && state.fge <= 90) ? 
        `<br><br><strong>Nota (Rec 11.9):</strong> Puede considerarse la iniciación simultánea de un iSGLT-2 y finerenona (ensayo CONFIDENCE).` : '';

      recs.push({ 
        type: 'add', tag: 'Nefro/Cardioprotección (Evidencia A)', title: 'Se recomienda iniciar Finerenona', 
        body: `Indicado para reducir la progresión de la ERC y los eventos cardiovasculares. El análisis combinado FIDELITY confirmó una reducción del 14% en eventos CV y del 23% en el desenlace renal compuesto.<br>
        <strong>Precaución:</strong> Monitorizar potasio a las 4 semanas. Suspender temporalmente si > 5,5 mmol/L.${inicioSimultaneo}` 
      });
      trace.push('UACR ≥ 100 e IECA/ARA-II: Se recomienda iniciar Finerenona (paciente no la toma).');
    } else if (state.potasio > 5.0) {
      recs.push({ type: 'warn', tag: 'Contraindicación Temporal', title: 'Finerenona diferida por Hiperpotasemia', body: `El paciente tiene indicación para Finerenona (UACR ≥ 100 mg/g y uso de IECA/ARA-II), pero su potasio basal es > 5.0 mmol/L. Debe corregir el potasio antes de iniciar terapia.` });
    }
  } else if (state.drugs.finerenona) {
    trace.push('Finerenona activa en el tratamiento. Se omite recomendación de inicio.');
  }

  // =====================================================================
  // FLUJO DE CONDICIONANTES (Se silencian si hay Urgencia Metabólica)
  // Notar que la fragilidad ahora trunca a casi todas las demás para centrarse en QoL
  // =====================================================================
  if (cond.id === 'cirrosis') { conditionHandledIntensification = handleCirrosis(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'fragilidad') { conditionHandledIntensification = handleFragilidad(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'ictus') { conditionHandledIntensification = handleIctus(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'ecvCoronaria') { conditionHandledIntensification = handleECVCoronaria(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'ic') { conditionHandledIntensification = handleIC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'erc') { conditionHandledIntensification = handleERC(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'obesidad') { conditionHandledIntensification = handleObesidad(recs, trace, target) || conditionHandledIntensification; }
  else if (cond.id === 'hepatica') { conditionHandledIntensification = handleHepatica(recs, trace, target) || conditionHandledIntensification; }

  // Intensificación General (solo si no hubo comorbilidades ni emergencias metabólicas)
  if (cond.id === null || (state.hba1c > target.upperBound && !conditionHandledIntensification && !state.sintomatico)) {
      applyGeneralIntensification(recs, trace, target, hasCriticalConflict);
  }

  const inTarget = state.hba1c <= target.upperBound;
  // Excluimos finerenona y Nudge Geriátrico de needsActionGlycemic para no bloquear el mensaje de "Optimizado".
  const needsActionGlycemic = recs.some(r => (r.type === 'add' || r.type === 'warn' || r.type === 'danger') && r.tag !== 'Individualización Geriátrica' && r.title !== 'Se recomienda iniciar Finerenona' && r.title !== 'Finerenona diferida por Hiperpotasemia');

  if (!needsActionGlycemic && target.target !== null && inTarget && !hasCriticalConflict) {
    const justificacionOptimizado = renderOptimizedState(cond, state, target);
    recs.push({
      type: 'ok', tag: 'Paciente Optimizado', title: 'El tratamiento glucémico está optimizado',
      body: justificacionOptimizado
    });
  } else if (state.hba1c > target.upperBound && target.target !== null && needsActionGlycemic) {
    if (state.cirrosis) {
      recs.push({ type: 'warn', tag: 'Seguimiento Estrecho', title: 'Control por Aparato Digestivo / Especialista', body: `Dada la insuficiencia hepática terminal, cualquier modificación farmacológica exige un control muy estrecho por su especialista.` });
    } else if (state.fge < 45) {
      recs.push({ type: 'warn', tag: 'Seguimiento Estrecho', title: 'Control nefrológico < 3 meses', body: `Requiere control analítico en menos de 3 meses para monitorizar función renal y potasio.` });
    } else {
      recs.push({ type: 'warn', tag: 'Seguimiento', title: 'Se recomienda reevaluar a los 3 meses', body: `Al no alcanzar el objetivo hoy, es obligatorio realizar un control de HbA1c a los 3 meses para evitar inercia clínica.` });
    }
  }

  return { recs, trace };
}

// ---------------------------------------------------------------------
// HANDLERS DE COMORBILIDADES
// ---------------------------------------------------------------------

function handleFragilidad(recs, trace, target) {
  if (state.fragGrade === 'muyGrave') {
    recs.push({ type: 'warn', tag: 'Final de vida', title: 'Se recomienda desintensificación estructurada', body: `El objetivo es puramente paliativo. Deben retirarse todas las medidas para prevenir complicaciones crónicas y ajustar fármacos al mínimo viable para evitar clínica aguda.` });
    return true;
  }
  
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio', 'ins'].filter(c => hasClass(c)).length;
  const tieneRiesgoGeriátrico = hasClass('isglt2') || hasClass('su') || hasClass('glinida') || hasClass('ins');
  const coreMessage = 'El manejo clínico debe centrarse exclusivamente en preservar la calidad de vida. El objetivo es asegurar la ausencia de hipoglucemias y evitar síntomas de hiperglucemia (poliuria, polidipsia, pérdida de peso).';
  
  if (clasesUsadas === 0) {
    // Paciente virgen
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar con iDPP-4', body: coreMessage + `<br><br>Al estar virgen de tratamiento, se recomienda iniciar <strong>iDPP-4</strong> (ej. linagliptina, sitagliptina) como terapia base preferida por carecer de riesgo de hipoglucemia y tener posologías muy seguras.` });
  } else if (tieneRiesgoGeriátrico) {
    // Toma SGLT2, SU, Glinidas o Insulina (Riesgo inaceptable)
    recs.push({ type: 'info', tag: 'Desprescripción / Sustitución', title: 'Priorizar Calidad de Vida', body: coreMessage + `<br><br>Se recomienda <strong>sustituir o retirar</strong> fármacos de alto riesgo geriátrico en lugar de añadir nuevos. Valore transicionar la base del tratamiento a un <strong>iDPP-4</strong> si precisa control sintomático.` });
    
    if (hasClass('isglt2')) {
        recs.push({ type: 'warn', tag: 'Riesgo Geriátrico', title: 'Precaución severa con iSGLT-2', body: `El paciente toma un iSGLT-2. A estas edades y nivel de fragilidad, inducen glucosuria y diuresis osmótica, elevando drásticamente el riesgo de deshidratación, hipotensión ortostática, caídas y sarcopenia. <strong>Considere firmemente su retirada o sustitución.</strong>` });
    }
    if (hasClass('su') || hasClass('glinida') || hasClass('ins')) {
        recs.push({ type: 'danger', tag: 'Riesgo Geriátrico Crítico', title: 'Peligro de Hipoglucemia Severa', body: `El uso de Secretagogos (Sulfonilureas/Glinidas) o Insulina en pacientes frágiles conlleva un altísimo riesgo de hipoglucemias severas, caídas y daño neurológico. <strong>Se debe buscar la mínima dosis viable o proceder a su retirada/sustitución progresiva.</strong>` });
    }
  } else if (state.hba1c > target.upperBound) {
    // Toma fármacos seguros (Metformina) pero está fuera de objetivo
    recs.push({ 
      type: 'add', tag: 'Optimización Geriátrica', title: 'Añadir iDPP-4', 
      body: coreMessage + `<br><br>Al estar por encima del objetivo (HbA1c > ${target.upperBound}%), se recomienda <strong>añadir un iDPP-4</strong> a su pauta actual. <br><br><em>Nota clínica: No se recomienda sustituir la Metformina por el iDPP-4 para intentar mejorar el control, ya que la menor potencia del iDPP-4 provocaría un efecto rebote y un aumento de la HbA1c. (La sustitución solo procedería si hay intolerancia digestiva o anorexia).</em>` 
    });
  } else {
    // Toma fármacos seguros (Metformina/iDPP4) y ESTÁ EN OBJETIVO (El caso de tu paciente de 95 años)
    if (state.drugs.metformina) {
        recs.push({ type: 'ok', tag: 'Mantenimiento Geriátrico', title: 'Vigilancia de Metformina', body: `El paciente está bien controlado con su pauta actual. La Metformina es segura si el filtrado glomerular lo permite, pero a esta edad <strong>vigile activamente la aparición de anorexia, pérdida de peso involuntaria o intolerancia digestiva</strong>. Si ocurren, considere retirarla o cambiar a iDPP-4.` });
    }
  }
  
  return true; 
}

function handleCirrosis(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  if (!hasClass('idpp4') && !hasClass('ins')) {
    recs.push({ type: 'add', tag: 'Terapia Segura', title: 'Se recomienda iDPP-4 o Insulina', body: `El manejo de la diabetes en la cirrosis hepática avanzada es muy restrictivo. Las opciones más seguras son los <strong>iDPP-4</strong> (especialmente la Linagliptina por su eliminación biliar que no exige ajuste) o la <strong>Insulina</strong>.` });
    intensified = true;
  }
  if (state.hba1c > target.upperBound && hasClass('idpp4') && !hasClass('ins')) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda Insulinización', body: `Al no alcanzar el objetivo con un iDPP-4, la opción de rescate más segura y eficaz en la insuficiencia hepática grave es la <strong>Insulina</strong>.` });
    intensified = true;
  }
  return true; 
}

function handleIctus(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneGLP = hasClass('arglp');
  const tienePio = state.drugs.pioglitazona;
  
  if (!tieneGLP) {
    if(state.fge >= 15) {
      recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar arGLP-1', body: `Para prevención secundaria de <strong>Ictus o AIT</strong>, la evidencia demuestra superioridad de los <strong>arGLP-1</strong> (asegurar FG adecuado si se usa exenatida/lixisenatida). Como alternativa oral en pacientes con insulinorresistencia, valore <strong>Pioglitazona</strong> (estudio IRIS). Los iSGLT-2 tienen un efecto neutro sobre el ictus isquémico.` });
      intensified = true;
    }
  }
  
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'info', tag: 'Sinergia', title: 'Considerar Metformina', body: `Se aconseja acompañar de Metformina por su efecto glucémico complementario y bajo coste.` });
  } else if (!state.drugs.metformina && state.fge >= 30 && state.hba1c <= target.upperBound && (tieneGLP || tienePio)) {
    recs.push({ type: 'info', tag: 'Metformina no prioritaria', title: 'No se precisa añadir Metformina', body: `El paciente ya alcanza su objetivo glucémico con el tratamiento actual. La protección cerebrovascular se mantiene sin necesidad de añadir Metformina.` });
  }

  if (state.hba1c > target.upperBound && tieneGLP && !tienePio && !hasClass('isglt2')) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda sumar Pioglitazona o iSGLT-2', body: `Para optimizar el control glucémico, se puede añadir Pioglitazona (beneficio en ictus recurrente) o un iSGLT-2.` });
    intensified = true;
  }
  return intensified;
}

function handleECVCoronaria(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneCardio = hasClass('isglt2') || hasClass('arglp') || hasClass('argip');
  
  if (!tieneCardio) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar iSGLT-2, arGLP-1 o arGIP/GLP-1', body: `Iniciar terapia con beneficio cardiovascular demostrado independientemente de la HbA1c para frenar eventos MACE coronarios o periféricos.` });
    intensified = true;
  }
  
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'info', tag: 'Sinergia', title: 'Considerar Metformina', body: `Se aconseja acompañar de Metformina por su efecto glucémico complementario y bajo coste.` });
  } else if (!state.drugs.metformina && state.fge >= 30 && state.hba1c <= target.upperBound && tieneCardio) {
    recs.push({ type: 'info', tag: 'Metformina no prioritaria', title: 'No se precisa añadir Metformina', body: `El paciente ya alcanza su objetivo glucémico con el cardioprotector actual.` });
  }
  
  if (state.hba1c > target.upperBound && tieneCardio && !(hasClass('isglt2') && (hasClass('arglp') || hasClass('argip')))) {
    recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda sumar una segunda familia cardioprotectora', body: `Se recomienda combinar un iSGLT-2 con un arGLP-1/arGIP-GLP-1 simultáneamente para maximizar el pronóstico y el control glucémico.` });
    intensified = true;
  }
  return intensified;
}

function handleIC(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneSGLT2 = hasClass('isglt2');
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  
  if (state.obesidad && !tieneIncretina) {
    recs.push({ 
      type: 'add', tag: 'Evidencia A (IC + Obesidad)', title: 'Se recomienda iniciar arGIP/GLP-1 o arGLP-1', 
      body: `El ensayo SUMMIT y la ADA 2026 establecen que, en pacientes con DM2, obesidad e Insuficiencia Cardíaca (FE preservada), el tratamiento <strong>debe incluir un agonista dual o arGLP-1 independientemente del valor de HbA1c</strong> para mejorar los síntomas y reducir eventos.` 
    });
    intensified = true;
  }

  if (!tieneSGLT2) {
    if(state.fge >= 20) {
        recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar un iSGLT-2', body: `Pilar fundamental (independiente de HbA1c) por reducción de mortalidad e ingresos por IC.` });
        intensified = true;
    }
  }
  
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'info', tag: 'Sinergia', title: 'Considerar Metformina', body: `Se aconseja acompañar de Metformina por su efecto glucémico complementario y bajo coste.` });
  } else if (!state.drugs.metformina && state.fge >= 30 && state.hba1c <= target.upperBound && tieneSGLT2) {
    recs.push({ type: 'info', tag: 'Metformina no necesaria', title: 'No se precisa asociar Metformina', body: `El paciente ya alcanza su objetivo glucémico con el iSGLT-2 actual. Al estar controlado, la Metformina no aporta beneficio pronóstico adicional en IC.` });
  }

  if (state.hba1c > target.upperBound && tieneSGLT2 && !hasClass('arglp') && !hasClass('argip')) {
    if(state.fge >= 15) {
      recs.push({ type: 'add', tag: 'Si insuficiente', title: 'Se recomienda añadir arGLP-1 o arGIP/GLP-1', body: `Añadir incretínicos por beneficio demostrado en ensayos recientes en pacientes con IC, como complemento al SGLT2.` });
      intensified = true;
    }
  }
  return intensified;
}

function handleERC(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneSGLT2 = hasClass('isglt2');
  
  if (state.fge >= 20 && !tieneSGLT2) {
    recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar iSGLT-2', body: `Pilar fundamental en enfermedad renal crónica para ralentizar la caída del FG y la progresión a diálisis.` });
    intensified = true;
  }
  
  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Sinergia Basal', title: 'Se recomienda asociar Metformina', body: `Para optimizar el control glucémico, se recomienda añadir Metformina como base complementaria.` });
    intensified = true;
  }

  if (state.hba1c > target.upperBound && (tieneSGLT2 || state.fge < 20) && !hasClass('arglp') && !hasClass('argip')) {
      recs.push({ type: 'add', tag: '2ª línea', title: 'Se recomienda añadir arGLP-1', body: `Especialmente la semaglutida (respaldada por el estudio FLOW) por su fuerte protección renal adicional al SGLT2 (evitar exenatida/lixisenatida si FG ≤ 30).` });
      intensified = true;
  }
  return intensified;
}

function handleObesidad(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio'].filter(c => hasClass(c)).length;

  if (!tieneIncretina) {
      if (clasesUsadas > 0 || state.hba1c >= 8.0) {
        recs.push({ type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda asociar arGLP-1 o arGIP/GLP-1', body: `Para pacientes con obesidad que no logran control inicial o debutan muy descompensados, la terapia incretínica es prioritaria por las drásticas pérdidas de peso (10-20%) que atacan la resistencia a la insulina.` });
        intensified = true;
      } else {
        recs.push({ type: 'ok', tag: 'Inicio Conservador', title: 'Iniciar Metformina + Dieta', body: `En pacientes con obesidad y descontrol glucémico leve/moderado (HbA1c < 8.0%), el pilar inicial sigue siendo la optimización del estilo de vida junto con Metformina.` });
        recs.push({ type: 'info', tag: 'Alternativa Premium', title: 'Considerar GLP-1 RA inicial (opcional)', body: `Si el paciente prioriza la pérdida de peso significativa, las guías avalan el inicio temprano con arGLP-1 o Tirzepatida.` });
        trace.push('Paciente virgen con obesidad y descontrol leve/moderado (<8.0%). Se prioriza inicio con Metformina+Dieta antes de exigir inyectables de primera línea.');
        intensified = true; 
      }
  }
  
  if (tieneIncretina && !state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Sinergia Basal', title: 'Se recomienda asociar Metformina', body: `Para optimizar el control glucémico de base, se recomienda añadir Metformina.` });
    intensified = true;
  }

  if (state.hba1c > target.upperBound && tieneIncretina && !hasClass('isglt2')) {
    if(state.fge >= 20) {
      recs.push({ type: 'add', tag: 'Intensificar', title: 'Se recomienda asociar un iSGLT-2', body: `Añadir a la incretina como mecanismo de rescate oral para controlar la glucemia y aportar una discreta sinergia ponderal.` });
      intensified = true;
    }
  }
  return intensified;
}

function handleHepatica(recs, trace, target) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return true;
  let intensified = false;
  const tieneSemaglutida = state.drugs.semaglutida;
  const tieneIncretinaB = (hasClass('arglp') && !tieneSemaglutida) || hasClass('argip');
  const tienePio = state.drugs.pioglitazona;
  
  if (!tieneSemaglutida) {
      if (tieneIncretinaB) {
        recs.push({ type: 'info', tag: 'Optimización Hepática', title: 'Considerar cambio a Semaglutida', body: `El paciente toma una incretina de Nivel B para MASH. La <strong>Semaglutida</strong> cuenta con Nivel de Evidencia A (estudio ESSENCE) y aprobación FDA para fibrosis moderada-avanzada, logrando resolución en el 62,9% de casos. Considere el cambio si el objetivo principal es histológico.` });
      } else {
        recs.push({ type: 'add', tag: 'Añadir 1ª línea (Nivel A)', title: 'Se recomienda iniciar Semaglutida', body: `En pacientes con MASH y fibrosis (o alto riesgo), la <strong>Semaglutida</strong> es el único tratamiento con Nivel de Evidencia A (estudio ESSENCE). Quedan como Nivel B la Tirzepatida, otros arGLP-1 y la Pioglitazona.` });
        intensified = true;
      }
  }
  
  if ((tieneSemaglutida || tieneIncretinaB) && !tienePio && state.hba1c > target.upperBound && !state.ic) {
    recs.push({ type: 'add', tag: 'Sinergia Hepática', title: 'Considerar terapia combinada con Pioglitazona', body: `La ADA 2026 sugiere que la combinación de <strong>arGLP-1 + Pioglitazona</strong> puede considerarse por sus potenciales efectos beneficiosos aditivos sobre la esteatohepatitis.` });
    intensified = true;
  }

  if (!state.drugs.metformina && state.fge >= 30 && !state.cirrosis && state.hba1c > target.upperBound) {
    recs.push({ type: 'add', tag: 'Sinergia Basal', title: 'Se recomienda asociar Metformina', body: `Para optimizar el control glucémico basal, se recomienda añadir Metformina.` });
    intensified = true;
  }

  return intensified;
}

function applyGeneralIntensification(recs, trace, target, hasCriticalConflict) {
  if (state.hba1c > 10.0 || (state.sintomatico && state.hba1c >= 8.5)) return;

  const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'glinida', 'pio'].filter(c => hasClass(c)).length;
  const availableADNIs = getAvailableADNIs(state);
  
  let optionsText = '';
  if (availableADNIs.length > 0) {
    optionsText = `<br><br>Familias compatibles y seguras sugeridas:<ul><li>` + availableADNIs.join('</li><li>') + `</li></ul>`;
  } else {
    optionsText = `<br><br><strong>Aviso Crítico:</strong> No quedan más familias de fármacos orales ni incretínicos seguras. Considere insulinización directa.`;
  }

  if (hasCriticalConflict) {
    recs.push({ type: 'add', tag: 'Reestructuración', title: 'Se requiere Reestructuración Terapéutica', body: `Es obligatorio suspender o retirar parte de su tratamiento actual por motivos de seguridad médica. Sustituya los fármacos retirados por opciones seguras para tratar de alcanzar la meta.${optionsText}` });
    trace.push('Intensificación bloqueada: Se requiere reestructuración previa por conflictos graves.');
    return;
  }

  if (state.hba1c >= 8.5 && state.hba1c <= 10.0) {
    if (clasesUsadas === 0) {
      if (state.fge >= 30) {
        recs.push({ type: 'add', tag: 'Inicio Intensivo (redGDPS)', title: 'Se recomienda iniciar con Doble Terapia', body: `Al presentar HbA1c ≥ 8,5 % asintomática, el algoritmo ordena <strong>no empezar con monoterapia</strong>. Inicie directamente combinando <strong>Metformina</strong> con un segundo ADNI de alta potencia (iSGLT-2 o incretinas). La insulina queda reservada para casos sintomáticos.` });
      } else {
        recs.push({ type: 'add', tag: 'Inicio Intensivo Seguro', title: 'Se recomienda Doble Terapia ajustada al FG', body: `Con HbA1c ≥ 8,5 % asintomática se requiere Doble Terapia inicial, pero la Metformina está contraindicada. Se recomienda asociar fármacos seguros según FG (ej. iDPP-4 + arGLP-1).` });
      }
      trace.push('HbA1c 8.5-10.0 asintomático virgen: Inicio obligatorio con Doble terapia.');
    } else if (clasesUsadas === 1) {
      recs.push({ type: 'add', tag: 'Intensificación Rápida', title: 'Se recomienda progresar a Triple Terapia (redGDPS)', body: `Ante un descontrol grave (HbA1c ≥ 8,5 %) asintomático, el algoritmo redGDPS insta a intensificar enérgicamente añadiendo un segundo ADNI a su base actual para vencer el descontrol, posponiendo la insulina basal exclusivamente para casos que desarrollen síntomas cardinales.${optionsText}` });
      trace.push('HbA1c 8.5-10.0 asintomático (1 fármaco): Salto a triple terapia sugerido.');
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Intensificar a Triple/Cuádruple', title: 'Se recomienda progresar con 3º o 4º ADNI', body: `El descontrol grave persiste sin clínica cardinal. La redGDPS mantiene la indicación de exprimir terapias no insulínicas de alta potencia antes de insulinizar.${optionsText}` });
      trace.push('HbA1c 8.5-10.0 asintomático (2 fármacos): Cuádruple terapia sugerida.');
    } else {
      recs.push({ type: 'add', tag: 'Paso Estratégico', title: 'Se recomienda valorar Insulina Basal o 4º ADNI', body: `El paciente presenta un control sumamente deficiente (${state.hba1c.toFixed(1)} %) a pesar de estar polimedicado (${clasesUsadas} fármacos). Es altamente probable un fracaso pancreático. Si ya recibe incretinas/SGLT2, la insulina basal es el rescate más realista.${optionsText}` });
      trace.push('HbA1c 8.5-10.0 asintomático (3+ fármacos): Valorar insulina por probable agotamiento pancreático.');
    }
    return;
  } 

  if (state.hba1c > target.upperBound) {
    if (clasesUsadas === 0) {
      if (state.fge >= 30) {
        recs.push({ type: 'add', tag: 'Inicio', title: 'Se recomienda iniciar tratamiento con Metformina', body: `En un paciente virgen de tratamiento, la estrategia universal marca iniciar <strong>Metformina</strong> como base y potenciar los cambios en el estilo de vida.` });
      } else {
        recs.push({ type: 'add', tag: 'Inicio', title: 'Se recomienda iniciar Monoterapia (alternativa a Metformina)', body: `La Metformina está contraindicada por el bajo filtrado glomerular actual. Se recomienda iniciar con alternativas seguras como iDPP-4 o arGLP-1 (según FG).` });
      }
    } else if (clasesUsadas === 1) {
      recs.push({ type: 'add', tag: 'Progresión', title: 'Se recomienda asociar un segundo fármaco', body: `Para limar la diferencia hasta alcanzar el objetivo, se recomienda añadir un segundo fármaco complementario a la pauta actual.${optionsText}` });
    } else if (clasesUsadas === 2) {
      recs.push({ type: 'add', tag: 'Progresión', title: 'Se recomienda instaurar Triple Terapia', body: `La combinación actual es insuficiente para alcanzar la meta. Está indicado sumar una tercera familia farmacológica.${optionsText}` });
    } else {
      recs.push({ type: 'add', tag: 'Núcleo del Algoritmo', title: 'Se recomienda añadir un 4º ADNI o iniciar Insulina Basal', body: `Al fracasar ${clasesUsadas} familias farmacológicas, el paciente entra en la fase central (y más restrictiva) del algoritmo. Debe valorar el perfil del paciente para decidir entre intentar asociar un <strong>cuarto fármaco (ADNI)</strong> o dar paso a <strong>Insulina Basal</strong>.${optionsText}` });
    }
  }
}

function renderCurrentDrugs() {
  const el = document.getElementById('currentDrugs');
  const active = Object.entries(state.drugs).filter(([k,v]) => v).map(([k]) => k);
  if (active.length === 0) { el.innerHTML = '<span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado (Paciente sin tratamiento)</span>'; return; }
  el.innerHTML = active.map(d => `<span class="drug-pill current">${DRUG_LABELS[d]}</span>`).join('');
}

function renderRecs(recs) {
  const el = document.getElementById('recommendations');
  if (recs.length === 0) { el.innerHTML = '<div class="empty-state">No se pudieron generar recomendaciones.</div>'; return; }
  el.innerHTML = recs.map(r => `
    <div class="rec-card ${r.type}">
      <div class="rec-card-tag">${r.tag}</div>
      <div class="rec-card-title">${r.title}</div>
      <div class="rec-card-body">${r.body}</div>
    </div>
  `).join('');
}

function renderTrace(trace) {
  document.getElementById('trace').innerHTML = trace.map(t => `<li>${t}</li>`).join('');
}

function update() {
  state.hba1c = parseFloat(document.getElementById('hba1c').value);
  state.edad = parseInt(document.getElementById('edad').value) || 0;
  state.tiempoDx = parseFloat(document.getElementById('tiempoDx').value) || 0;
  state.fge = parseFloat(document.getElementById('fge').value) || 0;
  
  state.uacr = document.getElementById('uacr').value;
  state.potasio = parseFloat(document.getElementById('potasio').value);
  state.ras = document.getElementById('ras').value === 'si';

  state.sintomatico = document.getElementById('sintomatico').checked;
  state.cirrosis = document.getElementById('cirrosis').checked;
  state.ictus = document.getElementById('ictus').checked;
  state.ecvCoronaria = document.getElementById('ecvCoronaria').checked;
  state.ic = document.getElementById('ic').checked;
  state.rcvAlto = document.getElementById('rcvAlto').checked;
  
  state.erc = state.fge < 60 || state.uacr === 'micro' || state.uacr === 'macro'; 
  
  state.obesidad = document.getElementById('obesidad').checked;
  state.hepatica = document.getElementById('hepatica').checked;
  state.fragilidad = document.getElementById('fragilidad').checked;
  
  // Eliminado el automatismo que ligaba el deterioro cognitivo a la fragilidad
  state.deterioro = document.getElementById('deterioro').checked;

  const fragRadio = document.querySelector('input[name="fragGrade"]:checked');
  state.fragGrade = fragRadio ? fragRadio.value : 'moderadaGrave';

  state.drugs = {};
  document.querySelectorAll('[data-drug]').forEach(cb => { state.drugs[cb.dataset.drug] = cb.checked; });

  document.getElementById('hbValue').textContent = state.hba1c.toFixed(1);
  const gme = Math.round(28.7 * state.hba1c - 46.7);
  document.getElementById('gme').textContent = gme;

  document.getElementById('fragilidadGrade').classList.toggle('active', state.fragilidad);
  document.querySelectorAll('.check').forEach(c => { const id = c.dataset.check; if (id) c.classList.toggle('checked', state[id] === true); });
  document.querySelectorAll('.radio-pill').forEach(p => { const input = p.querySelector('input'); p.classList.toggle('selected', input.checked); });
  document.querySelectorAll('.drug-class').forEach(dc => { const cls = dc.dataset.drugclass; dc.classList.toggle('has-active', hasClass(cls)); });

  const fgeHint = document.getElementById('fgeHint');
  if (state.fge < 30) {
      fgeHint.innerHTML = '<span style="color:var(--danger); font-weight:600;">Metformina contraindicada. iSGLT-2 no iniciar.</span>';
  } else if (state.fge < 45) {
      fgeHint.innerHTML = '<span style="color:var(--warn); font-weight:600;">Reducir dosis de Metformina al 50%.</span>';
  } else if (state.fge < 60) {
      fgeHint.innerHTML = '<span style="color:var(--evidence); font-weight:600;">FGe marca ERC automáticamente.</span>';
  } else {
      fgeHint.innerHTML = '';
  }

  const cond = getConditioner();
  const target = getTarget();
  const { recs, trace } = generateRecs(cond, target);

  const tv = document.getElementById('targetValue');
  if (target.target === null) { tv.textContent = 'Sin objetivo'; tv.classList.add('muted'); } 
  else { tv.textContent = target.label; tv.classList.remove('muted'); }

  document.getElementById('targetRationale').textContent = target.rationale;

  const status = document.getElementById('targetStatus');
  if (target.target === null) { status.className = 'target-status warn'; status.textContent = 'Sin objetivo numérico'; } 
  else if (state.hba1c <= target.upperBound) { status.className = 'target-status ok'; status.textContent = 'En objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else if (state.hba1c <= target.upperBound + 0.2) { status.className = 'target-status warn'; status.textContent = 'Al límite o levemente sobre el objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; } 
  else { status.className = 'target-status no'; status.textContent = 'Lejos del objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %'; }

  document.getElementById('conditionerName').textContent = cond.name;
  document.getElementById('conditionerMeta').textContent = cond.meta;

  renderCurrentDrugs(); renderRecs(recs); renderTrace(trace);
}

function resetAll() {
  document.getElementById('hba1c').value = 7.5;
  document.getElementById('edad').value = 65;
  document.getElementById('tiempoDx').value = 5;
  document.getElementById('fge').value = 80;
  
  document.getElementById('uacr').value = 'normal';
  document.getElementById('potasio').value = 4.5;
  document.getElementById('ras').value = 'si';

  document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
  const fragModGrave = document.querySelector('input[name="fragGrade"][value="moderadaGrave"]');
  if (fragModGrave) fragModGrave.checked = true;
  update();
}

document.querySelectorAll('input, select').forEach(el => { el.addEventListener('input', update); el.addEventListener('change', update); });
update();
</script>

