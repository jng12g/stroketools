<script>
/* =================================================================
   Algoritmo redGDPS 2026 - lógica clínica corregida
   ================================================================= */

const state = {
  hba1c: 7.5,
  edad: 65,
  tiempoDx: 5,
  imc: 29,
  fge: 80,
  sintomatico: false,
  dxReciente: false,
  ic: false,
  ecv: false,
  rcvAlto: false,
  erc: false,
  obesidad: false,
  hepatica: false,
  fragilidad: false,
  fragGrade: 'leve',
  deterioro: false,
  drugs: {}
};

const DRUG_LABELS = {
  metformina: 'Metformina',
  empagliflozina: 'Empagliflozina',
  dapagliflozina: 'Dapagliflozina',
  canagliflozina: 'Canagliflozina',
  ertugliflozina: 'Ertugliflozina',
  semaglutida: 'Semaglutida',
  dulaglutida: 'Dulaglutida',
  liraglutida: 'Liraglutida',
  exenatida: 'Exenatida',
  tirzepatida: 'Tirzepatida',
  sitagliptina: 'Sitagliptina',
  linagliptina: 'Linagliptina',
  vildagliptina: 'Vildagliptina',
  saxagliptina: 'Saxagliptina',
  glimepirida: 'Glimepirida',
  gliclazida: 'Gliclazida',
  repaglinida: 'Repaglinida',
  pioglitazona: 'Pioglitazona',
  insulinaBasal: 'Insulina basal',
  insulinaPrandial: 'Insulina prandial'
};

const DRUG_CLASS = {
  metformina: 'met',
  empagliflozina: 'isglt2', dapagliflozina: 'isglt2', canagliflozina: 'isglt2', ertugliflozina: 'isglt2',
  semaglutida: 'arglp', dulaglutida: 'arglp', liraglutida: 'arglp', exenatida: 'arglp',
  tirzepatida: 'argip',
  sitagliptina: 'idpp4', linagliptina: 'idpp4', vildagliptina: 'idpp4', saxagliptina: 'idpp4',
  glimepirida: 'su', gliclazida: 'su', repaglinida: 'su',
  pioglitazona: 'pio',
  insulinaBasal: 'ins', insulinaPrandial: 'ins'
};

function hasClass(cls) {
  return Object.entries(state.drugs).some(([k,v]) => v && DRUG_CLASS[k] === cls);
}
function drugsInClass(cls) {
  return Object.entries(state.drugs).filter(([k,v]) => v && DRUG_CLASS[k] === cls).map(([k]) => k);
}

/* ---------- Determinación de condicionante predominante ----------
   Prioridad de izquierda a derecha según el algoritmo:
   IC > ECV/RCV > ERC > Obesidad > Hepática > Fragilidad
------------------------------------------------------------------ */
function getConditioner() {
  if (state.ic) return { id: 'ic', name: 'Insuficiencia cardíaca', meta: 'iSGLT-2 (con o sin Met) → arGLP-1 / arGIP-GLP-1' };
  if (state.ecv || state.rcvAlto) {
    const label = state.ecv ? 'ECV establecida' : 'RCV elevado';
    return { id: 'ecv', name: label, meta: 'iSGLT-2 o arGLP-1/arGIP-GLP-1 + Met' };
  }
  if (state.erc) return { id: 'erc', name: 'Enfermedad renal crónica', meta: 'iSGLT-2 (si FGe ≥20) → arGLP-1 (preferible semaglutida)' };
  if (state.obesidad) return { id: 'obesidad', name: 'Obesidad', meta: 'arGIP-GLP-1 o arGLP-1 + Met → iSGLT-2' };
  if (state.hepatica) return { id: 'hepatica', name: 'Enfermedad hepática metabólica', meta: 'arGIP-GLP-1 o arGLP-1 → iSGLT-2 o Pio' };
  if (state.fragilidad) {
    return { id: 'fragilidad', name: 'Fragilidad · ' + state.fragGrade, meta: 'iDPP-4 → +Met → insulina + Met (evitar SU)' };
  }
  return { id: null, name: 'Ninguno', meta: 'Algoritmo guiado por HbA1c y clínica cardinal' };
}

/* ---------- Objetivo HbA1c personalizado (Corregido a Guía 2026) ---------- */
function getTarget() {
  const sinComplicaciones = !state.ic && !state.ecv && !state.erc && !state.hepatica && !state.rcvAlto;

  if (state.fragilidad && state.fragGrade === 'muyGrave') {
    return { 
      target: null, 
      label: 'Evitar síntomas', 
      rationale: 'Fragilidad muy grave / esperanza de vida limitada. No hay objetivo numérico, priorizar evitar síntomas de hipoglucemia o hiperglucemia.', 
      upperBound: 9.0
    };
  }
  // Deterioro cognitivo o limitación funcional determina fragilidad moderada-grave
  if (state.deterioro || (state.fragilidad && (state.fragGrade === 'grave' || state.fragGrade === 'moderada'))) {
    return { 
      target: 8.5, 
      label: '7,5 - 8,5 %', 
      rationale: 'Fragilidad moderada-grave (deterioro cognitivo y/o limitación funcional). Especial vigilancia en pacientes tratados con insulina o SU.',
      upperBound: 8.5
    };
  }
  if (state.dxReciente && !state.fragilidad && sinComplicaciones) {
    return { 
      target: 6.5, 
      label: '< 6,5 %', 
      rationale: 'Reciente diagnóstico sin fragilidad ni complicaciones: Alcanzar objetivo estricto durante el primer año y mantener si no hay hipoglucemias.',
      upperBound: 6.5
    };
  }
  if (!state.fragilidad && sinComplicaciones && (state.tiempoDx > 10 || state.edad > 75)) {
    return { 
      target: 7.0, 
      label: '≤ 7,0 %', 
      rationale: 'Larga evolución (>10 años) o edad >75 años, sin complicaciones asociadas.',
      upperBound: 7.0
    };
  }
  return { 
    target: 7.0, 
    label: '< 7,0 %', 
    rationale: 'Objetivo de HbA1c general individualizado.',
    upperBound: 7.0
  };
}

/* ---------- Motor de recomendaciones ---------- */
function generateRecs(cond, target) {
  const recs = [];
  const trace = [];

  trace.push(`HbA1c actual: ${state.hba1c.toFixed(1)} % · objetivo personalizado: ${target.label}`);
  trace.push(`Condicionante predominante: ${cond.name}`);

  /* ===== Alertas de seguridad transversales ===== */

  // Metformina y filtrado glomerular
  if (state.drugs.metformina) {
    if (state.fge < 30) {
      recs.push({
        type: 'danger', tag: 'Contraindicación', title: 'Suspender metformina',
        body: `FGe = <strong>${state.fge} mL/min</strong> < 30. La metformina está contraindicada por debajo de este umbral.`
      });
      trace.push('Met contraindicada por FGe <30 → suspender');
    } else if (state.fge < 45) {
      recs.push({
        type: 'warn', tag: 'Ajuste de dosis', title: 'Reducir metformina a la mitad',
        body: `FGe entre 30–45 mL/min: reducir dosis de metformina al 50% y monitorizar.`
      });
      trace.push('Met: reducir a la mitad por FGe 30-45');
    }
  }

  if (hasClass('isglt2') && state.fge < 20) {
    recs.push({
      type: 'danger', tag: 'Reevaluar', title: 'iSGLT-2 con FGe < 20',
      body: `Los iSGLT-2 se recomiendan con FGe ≥ 20 mL/min/1,73 m². Reevaluar continuidad y progresión de ERC.`
    });
    trace.push('iSGLT-2: FGe <20 → reevaluar');
  }

  if (hasClass('idpp4') && (hasClass('arglp') || hasClass('argip'))) {
    recs.push({
      type: 'danger', tag: 'Asociación no sinérgica', title: 'Retirar iDPP-4',
      body: `No asociar iDPP-4 con arGLP-1 ni arGIP/GLP-1. Retirar iDPP-4 y mantener el análogo inyectable.`
    });
    trace.push('iDPP-4 + arGLP-1/arGIP: incompatible → retirar iDPP-4');
  }

  // Síntomas cardinales + HbA1c >= 8.5% -> insulina
  if (state.sintomatico && state.hba1c >= 8.5) {
    recs.push({
      type: 'warn', tag: 'Clínica cardinal', title: 'Insulina + Metformina',
      body: `Clínica grave (poliuria, polidipsia, pérdida de peso no explicable) y HbA1c ≥ 8,5 %: Iniciar insulina + metformina. La insulinización puede ser transitoria.`
    });
    trace.push('Síntomas cardinales graves con HbA1c >=8.5 → insulinización transitoria + Met');
  } else if (state.sintomatico) {
    recs.push({
      type: 'warn', tag: 'Clínica', title: 'Investigar desencadenante / Insulinizar',
      body: `Síntomas presentes: Investigar desencadenantes, medir cetonuria. Considerar insulinización temporal si procede.`
    });
  }

  /* ===== Lógica por condicionante (prevalece sobre HbA1c) ===== */
  if (cond.id === 'ic') { handleIC(recs, trace); }
  else if (cond.id === 'ecv') { handleECV(recs, trace); }
  else if (cond.id === 'erc') { handleERC(recs, trace); }
  else if (cond.id === 'obesidad') { handleObesidad(recs, trace); }
  else if (cond.id === 'hepatica') { handleHepatica(recs, trace); }
  else if (cond.id === 'fragilidad') { handleFragilidad(recs, trace); }
  else { handleByHbA1c(recs, trace, target); }

  /* ===== Recomendaciones de seguimiento (Corregido) ===== */
  if (state.hba1c > target.upperBound && target.target !== null) {
    recs.push({
      type: 'warn',
      tag: 'Seguimiento',
      title: 'Control a los 3 meses',
      body: `No se ha alcanzado el objetivo glucémico. Reevaluar HbA1c a los 3 meses tras el inicio o después de este cambio terapéutico para evitar la inercia clínica.`
    });
  } else if (target.target !== null) {
    recs.push({
      type: 'info',
      tag: 'En objetivo',
      title: 'Control semestral',
      body: `Objetivo alcanzado. Se recomienda control de HbA1c cada 6 meses.`
    });
  }

  return { recs, trace };
}

/* ---------- Handlers específicos por condicionante ---------- */
function handleIC(recs, trace) {
  if (!hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'iSGLT-2 (beneficio en IC)',
      body: 'De elección <strong>empagliflozina, dapagliflozina o canagliflozina</strong> independientemente de la FE y HbA1c.'
    });
    trace.push('IC: Añadir iSGLT-2 como 1ª línea');
  }

  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({
      type: 'add', tag: 'Combinar', title: 'Asociar metformina',
      body: 'Añadir metformina para optimizar el control glucémico.'
    });
  }

  if (state.hba1c > target.upperBound && hasClass('isglt2') && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: 'Si insuficiente', title: 'Añadir arGLP-1 o arGIP/GLP-1',
      body: 'Si con iSGLT-2 no es suficiente, prescribir arGLP-1 (ej. semaglutida - STEP-HFpEF) o arGIP/GLP-1 (tirzepatida - SUMMIT).'
    });
    trace.push('IC: + arGLP-1 / arGIP-GLP-1 como 2ª línea');
  }
}

function handleECV(recs, trace) {
  if (!state.drugs.metformina && state.fge >= 30) {
    recs.push({
      type: 'add', tag: 'Añadir base', title: 'Iniciar metformina',
      body: 'Base junto al cardioprotector si no hay contraindicación.'
    });
  }

  const tieneCardio = hasClass('isglt2') || hasClass('arglp') || hasClass('argip');
  if (!tieneCardio) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'iSGLT-2 o arGLP-1/arGIP-GLP-1',
      body: 'En ECV o RCV alto, terapia combinada temprana: <strong>iSGLT-2 o arGLP-1 o arGIP-GLP-1</strong> con evidencias en reducción de eventos + Metformina.'
    });
    trace.push('ECV/RCV: Añadir SGLT2 o arGLP1 o arGIP/GLP1');
  } else if (state.hba1c > target.upperBound && !(hasClass('isglt2') && (hasClass('arglp') || hasClass('argip')))) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Combinar familias cardioprotectoras',
      body: 'Considerar combinar el arGLP-1/arGIP-GLP-1 con un iSGLT-2 para maximizar beneficio y alcanzar HbA1c.'
    });
    trace.push('ECV: Intensificar con segunda clase cardioprotectora');
  }
}

function handleERC(recs, trace) {
  if (state.fge >= 20 && !hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'iSGLT-2 (FGe ≥ 20)',
      body: 'Reducen progresión de ERC independientemente del uso de metformina y control glucémico.'
    });
    trace.push('ERC: Añadir iSGLT-2');
  }
  if (state.hba1c > target.upperBound && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: '2ª línea', title: 'Añadir arGLP-1',
      body: 'En caso de no alcanzar objetivo, añadir arGLP-1 (semaglutida destaca por estudio renal primario FLOW).'
    });
    trace.push('ERC: + arGLP-1 como 2ª línea');
  }
}

function handleObesidad(recs, trace) {
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  if (!tieneIncretina) {
    let financiacion = '';
    if (state.imc >= 30) {
      financiacion = ' <em>En España, los arGLP-1 están financiados en tratamiento combinado si el IMC es ≥ 30 kg/m².</em>';
    }
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'arGIP/GLP-1 o arGLP-1 + Metformina',
      body: 'Opciones prioritarias para lograr control glucémico y beneficio ponderal.' + financiacion
    });
    trace.push('Obesidad: arGIP-GLP-1 o arGLP-1 al mismo rango que Met');
  }
  
  if (state.hba1c > target.upperBound && tieneIncretina && !hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Añadir iSGLT-2',
      body: 'Si el paciente precisa mayor control glucémico, añadir iSGLT-2 como escalón de apoyo.'
    });
    trace.push('Obesidad: + iSGLT-2');
  }
  
  if (state.imc >= 35) {
    recs.push({
      type: 'info', tag: 'Considerar', title: 'Cirugía bariátrica',
      body: 'Si el IMC es ≥ 35 kg/m², se recomienda considerar cirugía bariátrica.'
    });
  }
}

function handleHepatica(recs, trace) {
  if (!hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'arGIP/GLP-1 o arGLP-1',
      body: 'Tirzepatida o semaglutida han evidenciado beneficios histológicos reduciendo la esteatohepatitis.'
    });
    trace.push('Hepática: añadir arGIP/GLP-1 o arGLP-1');
  }
  if (state.hba1c > target.upperBound && !hasClass('isglt2') && !state.drugs.pioglitazona) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Añadir PIO o iSGLT-2',
      body: 'Añadir pioglitazona (mejora histológica validada) o iSGLT-2 (mejoras enzimáticas/esteatosis) si no se alcanza el objetivo glucémico.'
    });
    trace.push('Hepática: + PIO o iSGLT-2');
  }
}

function handleFragilidad(recs, trace) {
  if (hasClass('su') && state.fragGrade !== 'leve') {
    recs.push({
      type: 'danger', tag: 'Desintensificar', title: 'Evitar Sulfonilureas',
      body: 'Alto riesgo de hipoglucemia y vulnerabilidad. Retirar progresivamente glimepirida/gliclazida/repaglinida.'
    });
    trace.push('Fragilidad: Retirar SU/glinidas');
  }

  if (!hasClass('idpp4') && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'iDPP-4',
      body: 'En fragilidad, los iDPP-4 son de primera elección por su excelente tolerabilidad y escaso riesgo de hipoglucemia.'
    });
    trace.push('Fragilidad: iDPP-4 como primera opción');
  }

  if (state.fragGrade === 'muyGrave') {
    recs.push({
      type: 'warn', tag: 'Final de vida', title: 'Desintensificación estructurada',
      body: 'Priorizar calidad de vida. Suspender tratamientos preventivos a largo plazo y mantener regímenes simples para evitar sintomatología diabética.'
    });
    trace.push('Fragilidad muy grave → desintensificación máxima');
  }
}

function handleByHbA1c(recs, trace, target) {
  if (!state.drugs.metformina && state.fge >= 30) {
    recs.push({
      type: 'add', tag: 'Añadir base', title: 'Iniciar Metformina',
      body: 'Esquema general: iniciar con metformina si no existen condicionantes predominantes ni contraindicación.'
    });
    trace.push('General: Iniciar Met');
  }

  if (state.hba1c >= 8.5 && !state.sintomatico) {
    trace.push('HbA1c ≥ 8.5% asintomático → doble terapia');
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
    
    if (clasesUsadas <= 1) {
      recs.push({
        type: 'add', tag: 'Intensificación inmediata', title: 'Doble terapia (Met + otro ADNI)',
        body: 'Asintomático con HbA1c ≥ 8,5 %: intensificación inmediata añadiendo a metformina un segundo fármaco (idealmente iSGLT-2, arGLP-1 o arGIP/GLP-1).'
      });
    } else {
      recs.push({
        type: 'add', tag: 'Triple terapia', title: 'Añadir tercer o cuarto ADNI',
        body: 'Mantener HbA1c < 8.5% exige agregar un iSGLT-2, iDPP-4, arGLP-1, arGIP-GLP-1, Pio o SU según perfil si combinaciones previas fallan.'
      });
    }
  } else if (state.hba1c < 8.5 && state.hba1c > target.upperBound) {
    trace.push('HbA1c < 8.5% fuera de objetivo → intensificación precoz');
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
    
    if (clasesUsadas <= 1) {
      recs.push({
        type: 'add', tag: 'Doble terapia', title: 'Añadir iSGLT-2, arGLP-1 o arGIP/GLP-1',
        body: 'Se recomienda intensificación precoz combinando Metformina con fármacos que otorguen protección vascular añadida.'
      });
    } else {
      recs.push({
        type: 'add', tag: 'Intensificar', title: 'Añadir ADNI o insulina basal',
        body: 'Alcanzar objetivo añadiendo tercer escalón (respetando incompatibilidades) o insulina basal.'
      });
    }
  }
}

/* =================================================================
   RENDER
   ================================================================= */

function renderCurrentDrugs() {
  const el = document.getElementById('currentDrugs');
  const active = Object.entries(state.drugs).filter(([k,v]) => v).map(([k]) => k);
  if (active.length === 0) {
    el.innerHTML = '<span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado</span>';
    return;
  }
  el.innerHTML = active.map(d => `<span class="drug-pill current">${DRUG_LABELS[d]}</span>`).join('');
}

function renderRecs(recs) {
  const el = document.getElementById('recommendations');
  if (recs.length === 0) {
    el.innerHTML = '<div class="rec-card info"><div class="rec-card-tag">SIN CAMBIOS</div><div class="rec-card-title">Tratamiento adecuado</div><div class="rec-card-body">No se sugiere modificación farmacológica.</div></div>';
    return;
  }
  el.innerHTML = recs.map(r => `
    <div class="rec-card ${r.type}">
      <div class="rec-card-tag">${r.tag}</div>
      <div class="rec-card-title">${r.title}</div>
      <div class="rec-card-body">${r.body}</div>
    </div>
  `).join('');
}

function renderTrace(trace) {
  document.getElementById('trace').innerHTML = trace.map(t => `<li>${t}</li>`).join('');
}

function update() {
  state.hba1c = parseFloat(document.getElementById('hba1c').value);
  state.edad = parseInt(document.getElementById('edad').value) || 0;
  state.tiempoDx = parseFloat(document.getElementById('tiempoDx').value) || 0;
  state.imc = parseFloat(document.getElementById('imc').value) || 0;
  state.fge = parseFloat(document.getElementById('fge').value) || 0;
  state.sintomatico = document.getElementById('sintomatico').checked;
  state.dxReciente = document.getElementById('dxReciente').checked;
  state.ic = document.getElementById('ic').checked;
  state.ecv = document.getElementById('ecv').checked;
  state.rcvAlto = document.getElementById('rcvAlto').checked;
  state.erc = document.getElementById('erc').checked;
  state.obesidad = document.getElementById('obesidad').checked;
  state.hepatica = document.getElementById('hepatica').checked;
  state.fragilidad = document.getElementById('fragilidad').checked;
  state.deterioro = document.getElementById('deterioro').checked;

  const fragRadio = document.querySelector('input[name="fragGrade"]:checked');
  state.fragGrade = fragRadio ? fragRadio.value : 'leve';

  state.drugs = {};
  document.querySelectorAll('[data-drug]').forEach(cb => {
    state.drugs[cb.dataset.drug] = cb.checked;
  });

  if (state.deterioro) {
      state.fragilidad = true;
      document.getElementById('fragilidad').checked = true;
      if (state.fragGrade === 'leve') {
          state.fragGrade = 'moderada';
          document.querySelector('input[name="fragGrade"][value="moderada"]').checked = true;
      }
  }

  document.getElementById('hbValue').textContent = state.hba1c.toFixed(1);
  const gme = Math.round(28.7 * state.hba1c - 46.7);
  document.getElementById('gme').textContent = gme;

  document.getElementById('fragilidadGrade').classList.toggle('active', state.fragilidad);

  document.querySelectorAll('.check').forEach(c => {
    const id = c.dataset.check;
    if (id) c.classList.toggle('checked', state[id] === true);
  });

  document.querySelectorAll('.radio-pill').forEach(p => {
    const input = p.querySelector('input');
    p.classList.toggle('selected', input.checked);
  });

  document.querySelectorAll('.drug-class').forEach(dc => {
    const cls = dc.dataset.drugclass;
    dc.classList.toggle('has-active', hasClass(cls));
  });

  const cond = getConditioner();
  const target = getTarget();
  const { recs, trace } = generateRecs(cond, target);

  const tv = document.getElementById('targetValue');
  if (target.target === null) {
    tv.textContent = 'Sin objetivo';
    tv.classList.add('muted');
  } else {
    tv.textContent = target.label;
    tv.classList.remove('muted');
  }

  document.getElementById('targetRationale').textContent = target.rationale;

  const status = document.getElementById('targetStatus');
  if (target.target === null) {
    status.className = 'target-status warn';
    status.textContent = 'Sin objetivo numérico';
  } else if (state.hba1c <= target.upperBound) {
    status.className = 'target-status ok';
    status.textContent = 'En objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  } else if (state.hba1c <= target.upperBound + 1) {
    status.className = 'target-status warn';
    status.textContent = 'Sobre objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  } else {
    status.className = 'target-status no';
    status.textContent = 'Lejos del objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  }

  document.getElementById('conditionerName').textContent = cond.name;
  document.getElementById('conditionerMeta').textContent = cond.meta;

  renderCurrentDrugs();
  renderRecs(recs);
  renderTrace(trace);
}

function resetAll() {
  document.getElementById('hba1c').value = 7.5;
  document.getElementById('edad').value = 65;
  document.getElementById('tiempoDx').value = 5;
  document.getElementById('imc').value = 29;
  document.getElementById('fge').value = 80;
  document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
  const fragLeve = document.querySelector('input[name="fragGrade"][value="leve"]');
  if (fragLeve) fragLeve.checked = true;
  update();
}

document.querySelectorAll('input, select').forEach(el => {
  el.addEventListener('input', update);
  el.addEventListener('change', update);
});

update();
</script>

