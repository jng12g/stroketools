<script>
/* =================================================================
   Algoritmo redGDPS 2026 - Lógica clínica estructurada y razonada
   ================================================================= */

const state = {
  hba1c: 7.5,
  edad: 65,
  tiempoDx: 5,
  fge: 80,
  sintomatico: false,
  dxReciente: false,
  ic: false,
  ecv: false,
  rcvAlto: false,
  erc: false,
  obesidad: false,
  hepatica: false,
  fragilidad: false,
  fragGrade: 'leve',
  deterioro: false,
  drugs: {}
};

const DRUG_LABELS = {
  metformina: 'Metformina',
  empagliflozina: 'Empagliflozina',
  dapagliflozina: 'Dapagliflozina',
  canagliflozina: 'Canagliflozina',
  ertugliflozina: 'Ertugliflozina',
  semaglutida: 'Semaglutida',
  dulaglutida: 'Dulaglutida',
  liraglutida: 'Liraglutida',
  exenatida: 'Exenatida',
  tirzepatida: 'Tirzepatida',
  sitagliptina: 'Sitagliptina',
  linagliptina: 'Linagliptina',
  vildagliptina: 'Vildagliptina',
  saxagliptina: 'Saxagliptina',
  glimepirida: 'Glimepirida',
  gliclazida: 'Gliclazida',
  repaglinida: 'Repaglinida',
  pioglitazona: 'Pioglitazona',
  insulinaBasal: 'Insulina basal',
  insulinaPrandial: 'Insulina prandial'
};

const DRUG_CLASS = {
  metformina: 'met',
  empagliflozina: 'isglt2', dapagliflozina: 'isglt2', canagliflozina: 'isglt2', ertugliflozina: 'isglt2',
  semaglutida: 'arglp', dulaglutida: 'arglp', liraglutida: 'arglp', exenatida: 'arglp',
  tirzepatida: 'argip',
  sitagliptina: 'idpp4', linagliptina: 'idpp4', vildagliptina: 'idpp4', saxagliptina: 'idpp4',
  glimepirida: 'su', gliclazida: 'su', repaglinida: 'su',
  pioglitazona: 'pio',
  insulinaBasal: 'ins', insulinaPrandial: 'ins'
};

function hasClass(cls) {
  return Object.entries(state.drugs).some(([k,v]) => v && DRUG_CLASS[k] === cls);
}

function getConditioner() {
  if (state.ic) return { id: 'ic', name: 'Insuficiencia cardíaca', meta: 'iSGLT-2 (con o sin Met) → arGLP-1 o arGIP-GLP-1' };
  if (state.ecv || state.rcvAlto) {
    const label = state.ecv ? 'ECV establecida' : 'RCV elevado';
    return { id: 'ecv', name: label, meta: 'Metformina + (iSGLT-2 o arGLP-1 o arGIP-GLP-1)' };
  }
  if (state.erc) return { id: 'erc', name: 'Enfermedad renal crónica', meta: 'iSGLT-2 (si FGe ≥20) → arGLP-1 (preferible semaglutida)' };
  if (state.obesidad) return { id: 'obesidad', name: 'Obesidad', meta: 'arGIP-GLP-1 o arGLP-1 + Met → iSGLT-2' };
  if (state.hepatica) return { id: 'hepatica', name: 'Enfermedad hepática metabólica', meta: 'arGIP-GLP-1 o arGLP-1 → iSGLT-2 o Pioglitazona' };
  if (state.fragilidad) {
    return { id: 'fragilidad', name: 'Fragilidad · ' + state.fragGrade, meta: 'iDPP-4 → +Met → insulina + Met (evitar Sulfonilureas)' };
  }
  return { id: null, name: 'Ninguno', meta: 'Algoritmo guiado por HbA1c y clínica cardinal' };
}

function getTarget() {
  const sinComplicaciones = !state.ic && !state.ecv && !state.erc && !state.hepatica && !state.rcvAlto;

  if (state.fragilidad && state.fragGrade === 'muyGrave') {
    return { 
      target: null, 
      label: 'Evitar síntomas', 
      rationale: 'Fragilidad muy grave o esperanza de vida limitada. No hay objetivo numérico; se prioriza la calidad de vida y se deben evitar síntomas hiper/hipoglucémicos.', 
      upperBound: 9.0
    };
  }
  
  if (state.deterioro || (state.fragilidad && (state.fragGrade === 'grave' || state.fragGrade === 'moderada'))) {
    return { 
      target: 8.5, 
      label: '7,5 - 8,5 %', 
      rationale: 'Fragilidad moderada-grave (deterioro cognitivo y/o limitación funcional). El objetivo se flexibiliza para extremar la precaución ante hipoglucemias.',
      upperBound: 8.5
    };
  }
  
  if (!state.fragilidad && sinComplicaciones && (state.dxReciente || (state.tiempoDx <= 10 && state.edad <= 75))) {
    return { 
      target: 6.5, 
      label: '< 6,5 %', 
      rationale: 'Paciente sin fragilidad ni complicaciones en sus primeros 10 años de diagnóstico: el objetivo estricto previene complicaciones a largo plazo (memoria metabólica).',
      upperBound: 6.5
    };
  }
  
  if (!state.fragilidad && sinComplicaciones && (state.tiempoDx > 10 || state.edad > 75)) {
    return { 
      target: 7.0, 
      label: '≤ 7,0 %', 
      rationale: 'Paciente de larga evolución (>10 años) o edad > 75 años, sin complicaciones macro/microvasculares instauradas.',
      upperBound: 7.0
    };
  }
  
  return { 
    target: 7.0, 
    label: '< 7,0 %', 
    rationale: 'Objetivo individualizado general por presencia de comorbilidad establecida sin criterios de fragilidad.',
    upperBound: 7.0
  };
}

function generateRecs(cond, target) {
  const recs = [];
  const trace = [];

  trace.push(`Evaluación: HbA1c actual de ${state.hba1c.toFixed(1)} % frente a objetivo de ${target.label}`);
  trace.push(`Condicionante rector: ${cond.name}`);

  // Alertas transversales
  if (state.drugs.metformina) {
    if (state.fge < 30) {
      recs.push({
        type: 'danger', tag: 'Contraindicación', title: 'Se recomienda suspender Metformina',
        body: `El paciente presenta un FGe de <strong>${state.fge} mL/min</strong>. La <strong>Metformina</strong> está formalmente contraindicada por debajo de 30 mL/min y debe ser suspendida inmediatamente.`
      });
      trace.push('FGe <30: Retirada de metformina obligatoria.');
    } else if (state.fge < 45) {
      recs.push({
        type: 'warn', tag: 'Ajuste de dosis', title: 'Se recomienda reducir dosis de Metformina',
        body: `Con un FGe entre 30 y 45 mL/min, se debe reducir la dosis de <strong>Metformina</strong> al 50% de la máxima tolerada y aumentar la monitorización de la función renal.`
      });
      trace.push('FGe 30-45: Ajuste de metformina al 50%.');
    }
  }

  if (hasClass('isglt2') && state.fge < 20) {
    recs.push({
      type: 'danger', tag: 'Reevaluar', title: 'Atención al uso de iSGLT-2 con FGe < 20',
      body: `Los <strong>iSGLT-2 (empagliflozina, dapagliflozina, canagliflozina)</strong> no se recomiendan iniciar con FGe < 20 mL/min/1,73 m². En pacientes que ya lo tomaban y su función renal decae, debe reevaluarse su continuidad según protocolo nefrológico.`
    });
    trace.push('FGe <20 en paciente con iSGLT-2: Reevaluación requerida.');
  }

  if (hasClass('idpp4') && (hasClass('arglp') || hasClass('argip'))) {
    recs.push({
      type: 'danger', tag: 'Asociación no sinérgica', title: 'Se recomienda retirar iDPP-4',
      body: `El uso concomitante de <strong>iDPP-4 (ej. sitagliptina, linagliptina)</strong> junto a análogos inyectables <strong>arGLP-1 o arGIP/GLP-1</strong> carece de sinergia terapéutica (mismo mecanismo incretínico). Se debe suspender el iDPP-4 y mantener el análogo.`
    });
    trace.push('Incompatibilidad detectada: iDPP-4 solapado con arGLP-1/arGIP.');
  }

  if (state.sintomatico && state.hba1c >= 8.5) {
    recs.push({
      type: 'warn', tag: 'Clínica cardinal', title: 'Se recomienda Insulina + Metformina',
      body: `Ante la presencia de clínica cardinal grave (poliuria, polidipsia, pérdida de peso) con HbA1c ≥ 8,5 %, las guías indican el inicio inmediato de <strong>insulina (basal o pauta completa) combinada con Metformina</strong>. Esta insulinización servirá para frenar la glucotoxicidad y puede ser de carácter transitorio.`
    });
    trace.push('Descompensación grave sintomática: Insulinización de rescate.');
  } else if (state.sintomatico) {
    recs.push({
      type: 'warn', tag: 'Clínica', title: 'Se recomienda investigar desencadenante',
      body: `Si el paciente presenta clínica cardinal, es imperativo investigar desencadenantes activos (corticoesteroides, infecciones, neoplasias), medir cetonuria y valorar el apoyo insulínico temporal.`
    });
  }

  // Lógica de condicionantes
  if (cond.id === 'ic') { handleIC(recs, trace, target); }
  else if (cond.id === 'ecv') { handleECV(recs, trace, target); }
  else if (cond.id === 'erc') { handleERC(recs, trace, target); }
  else if (cond.id === 'obesidad') { handleObesidad(recs, trace, target); }
  else if (cond.id === 'hepatica') { handleHepatica(recs, trace, target); }
  else if (cond.id === 'fragilidad') { handleFragilidad(recs, trace, target); }
  else { handleByHbA1c(recs, trace, target); }

  // Control de estado optimizado y seguimiento
  const inTarget = state.hba1c <= target.upperBound;
  const needsAction = recs.some(r => r.type === 'add' || r.type === 'warn' || r.type === 'danger');

  if (!needsAction && target.target !== null && inTarget) {
    recs.push({
      type: 'ok',
      tag: 'Paciente Optimizado',
      title: 'El tratamiento está optimizado',
      body: `El paciente ha alcanzado su objetivo glucémico individualizado (<strong>${state.hba1c.toFixed(1)}%</strong> para una meta de <strong>${target.label}</strong>) y, de acuerdo con su perfil clínico, cuenta con las familias farmacológicas recomendadas para la protección de su condicionante predominante (${cond.name}). Se recomienda mantener el esquema y realizar un control semestral de HbA1c, FGe, albuminuria y peso.`
    });
    trace.push('Evaluación final: Paciente en objetivo con cardioprotección cubierta. Optimizado.');
  } else if (state.hba1c > target.upperBound && target.target !== null) {
    recs.push({
      type: 'warn',
      tag: 'Seguimiento',
      title: 'Se recomienda reevaluar a los 3 meses',
      body: `Al no alcanzar el objetivo glucémico, es vital evitar la inercia clínica. Tras instaurar este cambio terapéutico, se recomienda realizar un nuevo control de HbA1c a los 3 meses.`
    });
  }

  return { recs, trace };
}

function handleIC(recs, trace, target) {
  if (!hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar un iSGLT-2',
      body: `Independientemente del valor de la HbA1c y de la fracción de eyección, en insuficiencia cardíaca el tratamiento farmacológico de elección son los <strong>iSGLT-2 (empagliflozina, dapagliflozina o canagliflozina)</strong> dado que reducen contundentemente las hospitalizaciones por IC y la mortalidad de causa cardiovascular.`
    });
    trace.push('Falta primera línea para IC: iSGLT-2 prescrito por evidencia pronóstica.');
  }

  if (!state.drugs.metformina && state.fge >= 30 && state.hba1c > target.upperBound) {
    recs.push({
      type: 'add', tag: 'Combinar', title: 'Se recomienda asociar Metformina',
      body: `Para optimizar el control de la glucemia por encima del objetivo, se recomienda combinar el iSGLT-2 con <strong>Metformina</strong>.`
    });
  }

  if (state.hba1c > target.upperBound && hasClass('isglt2') && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: 'Si insuficiente', title: 'Se recomienda añadir arGLP-1 o arGIP/GLP-1',
      body: `Si el paciente mantiene mal control glucémico o persisten los síntomas a pesar del iSGLT-2, se introduce como segundo escalón el uso de <strong>arGLP-1 (ej. semaglutida, ensayo STEP-HFpEF)</strong> o <strong>arGIP/GLP-1 (tirzepatida, ensayo SUMMIT)</strong>. Estos han demostrado grandes beneficios en el control de glucemia y reducción sintomática en IC (especialmente con FE preservada y obesidad).`
    });
    trace.push('Escalón secundario en IC: adición de arGLP-1 / arGIP-GLP-1 por estudios recientes.');
  }
}

function handleECV(recs, trace, target) {
  if (!state.drugs.metformina && state.fge >= 30) {
    recs.push({
      type: 'add', tag: 'Añadir base', title: 'Se recomienda prescribir Metformina',
      body: `La base del tratamiento combinado para estos pacientes debe incluir <strong>Metformina</strong> si la función renal lo permite.`
    });
  }

  const tieneCardio = hasClass('isglt2') || hasClass('arglp') || hasClass('argip');
  if (!tieneCardio) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda terapia combinada temprana',
      body: `En presencia de Enfermedad Cardiovascular (ECV) o Riesgo Cardiovascular Alto, el enfoque actual <strong>no depende del nivel de HbA1c</strong>, sino de la protección del daño en órgano diana. Se debe instaurar precozmente una combinación de Metformina junto con <strong>un iSGLT-2 (empagliflozina, dapagliflozina, canagliflozina)</strong>, o alternativamente un <strong>arGLP-1 (semaglutida, dulaglutida, liraglutida)</strong> o un <strong>arGIP/GLP-1 (tirzepatida)</strong>, ya que todos ellos han demostrado reducir drásticamente los eventos mayores (MACE).`
    });
    trace.push('Falta fármaco con beneficio cardiovascular demostrado (obligatorio independientemente de HbA1c).');
  } else if (state.hba1c > target.upperBound && !(hasClass('isglt2') && (hasClass('arglp') || hasClass('argip')))) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Se recomienda sumar una segunda familia cardioprotectora',
      body: `Dado que el paciente no alcanza la meta de HbA1c y ya cuenta con un fármaco pronóstico, se recomienda <strong>combinar simultáneamente un iSGLT-2 con un arGLP-1 o arGIP/GLP-1</strong>. Esta potente asociación maximiza el pronóstico cardiovascular y metabólico sin riesgo añadido de hipoglucemias.`
    });
    trace.push('HbA1c fuera de rango en paciente cardiovascular: Asociación de iSGLT-2 + arGLP-1/arGIP.');
  }
}

function handleERC(recs, trace, target) {
  if (state.fge >= 20 && !hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar iSGLT-2',
      body: `Atendiendo al algoritmo, en pacientes con DM2 y ERC se deben priorizar grupos que han demostrado beneficio pronóstico. Se recomienda iniciar un <strong>iSGLT-2 (empagliflozina, dapagliflozina, canagliflozina)</strong> ya que reducen la progresión de la enfermedad renal y los eventos CV si el FGe es ≥ 20 ml/min. Este beneficio ocurre independientemente del control glucémico y del uso paralelo de metformina (demostrado en DAPA-CKD).`
    });
    trace.push('Paciente renal (FGe>=20): iSGLT-2 es la primera opción prioritaria.');
  }
  
  if (state.hba1c > target.upperBound && !hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: '2ª línea', title: 'Se recomienda añadir arGLP-1',
      body: `Como segunda línea de tratamiento, se sugiere la asociación con un <strong>arGLP-1</strong> por su sólida evidencia reduciendo el riesgo cardiovascular y la progresión del daño renal. Destaca particularmente la <strong>semaglutida</strong>, al ser el único con un estudio de objetivo primario renal (estudio FLOW), donde demostró reducir significativamente el riesgo de empeoramiento renal, con o sin metformina.`
    });
    trace.push('Escalón secundario renal: arGLP-1 (prioridad semaglutida basada en FLOW).');
  }
}

function handleObesidad(recs, trace, target) {
  const tieneIncretina = hasClass('arglp') || hasClass('argip');
  if (!tieneIncretina) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda iniciar arGLP-1 o arGIP/GLP-1',
      body: `Al ser la obesidad el condicionante predominante, la pérdida de peso es un objetivo central a la par del glucémico. Se recomienda iniciar tratamiento, al mismo nivel jerárquico que la metformina, con potentes agonistas inyectables: <strong>arGLP-1 (semaglutida, dulaglutida)</strong> o el dual <strong>arGIP/GLP-1 (tirzepatida)</strong>, ya que consiguen reducciones de peso de entre el 10% y el 20% (estudios STEP, SURMOUNT).<br><br><em>Nota de prescripción: En España, los arGLP-1 están financiados por el SNS en tratamiento combinado exclusivamente si el IMC es ≥ 30 kg/m².</em>`
    });
    trace.push('Obesidad clínica: Agonistas receptores GLP-1 / duales ascienden a primera línea.');
  }
  
  if (state.hba1c > target.upperBound && tieneIncretina && !hasClass('isglt2')) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Se recomienda asociar un iSGLT-2',
      body: `Si es preciso optimizar el control de la HbA1c, el siguiente paso debe ser añadir un <strong>iSGLT-2 (empagliflozina, dapagliflozina, canagliflozina)</strong> al esquema. Aunque su pérdida de peso es más modesta, su inclusión en el combo maximiza el beneficio metabólico general.`
    });
    trace.push('Obesidad: Intensificación mediante SGLT-2 añadida a incretina.');
  }
  
  if (state.obesidad) {
    recs.push({
      type: 'info', tag: 'Estilo de vida y cirugía', title: 'Abordaje integral de la obesidad',
      body: `El tratamiento farmacológico debe complementarse siempre con una intervención estructurada sobre el estilo de vida y apoyo psicosocial. Además, si el paciente presenta un IMC ≥ 35 kg/m², las guías sugieren derivar y evaluar la posibilidad de <strong>cirugía bariátrica</strong>.`
    });
  }
}

function handleHepatica(recs, trace, target) {
  if (!hasClass('arglp') && !hasClass('argip')) {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda arGLP-1 o arGIP/GLP-1',
      body: `El tratamiento farmacológico para la esteatohepatitis metabólica (MASLD/MASH) progresiva en contexto de DM2 indica el inicio de <strong>arGLP-1 (semaglutida)</strong> o <strong>arGIP/GLP-1 (tirzepatida)</strong>. Estos fármacos han demostrado reducciones muy significativas del contenido de grasa, de las enzimas hepáticas y mejoras en la fibrosis (ensayos ESSENCE y SYNERGY-NASH).`
    });
    trace.push('Enfermedad Hepática Metabólica: Beneficio primario por semaglutida / tirzepatida.');
  }
  
  if (state.hba1c > target.upperBound && !hasClass('isglt2') && !state.drugs.pioglitazona) {
    recs.push({
      type: 'add', tag: 'Intensificar', title: 'Se recomienda añadir iSGLT-2 o Pioglitazona',
      body: `Para la intensificación glucémica, las familias con mayor evidencia a nivel hepático son los <strong>iSGLT-2 (ej. empagliflozina, dapagliflozina)</strong> que reducen la esteatosis, o la <strong>Pioglitazona</strong>, que mejora fuertemente la sensibilidad a la insulina y la inflamación (aunque en este último hay que vigilar el aumento de peso y el riesgo de IC).`
    });
    trace.push('Intensificación hepática: iSGLT-2 o Pioglitazona como segunda opción.');
  }
}

function handleFragilidad(recs, trace, target) {
  if (hasClass('su') && state.fragGrade !== 'leve') {
    recs.push({
      type: 'danger', tag: 'Desintensificar', title: 'Se recomienda retirar activamente las Sulfonilureas',
      body: `El principal criterio en el anciano frágil es la seguridad. El uso de sulfonilureas (<strong>glimepirida, gliclazida, repaglinida</strong>) supone un riesgo inaceptable de hipoglucemias severas en estos pacientes, pudiendo desencadenar caídas y declive cognitivo. Deben retirarse de la pauta.`
    });
    trace.push('Riesgo por fragilidad: Retirada de Sulfonilureas/Glinidas inminente.');
  }

  if (!hasClass('idpp4') && !hasClass('arglp') && !hasClass('argip') && state.fragGrade !== 'muyGrave') {
    recs.push({
      type: 'add', tag: 'Añadir 1ª línea', title: 'Se recomienda el uso de iDPP-4',
      body: `En el contexto de fragilidad, los <strong>inhibidores de la DPP-4 (linagliptina, sitagliptina, vildagliptina, saxagliptina)</strong> destacan como la primera línea de tratamiento. Aportan excelente tolerabilidad, facilidad de toma y prácticamente nulo riesgo de hipoglucemia. (Recordar que linagliptina no requiere ajuste por filtrado glomerular).`
    });
    trace.push('Tratamiento conservador en fragilidad: iDPP-4 preferido por seguridad.');
  }

  if (state.fragGrade === 'muyGrave') {
    recs.push({
      type: 'warn', tag: 'Final de vida', title: 'Se recomienda desintensificación estructurada',
      body: `Al tratarse de un paciente con fragilidad muy grave o esperanza de vida limitada, se deben suspender todos los tratamientos orientados a prevenir complicaciones a largo plazo. Mantener solo regímenes farmacológicos simples orientados a que el paciente no orine en exceso, no pierda peso y no sufra hipoglucemias.`
    });
    trace.push('Cuidados paliativos metabólicos aplicados. Desintensificación amplia.');
  }
}

function handleByHbA1c(recs, trace, target) {
  if (!state.drugs.metformina && state.fge >= 30) {
    recs.push({
      type: 'add', tag: 'Añadir base', title: 'Se recomienda iniciar tratamiento con Metformina',
      body: `Al no presentar otros condicionantes clínicos específicos (ausencia de IC, ECV, ERC, obesidad, etc.), la estrategia estándar inicia indicando la prescripción de <strong>Metformina</strong> como base universal, titulada progresivamente para tolerabilidad gástrica.`
    });
    trace.push('Escenario libre de complicaciones mayores: Metformina es la base universal.');
  }

  if (state.hba1c >= 8.5 && !state.sintomatico) {
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
    
    if (clasesUsadas <= 1) {
      recs.push({
        type: 'add', tag: 'Intensificación inmediata', title: 'Se recomienda doble terapia inicial (Metformina + segundo ADNI)',
        body: `Ante una HbA1c ≥ 8,5 % en un paciente asintomático, la guía insta a romper la inercia clínica evitando la terapia escalonada convencional. Se recomienda arrancar directamente combinando la Metformina con un segundo fármaco potente, preferiblemente <strong>un iSGLT-2, un arGLP-1 o un arGIP/GLP-1</strong>. La insulina queda reservada solo si hubiera clínica cardinal.`
      });
      trace.push('HbA1c >= 8.5%: Estrategia agresiva (doble terapia) para evitar inercia.');
    } else {
      recs.push({
        type: 'add', tag: 'Triple terapia', title: 'Se recomienda añadir un tercer fármaco o insulina',
        body: `Como el paciente se encuentra muy fuera de objetivo (≥ 8.5%) y ya toma una combinación de fármacos orales, se debe intensificar de manera contundente añadiendo <strong>un tercer ADNI (iSGLT-2, arGLP-1, Pioglitazona, etc.)</strong> que aporte un mecanismo complementario, o bien valorar el paso a <strong>insulina basal</strong>.`
      });
      trace.push('Triple terapia sugerida por descompensación refractaria.');
    }
  } else if (state.hba1c < 8.5 && state.hba1c > target.upperBound) {
    const clasesUsadas = ['met', 'isglt2', 'arglp', 'argip', 'idpp4', 'su', 'pio'].filter(c => hasClass(c)).length;
    
    if (clasesUsadas <= 1) {
      recs.push({
        type: 'add', tag: 'Doble terapia', title: 'Se recomienda asociar iSGLT-2, arGLP-1 o arGIP/GLP-1',
        body: `Para alcanzar el objetivo glucémico, el algoritmo promueve una intensificación temprana. Se recomienda añadir a la Metformina una molécula que aporte beneficios extra (pérdida de peso, sin hipoglucemia, protección cardiovascular incipiente), optando por <strong>iSGLT-2 (empagliflozina, dapagliflozina)</strong> o <strong>análogos inyectables (semaglutida, tirzepatida)</strong> antes de recurrir a alternativas más clásicas.`
      });
      trace.push('HbA1c < 8.5% pero fuera de objetivo: Intensificación temprana priorizando familias protectoras.');
    } else {
      recs.push({
        type: 'add', tag: 'Intensificar', title: 'Se recomienda progresar a triple terapia o Insulina',
        body: `Si el objetivo de HbA1c sigue escapándose a pesar de la doble terapia, se recomienda sumar una nueva familia terapéutica oral (respetando la incompatibilidad entre iDPP-4 y arGLP-1) o dar el salto hacia una pauta de <strong>Insulina Basal (glargina, degludec, detemir)</strong>.`
      });
    }
  }
}

/* =================================================================
   RENDER Y CONTROL DE INTERFAZ
   ================================================================= */

function renderCurrentDrugs() {
  const el = document.getElementById('currentDrugs');
  const active = Object.entries(state.drugs).filter(([k,v]) => v).map(([k]) => k);
  if (active.length === 0) {
    el.innerHTML = '<span style="color:var(--ink-mute); font-style:italic; font-size:13px;">Ninguno seleccionado</span>';
    return;
  }
  el.innerHTML = active.map(d => `<span class="drug-pill current">${DRUG_LABELS[d]}</span>`).join('');
}

function renderRecs(recs) {
  const el = document.getElementById('recommendations');
  if (recs.length === 0) {
    el.innerHTML = '<div class="empty-state">No se pudieron generar recomendaciones. Compruebe los datos introducidos.</div>';
    return;
  }
  el.innerHTML = recs.map(r => `
    <div class="rec-card ${r.type}">
      <div class="rec-card-tag">${r.tag}</div>
      <div class="rec-card-title">${r.title}</div>
      <div class="rec-card-body">${r.body}</div>
    </div>
  `).join('');
}

function renderTrace(trace) {
  document.getElementById('trace').innerHTML = trace.map(t => `<li>${t}</li>`).join('');
}

function update() {
  state.hba1c = parseFloat(document.getElementById('hba1c').value);
  state.edad = parseInt(document.getElementById('edad').value) || 0;
  state.tiempoDx = parseFloat(document.getElementById('tiempoDx').value) || 0;
  state.fge = parseFloat(document.getElementById('fge').value) || 0;
  state.sintomatico = document.getElementById('sintomatico').checked;
  state.dxReciente = document.getElementById('dxReciente').checked;
  state.ic = document.getElementById('ic').checked;
  state.ecv = document.getElementById('ecv').checked;
  state.rcvAlto = document.getElementById('rcvAlto').checked;
  state.erc = document.getElementById('erc').checked;
  state.obesidad = document.getElementById('obesidad').checked;
  state.hepatica = document.getElementById('hepatica').checked;
  state.fragilidad = document.getElementById('fragilidad').checked;
  state.deterioro = document.getElementById('deterioro').checked;

  const fragRadio = document.querySelector('input[name="fragGrade"]:checked');
  state.fragGrade = fragRadio ? fragRadio.value : 'leve';

  state.drugs = {};
  document.querySelectorAll('[data-drug]').forEach(cb => {
    state.drugs[cb.dataset.drug] = cb.checked;
  });

  if (state.deterioro) {
      state.fragilidad = true;
      document.getElementById('fragilidad').checked = true;
      if (state.fragGrade === 'leve') {
          state.fragGrade = 'moderada';
          document.querySelector('input[name="fragGrade"][value="moderada"]').checked = true;
      }
  }

  document.getElementById('hbValue').textContent = state.hba1c.toFixed(1);
  const gme = Math.round(28.7 * state.hba1c - 46.7);
  document.getElementById('gme').textContent = gme;

  document.getElementById('fragilidadGrade').classList.toggle('active', state.fragilidad);

  document.querySelectorAll('.check').forEach(c => {
    const id = c.dataset.check;
    if (id) c.classList.toggle('checked', state[id] === true);
  });

  document.querySelectorAll('.radio-pill').forEach(p => {
    const input = p.querySelector('input');
    p.classList.toggle('selected', input.checked);
  });

  document.querySelectorAll('.drug-class').forEach(dc => {
    const cls = dc.dataset.drugclass;
    dc.classList.toggle('has-active', hasClass(cls));
  });

  const cond = getConditioner();
  const target = getTarget();
  const { recs, trace } = generateRecs(cond, target);

  const tv = document.getElementById('targetValue');
  if (target.target === null) {
    tv.textContent = 'Sin objetivo';
    tv.classList.add('muted');
  } else {
    tv.textContent = target.label;
    tv.classList.remove('muted');
  }

  document.getElementById('targetRationale').textContent = target.rationale;

  const status = document.getElementById('targetStatus');
  if (target.target === null) {
    status.className = 'target-status warn';
    status.textContent = 'Sin objetivo numérico';
  } else if (state.hba1c <= target.upperBound) {
    status.className = 'target-status ok';
    status.textContent = 'En objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  } else if (state.hba1c <= target.upperBound + 0.2) {
    status.className = 'target-status warn';
    status.textContent = 'Al límite o levemente sobre el objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  } else {
    status.className = 'target-status no';
    status.textContent = 'Lejos del objetivo · HbA1c ' + state.hba1c.toFixed(1) + ' %';
  }

  document.getElementById('conditionerName').textContent = cond.name;
  document.getElementById('conditionerMeta').textContent = cond.meta;

  renderCurrentDrugs();
  renderRecs(recs);
  renderTrace(trace);
}

function resetAll() {
  document.getElementById('hba1c').value = 7.5;
  document.getElementById('edad').value = 65;
  document.getElementById('tiempoDx').value = 5;
  document.getElementById('fge').value = 80;
  document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
  const fragLeve = document.querySelector('input[name="fragGrade"][value="leve"]');
  if (fragLeve) fragLeve.checked = true;
  update();
}

document.querySelectorAll('input, select').forEach(el => {
  el.addEventListener('input', update);
  el.addEventListener('change', update);
});

update();
</script>

